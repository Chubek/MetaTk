{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MetaBFD.schema.json",
  "title": "MetaBFD object-format description (.bfd.yaml)",
  "description": "One BFD object-format backend per file. The container layouts, the numeric constants and the relocation (howto) tables of the formats that binutils/bfd implements. Records reference each other by name; a document may inherit the container of another one with `container`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name"
  ],
  "properties": {
    "schema": {
      "const": 1,
      "description": "Document schema version. Must be 1."
    },
    "name": {
      "type": "string",
      "pattern": "^[!-~]+$",
      "maxLength": 128,
      "description": "Catalogue key, e.g. ELF64. Printable ASCII without spaces."
    },
    "format": {
      "enum": [
        "elf",
        "coff",
        "pe",
        "macho",
        "ecoff",
        "wasm",
        "other"
      ],
      "description": "The object format family."
    },
    "description": {
      "type": "string",
      "description": "Free text describing the backend."
    },
    "byte_order": {
      "enum": [
        "little",
        "big"
      ],
      "description": "Byte order of the container."
    },
    "target_vector": {
      "type": "string",
      "maxLength": 128,
      "description": "Name of the BFD target vector, e.g. elf64-x86-64."
    },
    "arch": {
      "type": "string",
      "maxLength": 128,
      "description": "Architecture the backend emulates."
    },
    "container": {
      "type": "string",
      "pattern": "^[!-~]+$",
      "maxLength": 128,
      "description": "Name of the document holding the container layout. The records and constants of that document are inherited; the relocations stay local."
    },
    "magic": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]+$",
      "maxLength": 64,
      "description": "Magic bytes as hexadecimal digits."
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Target vector flags, e.g. host."
    },
    "source": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "File inside the binutils tree the data was taken from."
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Provenance of the description."
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128
          },
          "desc": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "description": "Size of the record in bytes. Defaults to the end of the last field."
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "offset",
                "size"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[!-~]+$",
                  "maxLength": 128
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "desc": {
                  "type": "string"
                }
              }
            }
          },
          "encodings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "target",
                "mask"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^[!-~]+$",
                  "maxLength": 128,
                  "description": "Field the bits live in."
                },
                "target": {
                  "type": "string",
                  "pattern": "^[!-~]+$",
                  "maxLength": 128,
                  "description": "What the bits mean, e.g. type, symbol, bind."
                },
                "mask": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Mask of the extracted part, applied after the shift."
                },
                "shift": {
                  "type": "integer",
                  "description": "Right shift applied before the mask."
                }
              }
            },
            "description": "How packed fields are split into their parts."
          }
        }
      },
      "description": "Fixed-layout structures of the container."
    },
    "constants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Group name, e.g. section_types."
          },
          "desc": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[!-~]+$",
                  "maxLength": 128
                },
                "value": {
                  "type": "integer"
                },
                "desc": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "description": "Named numeric constants, grouped by topic."
    },
    "relocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "number"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128
          },
          "number": {
            "type": "integer",
            "description": "The relocation number of the format."
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "description": "Bytes the relocation operates on."
          },
          "bitsize": {
            "type": "integer",
            "minimum": 0,
            "description": "Bits the relocation occupies in the instruction."
          },
          "pcrel": {
            "type": "boolean",
            "description": "The relocation is relative to the program counter."
          },
          "pcrel_offset": {
            "type": "boolean",
            "description": "The program counter is left in the offset slot."
          },
          "partial": {
            "type": "boolean",
            "description": "BFD partial_inplace: the addend lives in the section contents."
          },
          "overflow": {
            "enum": [
              "dont",
              "bitfield",
              "signed",
              "unsigned",
              "truncate",
              "error"
            ],
            "description": "BFD complain_overflow policy."
          },
          "rightshift": {
            "type": "integer"
          },
          "bitpos": {
            "type": "integer"
          },
          "src_mask": {
            "type": "integer",
            "minimum": 0
          },
          "dst_mask": {
            "type": "integer",
            "minimum": 0
          },
          "desc": {
            "type": "string"
          }
        }
      },
      "description": "Relocation (howto) entries of the backend."
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128
          },
          "desc": {
            "type": "string"
          }
        }
      },
      "description": "Well-known section names of the format."
    }
  }
}
