{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetaVM machine profile",
  "type": "object",
  "required": ["schema", "name", "symbol", "architecture", "description", "native_coverage", "native_format_loader", "portable_example", "vmweave", "vmspc", "vmdesc", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "metavm.machine/1"},
    "name": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "architecture": {"type": "string"},
    "description": {"type": "string", "minLength": 1},
    "native_coverage": {"enum": ["catalog-only", "classic-opcode-interpreter", "issa-subset", "graphics-subset", "integer-word-subset", "integer-method-subset", "secd-unary-subset", "krivine-whnf-subset"]},
    "native_format_loader": {"type": "boolean"},
    "portable_example": {"type": "string"},
    "vmweave": {"type": "string"},
    "vmspc": {"type": "string"},
    "vmdesc": {"type": "string"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
