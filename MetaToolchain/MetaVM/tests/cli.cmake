file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/sum.mi" "fn sum(n) { let x=0; loop: br n,body,end; body: let x=x+n; let n=n-1; goto loop; end: return x; }")
execute_process(COMMAND "${TOOL}" compile sum "${WORK}/sum.mi" "${WORK}/sum.mvm" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "bytecode compilation failed: ${rc}")
endif()
execute_process(COMMAND "${TOOL}" run "${WORK}/sum.mvm" 1000 10 RESULT_VARIABLE rc OUTPUT_VARIABLE output)
if(NOT rc EQUAL 0 OR NOT output MATCHES "result=55 steps=")
  message(FATAL_ERROR "unexpected VM result: ${rc} ${output}")
endif()
execute_process(COMMAND "${TOOL}" run "${WORK}/sum.mvm" 0 10 RESULT_VARIABLE rc)
if(NOT rc EQUAL 1)
  message(FATAL_ERROR "budget exhaustion did not fail")
endif()
execute_process(COMMAND "${TOOL}" compile sum "${WORK}/sum.mi" "${WORK}/sum.mi" RESULT_VARIABLE rc)
if(NOT rc EQUAL 1)
  message(FATAL_ERROR "input/output alias accepted")
endif()
execute_process(COMMAND "${TOOL}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 2)
  message(FATAL_ERROR "wrong usage exit status")
endif()
execute_process(COMMAND "${TOOL}" run "${WORK}/missing.mvm" 100 RESULT_VARIABLE rc)
if(NOT rc EQUAL 3)
  message(FATAL_ERROR "wrong I/O exit status")
endif()
