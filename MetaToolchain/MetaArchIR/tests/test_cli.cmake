file(MAKE_DIRECTORY "${WORK}")
function(run status)
  execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${rc}" STREQUAL "${status}")
    message(FATAL_ERROR "marchir ${ARGN}: expected ${status}, got ${rc}\n${out}\n${err}")
  endif()
  set(OUT "${out}" PARENT_SCOPE)
  set(ERR "${err}" PARENT_SCOPE)
endfunction()
set(db "${SOURCE}/MetaArchDB")
set(examples "${SOURCE}/MetaArchIR/examples/cli")
run(0 --help)
run(0 --version)
run(2)
run(2 --target)
run(2 --unknown)
run(2 -T amd64 --emit invalid -)
run(2 --list-targets --list-forms)
run(2 --list-targets unexpected.mair)
run(2 -T amd64 --target-index -1 -)
run(0 --db "${db}" --list-targets)
if(NOT OUT MATCHES "aarch64\namd64")
  message(FATAL_ERROR "unsorted or missing target listing")
endif()
run(0 -T riscv64 --db "${db}" --list-forms)
if(NOT OUT MATCHES "11\taddi\taddi\t3")
  message(FATAL_ERROR "form listing is incomplete")
endif()
run(0 -T riscv64 --db "${db}" --list-encoders)
if(NOT OUT MATCHES "addi ")
  message(FATAL_ERROR "encoder listing is incomplete")
endif()
run(0 -T riscv64 --db "${db}" --list-registers)
if(NOT OUT MATCHES "x10\t64\t10")
  message(FATAL_ERROR "register listing is incomplete")
endif()
run(1 -T does_not_exist --db "${db}" --list-forms)
run(3 -T amd64 --db "${db}" "${WORK}/missing.mair")
file(WRITE "${WORK}/bad.mair" "// comment\nencode missing\n")
file(WRITE "${WORK}/preserve.s" "preserve me")
run(1 -T amd64 --db "${db}" "${WORK}/bad.mair" -o "${WORK}/preserve.s")
if(NOT ERR MATCHES "bad.mair:2:1:")
  message(FATAL_ERROR "missing positioned diagnostic: ${ERR}")
endif()
file(READ "${WORK}/preserve.s" preserved)
if(NOT preserved STREQUAL "preserve me")
  message(FATAL_ERROR "invalid input clobbered output")
endif()
file(WRITE "${WORK}/ret.mair" "encode ret\n")
run(2 -T amd64 --db "${db}" "${WORK}/ret.mair" -o "${WORK}/ret.mair")
run(1 -T amd64 --db "${db}" --max-bytes 1 "${WORK}/ret.mair")
run(0 -T amd64 --db "${db}" --check "${WORK}/ret.mair")
if(EXISTS "${WORK}/ret.s")
  message(FATAL_ERROR "--check wrote an output file")
endif()
execute_process(COMMAND "${TOOL}" -T amd64 --db "${db}" --emit hex -
  INPUT_FILE "${WORK}/ret.mair" OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR NOT out STREQUAL "c3\n")
  message(FATAL_ERROR "stdin/stdout pipeline failed")
endif()
foreach(arch amd64 aarch64 riscv64)
  run(0 -T "${arch}" --db "${db}" --emit hex "${examples}/06_retarget.mair" -o -)
  if(arch STREQUAL "amd64")
    set(expected "c3\n")
  elseif(arch STREQUAL "aarch64")
    set(expected "c0035fd6\n")
  else()
    set(expected "67800000\n")
  endif()
  if(NOT OUT STREQUAL expected)
    message(FATAL_ERROR "wrong ${arch} ret: ${OUT}")
  endif()
endforeach()
file(GLOB native "${examples}/*.mair")
foreach(path IN LISTS native)
  run(0 -T amd64 --db "${db}" --check "${path}")
endforeach()
run(0 -T riscv64 --db "${db}" --emit hex "${examples}/riscv64/decrement.mair" -o -)
if(NOT OUT STREQUAL "1305f5ff67800000\n")
  message(FATAL_ERROR "wrong RISC-V decrement bytes")
endif()
run(0 -T amd64 --db "${db}" --emit json "${examples}/amd64/call.mair" -o -)
string(JSON symbol GET "${OUT}" relocations 0 symbol)
string(JSON offset GET "${OUT}" relocations 0 offset)
if(NOT symbol STREQUAL "external_function" OR NOT offset EQUAL 1)
  message(FATAL_ERROR "JSON relocation metadata missing")
endif()
run(1 -T amd64 --db "${db}" --emit bin "${examples}/amd64/call.mair" -o "${WORK}/unresolved.bin")

# Independent encoders, when LLVM tools are installed. No network needed.
find_program(LLVM_MC llvm-mc)
find_program(LLVM_OBJCOPY llvm-objcopy)
if(LLVM_MC AND LLVM_OBJCOPY)
  foreach(arch aarch64 riscv64)
    if(arch STREQUAL "aarch64")
      set(example aarch64/add.mair)
      set(assembly "add x0, x0, x1\nret\n")
    else()
      set(example riscv64/decrement.mair)
      set(assembly "addi a0, a0, -1\nret\n")
    endif()
    file(WRITE "${WORK}/${arch}.s" "${assembly}")
    execute_process(COMMAND "${LLVM_MC}" -triple=${arch} -filetype=obj "${WORK}/${arch}.s" -o "${WORK}/${arch}.o" RESULT_VARIABLE rc ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "llvm-mc: ${err}")
    endif()
    execute_process(COMMAND "${LLVM_OBJCOPY}" -O binary --only-section=.text "${WORK}/${arch}.o" "${WORK}/${arch}.expected" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "llvm-objcopy failed")
    endif()
    run(0 -T "${arch}" --db "${db}" --emit bin "${examples}/${example}" -o "${WORK}/${arch}.actual")
    file(READ "${WORK}/${arch}.expected" expected HEX)
    file(READ "${WORK}/${arch}.actual" actual HEX)
    if(NOT expected STREQUAL actual)
      message(FATAL_ERROR "${arch} differs from llvm-mc: ${actual} vs ${expected}")
    endif()
  endforeach()
else()
  message(STATUS "Independent encoding checks skipped: llvm-mc/llvm-objcopy unavailable")
endif()

if(HOST_AMD64)
  foreach(name GCD Compute)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "METAARCHDB=${db}" "${EXAMPLE_${name}}"
      OUTPUT_FILE "${WORK}/${name}.s" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "${name} API example failed")
    endif()
  endforeach()
  file(WRITE "${WORK}/driver.c" "extern unsigned gcd(unsigned,unsigned);\nextern unsigned compute(unsigned,unsigned);\nint main(void) { return gcd(48,18)!=6 || gcd(0,7)!=7 || gcd(7,0)!=7 || gcd(0,0)!=0 || compute(3,4)!=25; }\n")
  execute_process(COMMAND "${CC}" "${WORK}/driver.c" "${WORK}/GCD.s" "${WORK}/Compute.s" -o "${WORK}/native-test" RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "native example assembly failed: ${err}")
  endif()
  execute_process(COMMAND "${WORK}/native-test" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "native example execution failed: ${rc}")
  endif()
endif()
