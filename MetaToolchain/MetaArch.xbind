local xbind = require("lxbind")

-- MetaArch: the architecture catalogue (ArchDB/*.dsymspec.yaml) behind its
-- versioned C ABI.
--
-- Headers are relative to the MetaArch directory.  The bound surface is the
-- stable query and lifecycle part of MetaArchABI.h: the version, the
-- diagnostics handle, the spec handle and the counts and lookups that do
-- not need an out-parameter.  The view getters (metaarch_spec_target,
-- metaarch_spec_register, metaarch_spec_form, metaarch_diagnostics_get,
-- metaarch_result_relocation) and the result accessors are deliberately left
-- out: they fill a caller-owned structure, which XBind cannot marshal yet.
--
-- The result handle is bound as an opaque pointer so that the encode and
-- write entry points keep their ownership rules; reading the bytes of a
-- result is the job of a binding that knows the result layout.
return xbind.library {
  name = "metaarch",
  version = "1.0.0",
  features = { "c-signatures", "explicit-ownership" },
  headers = { "MetaArchABI.h" },
  stdlib = { "typedef", "sexp", "json" },
  targets = {
    xbind.target("D", { module = "metaarch" }),
    xbind.target("Go", { package = "metaarch" }),
    xbind.target("Java", { package = "stone.metaarch", class = "MetaArch" }),
    xbind.target("Lua", { module = "metaarch" }),
    xbind.target("NodeJS", { addon = "metaarch" }),
    xbind.target("OCaml", { library = "metaarch" }),
    xbind.target("Python", { module = "metaarch" }),
    xbind.target("Ruby", { extension = "metaarch" }),
    xbind.target("Rust", { crate = "metaarch_sys" }),
  },
  typedefs = {
    xbind.typedef("const char *", "string", { ownership = "borrowed" }),
    xbind.typedef("int32_t", "int", { range = "int32" }),
    xbind.typedef("int64_t", "int", { range = "int64" }),
    xbind.typedef("uint32_t", "int", { range = "uint32" }),
    xbind.typedef("uint64_t", "int", { range = "uint64" }),
    xbind.typedef("MaStatus", "int", { range = "status" }),
    xbind.typedef("MaFormat", "int", { range = "format" }),
    xbind.typedef("MaSpec *", "opaque", { ownership = "owned" }),
    xbind.typedef("const MaSpec *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("MaDiagnostics *", "opaque", { ownership = "owned" }),
    xbind.typedef("const MaDiagnostics *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("MaResult *", "opaque", { ownership = "owned" }),
    xbind.typedef("const MaResult *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("const void *", "opaque", { ownership = "borrowed" }),
  },
  functions = {
    -- version and diagnostics -----------------------------------------
    xbind.func("metaarch_abi_version", {
      returns = "uint32_t",
      params = {},
    }),
    xbind.func("metaarch_diagnostics_create", {
      returns = "MaDiagnostics *", ownership = "owned",
      params = {},
    }),
    xbind.func("metaarch_diagnostics_free", {
      returns = "void",
      params = { xbind.param("diagnostics", "MaDiagnostics *") },
    }),
    xbind.func("metaarch_diagnostics_clear", {
      returns = "void",
      params = { xbind.param("diagnostics", "MaDiagnostics *") },
    }),
    xbind.func("metaarch_diagnostics_count", {
      returns = "size_t",
      params = { xbind.param("diagnostics", "const MaDiagnostics *") },
    }),
    -- specs -----------------------------------------------------------
    xbind.func("metaarch_spec_load", {
      returns = "MaSpec *", ownership = "owned",
      params = {
        xbind.param("path", "const char *"),
        xbind.param("format", "MaFormat"),
        xbind.param("flags", "uint32_t"),
        xbind.param("diagnostics", "MaDiagnostics *", { nullable = true }),
      },
    }),
    xbind.func("metaarch_spec_parse", {
      returns = "MaSpec *", ownership = "owned",
      params = {
        xbind.param("data", "const void *"),
        xbind.param("length", "size_t"),
        xbind.param("format", "MaFormat"),
        xbind.param("virtual_path", "const char *"),
        xbind.param("flags", "uint32_t"),
        xbind.param("diagnostics", "MaDiagnostics *", { nullable = true }),
      },
    }),
    xbind.func("metaarch_spec_free", {
      returns = "void",
      params = { xbind.param("spec", "MaSpec *") },
    }),
    xbind.func("metaarch_spec_load_backend", {
      returns = "int32_t",
      params = {
        xbind.param("spec", "MaSpec *"),
        xbind.param("diagnostics", "MaDiagnostics *", { nullable = true }),
      },
    }),
    xbind.func("metaarch_spec_target_count", {
      returns = "size_t",
      params = { xbind.param("spec", "const MaSpec *") },
    }),
    xbind.func("metaarch_spec_register_count", {
      returns = "size_t",
      params = { xbind.param("spec", "const MaSpec *") },
    }),
    xbind.func("metaarch_spec_encoder_count", {
      returns = "size_t",
      params = { xbind.param("spec", "const MaSpec *") },
    }),
    xbind.func("metaarch_spec_form_count", {
      returns = "size_t",
      params = { xbind.param("spec", "const MaSpec *") },
    }),
    xbind.func("metaarch_spec_encoder_name", {
      returns = "const char *", ownership = "borrowed",
      params = {
        xbind.param("spec", "const MaSpec *"),
        xbind.param("index", "size_t"),
      },
    }),
    xbind.func("metaarch_spec_find_register", {
      returns = "int32_t",
      params = {
        xbind.param("spec", "const MaSpec *"),
        xbind.param("name", "const char *"),
      },
    }),
    xbind.func("metaarch_spec_find_encoder", {
      returns = "int32_t",
      params = {
        xbind.param("spec", "const MaSpec *"),
        xbind.param("name", "const char *"),
      },
    }),
    -- results ---------------------------------------------------------
    xbind.func("metaarch_result_free", {
      returns = "void",
      params = { xbind.param("result", "MaResult *") },
    }),
    xbind.func("metaarch_result_size", {
      returns = "size_t",
      params = { xbind.param("result", "const MaResult *") },
    }),
    xbind.func("metaarch_result_relocation_count", {
      returns = "size_t",
      params = { xbind.param("result", "const MaResult *") },
    }),
  },
}
