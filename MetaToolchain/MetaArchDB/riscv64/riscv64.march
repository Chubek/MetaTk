    syntax default { comment = "#"; separator = ", "; }
    syntax abi { comment = "#"; separator = ", "; tmpl = "{mnemonic} {ops}"; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 4; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 8;
            content = "data";
        },
        { name = ".tdata"; flags = ["write", "alloc", "tls", "data"]; align = 8; content = "data"; },
        {
            name = ".tbss";
            flags = ["write", "alloc", "zerofill", "tls", "data"];
            align = 8;
            content = "data";
        },
        { name = ".init"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".fini"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".plt"; flags = ["exec", "alloc", "code"]; align = 16; content = "code"; },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        { name = ".eh_frame"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; },
        { name = ".comment"; flags = ["readonly", "merge", "meta"]; align = 1; content = "meta"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "tls_var"; binding = "tls"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; },
        { name = "hidden_func"; binding = "global"; visibility = "hidden"; symtype = "func"; }
    ];
    reloc R_RISCV_NONE { width = 32; expr = "S + A"; }
    reloc R_RISCV_32 { width = 32; expr = "S + A"; }
    reloc R_RISCV_64 { width = 64; expr = "S + A"; }
    reloc R_RISCV_RELATIVE { width = 64; expr = "B + A"; }
    reloc R_RISCV_BRANCH { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_RISCV_JAL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_RISCV_CALL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_RISCV_CALL_PLT { width = 32; signed = true; pcrel = true; expr = "PLT(S) + A - P"; }
    reloc R_RISCV_PCREL_HI20 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_RISCV_PCREL_LO12_I { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_RISCV_PCREL_LO12_S { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_RISCV_HI20 { width = 32; expr = "S + A"; }
    reloc R_RISCV_LO12_I { width = 32; expr = "S + A"; }
    reloc R_RISCV_LO12_S { width = 32; expr = "S + A"; }
    reloc R_RISCV_GOT_HI20 { width = 32; expr = "GOT(S) + A"; }
    reloc R_RISCV_TLS_GD_HI20 { width = 32; expr = "TLS(S) + A"; }
    reloc R_RISCV_TLS_GOT_HI20 { width = 32; expr = "TLS(S) + A"; }
    reloc R_RISCV_TPREL_HI20 { width = 32; expr = "TLS(S) + A"; }
    reloc R_RISCV_TPREL_LO12_I { width = 32; expr = "TLS(S) + A"; }
    reloc R_RISCV_ALIGN { width = 32; expr = "S + A"; }
    reloc R_RISCV_RELAX { width = 32; expr = "S + A"; }
    reloc R_RISCV_SUB6 { width = 32; expr = "S + A"; }
    reloc R_RISCV_SUB8 { width = 32; expr = "S + A"; }
    reloc R_RISCV_SUB16 { width = 32; expr = "S + A"; }
    reloc R_RISCV_SUB32 { width = 32; expr = "S + A"; }
    reloc R_RISCV_GLOB_DAT { width = 64; expr = "S + A"; }
    reloc R_RISCV_JUMP_SLOT { width = 64; expr = "S + A"; }
    debug = [
        { kind = "target"; msg = "rv64gc base integer + atomics + fp + compressed"; ref = ""; },
        { kind = "form"; msg = "vector forms require v"; ref = "vadd.vv"; },
        { kind = "form"; msg = "privileged forms require priv"; ref = "mret"; }
    ];
    backend = { file = "backend/riscv64.json"; };
}
