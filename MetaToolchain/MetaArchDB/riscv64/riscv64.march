        body = "EMIT32LE 0x00001003 + rd*128 + rs1*32768 + ((imm + 4096) % 4096)*1048576\n";
    }
    encoder sw {
        max_bytes = 4;
        body = "EMIT32LE 0x00002023 + (imm % 32)*128 + rs1*32768 + rs2*1048576 + ((imm / 32) % 128)*33554432\n";
    }
    encoder sd {
        max_bytes = 4;
        body = "EMIT32LE 0x00003023 + (imm % 32)*128 + rs1*32768 + rs2*1048576 + ((imm / 32) % 128)*33554432\n";
    }
    encoder sb {
        max_bytes = 4;
        body = "EMIT32LE 0x00000023 + (imm % 32)*128 + rs1*32768 + rs2*1048576 + ((imm / 32) % 128)*33554432\n";
    }
    encoder sh {
        max_bytes = 4;
        body = "EMIT32LE 0x00001023 + (imm % 32)*128 + rs1*32768 + rs2*1048576 + ((imm / 32) % 128)*33554432\n";
    }
    encoder jalr {
        max_bytes = 4;
        body = "EMIT32LE 0x00000067 + rd*128 + rs1*32768 + ((imm + 4096) % 4096)*1048576\n";
    }
    encoder jal {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT32LE 0x0000006F + rd*128\nEMIT_RELOCATION sym, R_RISCV_CALL\n";
    }
    encoder beq {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT32LE 0x00000063 + rs1*32768 + rs2*1048576\nEMIT_RELOCATION sym, R_RISCV_BRANCH\n";
    }
    encoder bne {
        max_bytes = 4;
        max_relocs = 1;
