        obj_format = "ELF64";
        abi = "LP64D";
        calling_conv = "lp64d";
        features = ["i", "m", "a", "f", "d", "c", "zicsr", "zifencei"];
    }
    feature i { desc = "RV64I base integer"; }
    feature m { desc = "integer multiply/divide"; }
    feature a { desc = "atomic (lr/sc/amo)"; }
    feature f { desc = "single-precision floating point"; }
    feature d { desc = "double-precision floating point"; }
    feature c { desc = "compressed (16-bit) instructions"; }
    feature zicsr { desc = "control and status registers"; }
    feature zifencei { desc = "instruction-fetch fence"; }
    feature v { desc = "vector extension (RVV 1.0)"; }
    feature zba { desc = "address-generation (sh*add)"; }
    feature zbb { desc = "basic bit-manipulation"; }
    feature zbs { desc = "single-bit instructions"; }
    feature zbkb { desc = "bitmanip for cryptography"; }
    feature zknd { desc = "NIST AES decryption"; }
    feature zkne { desc = "NIST AES encryption"; }
    feature zknh { desc = "NIST hash (SHA2-256/512)"; }
    feature zfh { desc = "half-precision floating point"; }
    feature zfa { desc = "additional floating point (fli/min/max)"; }
    feature zicond { desc = "integer conditional ops (czero)"; }
    feature zihintpause { desc = "pause hint"; }
    feature priv { desc = "privileged (mret/sret/wfi/sfence)"; }
