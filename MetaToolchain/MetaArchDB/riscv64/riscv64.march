    encoder li { max_bytes = 4; body = "EMIT32LE 0x00000013 + rd*128 + ((imm + 4096) % 4096)*1048576\n"; }
    encoder lui { max_bytes = 4; body = "EMIT32LE 0x00000037 + rd*128 + ((imm + 524288) % 1048576)\n"; }
    encoder auipc { max_bytes = 4; body = "EMIT32LE 0x00000017 + rd*128 + ((imm + 524288) % 1048576)\n"; }
    encoder lw {
        max_bytes = 4;
        body = "EMIT32LE 0x00002003 + rd*128 + rs1*32768 + ((imm + 4096) % 4096)*1048576\n";
    }
    encoder ld {
