    feature base { desc = "eBPF base 64-bit ALU + jumps"; }
    feature alu32 { desc = "32-bit ALU sub-register ops"; }
    feature ldimm64 { desc = "16-byte load-immediate-64"; }
    feature byteswap { desc = "BE/LE 16/32/64 conversions"; }
    feature maps { desc = "BPF maps (fd/lookup/update)"; }
    feature helpers { desc = "helper calls (r1-r5 args, r0 ret)"; }
    feature tail-calls { desc = "tail calls"; }
    feature bpf-to-bpf { desc = "BPF-to-BPF calls"; }
    feature btf { desc = "BPF Type Format"; }
    feature atomics { desc = "atomic add/or/and/xor/fetch"; }
    feature bounded-loops { desc = "bounded loops (verifier v2)"; }
    feature priv { desc = "privileged (map update, kfuncs)"; }
