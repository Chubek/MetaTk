    encoder fmr { max_bytes = 4; body = "EMIT32LE 0xFC000090 + rd*2097152 + rb*2048\n"; }
    encoder vand { max_bytes = 4; body = "EMIT32LE 0x10000442 + rd*2097152 + ra*65536 + rb*2048\n"; }
    encoder vor { max_bytes = 4; body = "EMIT32LE 0x1000044A + rd*2097152 + ra*65536 + rb*2048\n"; }
    encoder vadd { max_bytes = 4; body = "EMIT32LE 0x10000080 + rd*2097152 + ra*65536 + rb*2048\n"; }
    encoder lxvd2x { max_bytes = 4; body = "EMIT32LE 0x7C000698 + rd*2097152 + ra*65536 + rb*2048\n"; }
    encoder stxvd2x { max_bytes = 4; body = "EMIT32LE 0x7C000798 + rs*2097152 + ra*65536 + rb*2048\n"; }
    encoder vcipher { max_bytes = 4; body = "EMIT32LE 0x10000548 + rd*2097152 + ra*65536 + rb*2048\n"; }
    encoder dadd { max_bytes = 4; body = "EMIT32LE 0xFC000004 + rd*2097152 + ra*65536 + rb*2048\n"; }
    encoder tbegin { max_bytes = 4; body = "EMIT32LE 0x7C0005AC\n"; }
    encoder tend { max_bytes = 4; body = "EMIT32LE 0x7C0005DC\n"; }
    form { mnemonic = "nop"; encoder = "nop"; }
    form {
        mnemonic = "add";
        encoder = "add";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "subf";
        encoder = "subf";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "and";
        encoder = "and";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "or";
        encoder = "or";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "xor";
        encoder = "xor";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "mulli";
        encoder = "mulli";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "imm"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; }
        ];
    }
    form {
        mnemonic = "mullw";
        encoder = "mullw";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "divw";
        encoder = "divw";
        flags = ["may_trap"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "cmpw";
        encoder = "cmpw";
        operands = [{ kind = "reg"; width = 64; class = "gpr"; }, { kind = "reg"; width = 64; class = "gpr"; }];
    }
    form {
        mnemonic = "li";
        encoder = "li";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "imm"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; }
        ];
    }
    form {
        mnemonic = "addi";
        encoder = "addi";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "imm"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; }
        ];
    }
    form {
        mnemonic = "addis";
        encoder = "addis";
        flags = ["reloc"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "sym"; width = 64; }
        ];
    }
    form {
        mnemonic = "lwz";
        encoder = "lwz";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "stw";
        encoder = "stw";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "lbz";
        encoder = "lbz";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "stb";
        encoder = "stb";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "ld";
        encoder = "ld";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "std";
        encoder = "std";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "lmw";
        encoder = "lmw";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "stmw";
        encoder = "stmw";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "lwarx";
        encoder = "lwarx";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "stwcx";
        encoder = "stwcx";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "bc";
        encoder = "bc";
        flags = ["cond_branch", "reloc"];
        operands = [{ kind = "cond"; width = 8; }, { kind = "sym"; width = 64; }];
    }
    form {
        mnemonic = "bl";
        encoder = "bl";
        flags = ["branch", "reloc"];
        operands = [{ kind = "sym"; width = 64; }];
    }
    form {
        mnemonic = "b";
        encoder = "b";
        flags = ["branch", "terminator", "reloc"];
        operands = [{ kind = "sym"; width = 64; }];
    }
    form {
        mnemonic = "bclr";
        encoder = "bclr";
        flags = ["branch", "cond_branch"];
        operands = [{ kind = "cond"; width = 8; }];
    }
    form {
        mnemonic = "bcctr";
        encoder = "bcctr";
        flags = ["branch"];
        operands = [{ kind = "cond"; width = 8; }];
    }
    form { mnemonic = "blr"; encoder = "blr"; flags = ["return", "terminator"]; }
    form {
        mnemonic = "tw";
        encoder = "tw";
        flags = ["may_trap"];
        operands = [{ kind = "reg"; width = 64; class = "gpr"; }, { kind = "reg"; width = 64; class = "gpr"; }];
    }
    form { mnemonic = "sc"; encoder = "sc"; flags = ["may_trap"]; }
    form { mnemonic = "sync"; encoder = "sync"; }
    form { mnemonic = "isync"; encoder = "isync"; }
    form { mnemonic = "rfid"; encoder = "rfid"; flags = ["privileged", "return"]; required = ["priv"]; }
    form {
        mnemonic = "mfspr";
        encoder = "mfspr";
        flags = ["privileged"];
        required = ["priv"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "imm"; width = 16; imm_min = 0; imm_max = 1023; signed = false; }
        ];
    }
    form {
        mnemonic = "mtspr";
        encoder = "mtspr";
        flags = ["privileged"];
        required = ["priv"];
        operands = [
            { kind = "imm"; width = 16; imm_min = 0; imm_max = 1023; signed = false; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "fadd";
        encoder = "fadd";
        required = ["fpu"];
        operands = [
            { kind = "reg"; width = 64; class = "fp"; access = "write"; },
            { kind = "reg"; width = 64; class = "fp"; },
            { kind = "reg"; width = 64; class = "fp"; }
        ];
    }
    form {
        mnemonic = "fmul";
        encoder = "fmul";
        required = ["fpu"];
        operands = [
            { kind = "reg"; width = 64; class = "fp"; access = "write"; },
            { kind = "reg"; width = 64; class = "fp"; },
            { kind = "reg"; width = 64; class = "fp"; }
        ];
    }
    form {
        mnemonic = "fmr";
        encoder = "fmr";
        required = ["fpu"];
        operands = [
            { kind = "reg"; width = 64; class = "fp"; access = "write"; },
            { kind = "reg"; width = 64; class = "fp"; }
        ];
    }
    form {
        mnemonic = "vand";
        encoder = "vand";
        required = ["altivec"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "vor";
        encoder = "vor";
        required = ["altivec"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "vadd";
        encoder = "vadd";
        required = ["altivec"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "lxvd2x";
        encoder = "lxvd2x";
        flags = ["reads_mem"];
        required = ["vsx"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "mem"; width = 128; }
        ];
    }
    form {
        mnemonic = "stxvd2x";
        encoder = "stxvd2x";
        flags = ["writes_mem"];
        required = ["vsx"];
        operands = [{ kind = "reg"; width = 128; class = "vec"; }, { kind = "mem"; width = 128; }];
    }
    form {
        mnemonic = "vcipher";
        encoder = "vcipher";
        required = ["crypto"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "dadd";
        encoder = "dadd";
        required = ["dfp"];
        operands = [
            { kind = "reg"; width = 64; class = "fp"; access = "write"; },
            { kind = "reg"; width = 64; class = "fp"; },
            { kind = "reg"; width = 64; class = "fp"; }
        ];
    }
    form { mnemonic = "tbegin"; encoder = "tbegin"; required = ["htm"]; }
    form { mnemonic = "tend"; encoder = "tend"; required = ["htm"]; }
    syntax default { comment = "#"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 8;
            content = "data";
        },
        { name = ".toc"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        { name = ".plt"; flags = ["exec", "alloc", "code"]; align = 8; content = "code"; },
        { name = ".eh_frame"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "tls_var"; binding = "tls"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; }
    ];
    reloc R_PPC64_NONE { width = 64; expr = "S + A"; }
    reloc R_PPC64_ADDR64 { width = 64; expr = "S + A"; }
    reloc R_PPC64_ADDR32 { width = 32; expr = "S + A"; }
    reloc R_PPC64_ADDR16 { width = 32; expr = "S + A"; }
    reloc R_PPC64_REL24 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_PPC64_REL64 { width = 64; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_PPC64_REL32 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_PPC64_TOC16 { width = 32; expr = "S + A - TOC"; }
    reloc R_PPC64_TOC16_HA { width = 32; expr = "S + A - TOC"; }
    reloc R_PPC64_TOC16_LO { width = 32; expr = "S + A - TOC"; }
    reloc R_PPC64_TOC16_DS { width = 32; expr = "S + A - TOC"; }
    reloc R_PPC64_REL16_HA { width = 32; expr = "S + A - P"; }
    reloc R_PPC64_REL16_LO { width = 32; expr = "S + A - P"; }
    reloc R_PPC64_GOT16 { width = 32; expr = "GOT(S) + A"; }
    reloc R_PPC64_PLT16_HA { width = 32; expr = "PLT(S) + A"; }
    reloc R_PPC64_TLSGD { width = 64; expr = "TLS(S) + A"; }
    reloc R_PPC64_TLSLD { width = 64; expr = "TLS(S) + A"; }
    reloc R_PPC64_TPREL16_HA { width = 32; expr = "TLS(S) + A"; }
    reloc R_PPC64_RELATIVE { width = 64; expr = "B + A"; }
    reloc R_PPC64_GLOB_DAT { width = 64; expr = "S + A"; }
    reloc R_PPC64_JMP_SLOT { width = 64; expr = "S + A"; }
    reloc R_PPC64_IRELATIVE { width = 64; expr = "B + A"; }
    debug = [
        {
            kind = "target";
            msg = "power64 base+fpu+altivec/vsx+powerisa+htm/mma stratification";
            ref = "";
        },
        { kind = "form"; msg = "vector forms require altivec/vsx"; ref = "vadd"; },
        { kind = "form"; msg = "privileged forms require priv"; ref = "rfid"; }
    ];
    backend = { file = "backend/ppc64.json"; };
}
