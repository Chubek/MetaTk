        mnemonic = "vadd";
        encoder = "vadd";
        required = ["vector"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "vst";
        encoder = "vst";
        flags = ["writes_mem"];
        required = ["vector"];
        operands = [{ kind = "reg"; width = 128; class = "vec"; }, { kind = "mem"; width = 128; }];
    }
    form {
        mnemonic = "adtr";
        encoder = "adtr";
        required = ["dfp"];
        operands = [
            { kind = "reg"; width = 64; class = "fp"; access = "readwrite"; },
            { kind = "reg"; width = 64; class = "fp"; }
        ];
    }
    form {
        mnemonic = "tbegin";
        encoder = "tbegin";
        required = ["tx"];
        operands = [{ kind = "mem"; width = 64; }];
    }
    form { mnemonic = "tend"; encoder = "tend"; required = ["tx"]; }
    form {
        mnemonic = "km";
        encoder = "km";
        required = ["crypto"];
        operands = [{ kind = "reg"; width = 64; class = "gpr"; }, { kind = "reg"; width = 64; class = "gpr"; }];
    }
    syntax default { comment = "#"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 2; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 8;
            content = "data";
        },
        { name = ".tdata"; flags = ["write", "alloc", "tls", "data"]; align = 8; content = "data"; },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        { name = ".eh_frame"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "tls_var"; binding = "tls"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; }
    ];
    reloc R_390_NONE { width = 32; expr = "S + A"; }
    reloc R_390_8 { width = 32; expr = "S + A"; }
    reloc R_390_12 { width = 32; expr = "S + A"; }
    reloc R_390_16 { width = 32; expr = "S + A"; }
    reloc R_390_20 { width = 32; expr = "S + A"; }
    reloc R_390_32 { width = 32; expr = "S + A"; }
    reloc R_390_64 { width = 64; expr = "S + A"; }
    reloc R_390_PC16 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_390_PC32 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_390_PC64 { width = 64; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_390_PC16DBL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_390_PC32DBL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_390_PLT32DBL { width = 32; signed = true; pcrel = true; expr = "PLT(S) + A - P"; }
    reloc R_390_GOT12 { width = 32; expr = "GOT(S) + A"; }
    reloc R_390_GOT16 { width = 32; expr = "GOT(S) + A"; }
    reloc R_390_GOT32 { width = 32; expr = "GOT(S) + A"; }
    reloc R_390_GOT64 { width = 64; expr = "GOT(S) + A"; }
    reloc R_390_GOTENT { width = 64; expr = "GOT(S) + A"; }
    reloc R_390_TLS_GD64 { width = 64; expr = "TLS(S) + A"; }
    reloc R_390_TLS_LDM64 { width = 64; expr = "TLS(S) + A"; }
    reloc R_390_TLS_TPOFF { width = 64; expr = "TLS(S) + A"; }
    reloc R_390_GLOB_DAT { width = 64; expr = "S + A"; }
    reloc R_390_JMP_SLOT { width = 64; expr = "S + A"; }
    reloc R_390_RELATIVE { width = 64; expr = "B + A"; }
    reloc R_390_IRELATIVE { width = 64; expr = "B + A"; }
    reloc R_390_COPY { width = 64; expr = "S"; }
    debug = [
        { kind = "target"; msg = "z/arch base+vector+dfp+tx+crypto+priv stratification"; ref = ""; },
        { kind = "form"; msg = "vector forms require vector"; ref = "vadd"; },
        { kind = "form"; msg = "privileged forms require priv"; ref = "lpsw"; }
    ];
    backend = { file = "backend/s390x.json"; };
}
