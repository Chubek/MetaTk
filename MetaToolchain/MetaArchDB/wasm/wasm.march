        operands = [{ kind = "sym"; width = 32; }];
    }
    syntax default { comment = ";;"; separator = " "; }
    syntax wat { comment = ";;"; separator = " "; }
    section wasm.type { flags = ["alloc", "readonly", "meta"]; align = 1; content = "meta"; }
    section wasm.import { flags = ["alloc", "readonly", "meta"]; align = 1; content = "meta"; }
    section wasm.function { flags = ["alloc", "code"]; align = 1; content = "code"; }
    section wasm.table { flags = ["alloc", "readonly", "meta"]; align = 1; content = "meta"; }
    section wasm.memory { flags = ["write", "alloc", "data"]; align = 1; content = "data"; }
    section wasm.global { flags = ["write", "alloc", "data"]; align = 1; content = "data"; }
    section wasm.export { flags = ["alloc", "readonly", "meta"]; align = 1; content = "meta"; }
    section wasm.code { flags = ["exec", "alloc", "code"]; align = 1; content = "code"; }
    section wasm.data { flags = ["write", "alloc", "data"]; align = 1; content = "data"; }
    linkages = [
        { name = "func_export"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "memory_export"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "local_func"; binding = "local"; visibility = "default"; symtype = "func"; }
    ];
    reloc R_WASM_FUNCTION_INDEX_LEB { width = 32; expr = "S + A"; }
    reloc R_WASM_TABLE_INDEX_SLEB { width = 32; signed = true; expr = "S + A"; }
    reloc R_WASM_MEMORY_ADDR_LEB { width = 32; expr = "S + A"; }
    reloc R_WASM_TYPE_INDEX_LEB { width = 32; expr = "S + A"; }
    reloc R_WASM_GLOBAL_INDEX_LEB { width = 32; expr = "S + A"; }
    reloc R_WASM_FUNCTION_OFFSET_I32 { width = 32; expr = "S + A"; }
    debug = [
        {
            kind = "target";
            msg = "wasm stack machine: mvp+simd+bulk+threads+tail stratification";
            ref = "";
        },
        { kind = "form"; msg = "simd forms require simd"; ref = "v128.load"; },
        { kind = "form"; msg = "atomic forms require threads"; ref = "i32.atomic.add"; }
    ];
    backend = { file = "backend/wasm.json"; };
}
