# Generated from ArchDB/wasm.dsymspec.yaml by tools/compile_archdb.py.
# Regenerate from the YAML source; see MetaArchDB/README.md.
architecture {
    schema = 1;
    target {
        arch = "wasm";
        subarch = "wasm32";
        addr_size = 32;
        op_size = 32;
        addr_def = 32;
        align = 1;
        byte_order = "little";
        obj_format = "wasm";
        abi = "wasm-stack";
        calling_conv = "wasm-c-abi";
        features = ["mvp", "sign-ext", "bulk-memory"];
    }
    feature mvp { desc = "WebAssembly 1.0 MVP"; }
    feature simd { desc = "128-bit fixed-width SIMD"; }
    feature bulk-memory { desc = "bulk memory operations"; }
    feature multi-value { desc = "multi-value returns"; }
    feature reference-types { desc = "reference types (funcref/externref)"; }
    feature tail-calls { desc = "tail calls"; }
    feature threads { desc = "threads/atomics"; }
    feature sign-ext { desc = "sign-extension operators"; }
    feature nontrapping-fptoint { desc = "non-trapping float-to-int"; }
    feature gc { desc = "garbage collection (struct/array)"; }
    feature priv { desc = "privileged host imports (wasi)"; }
    register stack { class = "special"; width = 32; enc = 0; }
    register memory0 { class = "special"; width = 32; enc = 0; }
    register table0 { class = "special"; width = 32; enc = 0; }
    register global0 { class = "special"; width = 32; enc = 0; }
    mnemonic unreachable {  }
    mnemonic nop {  }
    mnemonic block {  }
    mnemonic loop {  }
    mnemonic if {  }
    mnemonic else {  }
    mnemonic end {  }
    mnemonic br {  }
    mnemonic br_if {  }
    mnemonic return {  }
    mnemonic call {  }
    mnemonic call_indirect {  }
    mnemonic drop {  }
    mnemonic select {  }
    mnemonic local.get {  }
    mnemonic local.set {  }
    mnemonic local.tee {  }
    mnemonic global.get {  }
    mnemonic i32.load {  }
    mnemonic i64.load {  }
    mnemonic i32.store {  }
    mnemonic i64.store {  }
    mnemonic memory.size {  }
    mnemonic memory.grow {  }
    mnemonic memory.copy {  }
    mnemonic memory.fill {  }
    mnemonic i32.const {  }
    mnemonic i64.const {  }
    mnemonic i32.add {  }
    mnemonic i32.sub {  }
    mnemonic i32.mul {  }
    mnemonic i32.div_s {  }
    mnemonic i32.and {  }
    mnemonic i32.or {  }
    mnemonic i32.xor {  }
    mnemonic i32.eqz {  }
    mnemonic i64.add {  }
    mnemonic f32.add {  }
    mnemonic f64.add {  }
    mnemonic i32.wrap_i64 {  }
    mnemonic i32.extend8_s {  }
    mnemonic v128.load {  }
    mnemonic i32x4.add {  }
    mnemonic i32.atomic.add {  }
    mnemonic return_call {  }
    encoder unreachable { max_bytes = 1; body = "EMIT8 0x00\n"; }
    encoder nop { max_bytes = 1; body = "EMIT8 0x01\n"; }
    encoder block { max_bytes = 2; body = "EMIT8 0x02\nEMIT_IMM 1, type\n"; }
    encoder loop { max_bytes = 2; body = "EMIT8 0x03\nEMIT_IMM 1, type\n"; }
    encoder if { max_bytes = 2; body = "EMIT8 0x04\nEMIT_IMM 1, type\n"; }
    encoder else { max_bytes = 1; body = "EMIT8 0x05\n"; }
    encoder end { max_bytes = 1; body = "EMIT8 0x0B\n"; }
    encoder br { max_bytes = 5; body = "EMIT8 0x0C\nEMIT_IMM 4, label\n"; }
    encoder br_if { max_bytes = 5; body = "EMIT8 0x0D\nEMIT_IMM 4, label\n"; }
    encoder return { max_bytes = 1; body = "EMIT8 0x0F\n"; }
    encoder call {
        max_bytes = 5;
        max_relocs = 1;
        body = "EMIT8 0x10\nEMIT_IMM 4, fn\nEMIT_RELOCATION sym, R_WASM_FUNCTION_INDEX_LEB\n";
    }
    encoder call_indirect { max_bytes = 9; body = "EMIT8 0x11\nEMIT_IMM 4, type\nEMIT_IMM 4, table\n"; }
    encoder drop { max_bytes = 1; body = "EMIT8 0x1A\n"; }
    encoder select { max_bytes = 1; body = "EMIT8 0x1B\n"; }
    encoder localget { max_bytes = 5; body = "EMIT8 0x20\nEMIT_IMM 4, idx\n"; }
    encoder localset { max_bytes = 5; body = "EMIT8 0x21\nEMIT_IMM 4, idx\n"; }
    encoder localtee { max_bytes = 5; body = "EMIT8 0x22\nEMIT_IMM 4, idx\n"; }
    encoder globalget { max_bytes = 5; body = "EMIT8 0x23\nEMIT_IMM 4, idx\n"; }
    encoder i32load { max_bytes = 9; body = "EMIT8 0x28\nEMIT_IMM 4, align\nEMIT_IMM 4, off\n"; }
    encoder i64load { max_bytes = 9; body = "EMIT8 0x29\nEMIT_IMM 4, align\nEMIT_IMM 4, off\n"; }
    encoder i32store { max_bytes = 9; body = "EMIT8 0x36\nEMIT_IMM 4, align\nEMIT_IMM 4, off\n"; }
    encoder i64store { max_bytes = 9; body = "EMIT8 0x37\nEMIT_IMM 4, align\nEMIT_IMM 4, off\n"; }
    encoder memsize { max_bytes = 2; body = "EMIT8 0x3F\nEMIT8 0x00\n"; }
    encoder memgrow { max_bytes = 2; body = "EMIT8 0x40\nEMIT8 0x00\n"; }
    encoder memcopy { max_bytes = 2; body = "EMIT8 0xFC\nEMIT8 0x0A\n"; }
    encoder memfill { max_bytes = 2; body = "EMIT8 0xFC\nEMIT8 0x0B\n"; }
    encoder i32const { max_bytes = 5; body = "EMIT8 0x41\nEMIT_IMM 4, imm\n"; }
    encoder i64const { max_bytes = 9; body = "EMIT8 0x42\nEMIT_IMM 8, imm\n"; }
    encoder i32add { max_bytes = 1; body = "EMIT8 0x6A\n"; }
    encoder i32sub { max_bytes = 1; body = "EMIT8 0x6B\n"; }
    encoder i32mul { max_bytes = 1; body = "EMIT8 0x6C\n"; }
    encoder i32div { max_bytes = 1; body = "EMIT8 0x6D\n"; }
    encoder i32and { max_bytes = 1; body = "EMIT8 0x71\n"; }
    encoder i32or { max_bytes = 1; body = "EMIT8 0x72\n"; }
    encoder i32xor { max_bytes = 1; body = "EMIT8 0x73\n"; }
    encoder i32eqz { max_bytes = 1; body = "EMIT8 0x45\n"; }
    encoder i64add { max_bytes = 1; body = "EMIT8 0x7C\n"; }
    encoder f32add { max_bytes = 1; body = "EMIT8 0x92\n"; }
    encoder f64add { max_bytes = 1; body = "EMIT8 0xA0\n"; }
    encoder i32wrap { max_bytes = 1; body = "EMIT8 0xA7\n"; }
    encoder i32extend { max_bytes = 1; body = "EMIT8 0xC0\n"; }
    encoder v128load { max_bytes = 10; body = "EMIT8 0xFD\nEMIT8 0x00\nEMIT_IMM 4, align\nEMIT_IMM 4, off\n"; }
    encoder i32x4add { max_bytes = 2; body = "EMIT8 0xFD\nEMIT8 0x4E\n"; }
    encoder atomicadd { max_bytes = 10; body = "EMIT8 0xFE\nEMIT8 0x1E\nEMIT_IMM 4, align\nEMIT_IMM 4, off\n"; }
    encoder returncall { max_bytes = 5; body = "EMIT8 0x12\nEMIT_IMM 4, fn\n"; }
    form { mnemonic = "unreachable"; encoder = "unreachable"; flags = ["terminator", "may_trap"]; }
    form { mnemonic = "nop"; encoder = "nop"; }
    form {
        mnemonic = "block";
        encoder = "block";
        operands = [{ kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; }];
    }
    form {
        mnemonic = "loop";
        encoder = "loop";
        operands = [{ kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; }];
    }
    form {
        mnemonic = "if";
        encoder = "if";
        flags = ["cond_branch"];
        operands = [{ kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; }];
    }
    form { mnemonic = "else"; encoder = "else"; }
    form { mnemonic = "end"; encoder = "end"; }
    form {
        mnemonic = "br";
        encoder = "br";
        flags = ["branch", "terminator"];
        operands = [{ kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; }];
    }
    form {
        mnemonic = "br_if";
        encoder = "br_if";
        flags = ["cond_branch"];
        operands = [{ kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; }];
    }
    form { mnemonic = "return"; encoder = "return"; flags = ["return", "terminator"]; }
    form {
        mnemonic = "call";
        encoder = "call";
        flags = ["branch", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "call_indirect";
        encoder = "call_indirect";
        flags = ["branch"];
        operands = [
            { kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; },
            { kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; }
        ];
    }
    form { mnemonic = "drop"; encoder = "drop"; }
    form { mnemonic = "select"; encoder = "select"; }
    form {
        mnemonic = "local.get";
        encoder = "localget";
        operands = [{ kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; }];
    }
    form {
        mnemonic = "local.set";
        encoder = "localset";
        operands = [{ kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; }];
    }
    form {
        mnemonic = "local.tee";
        encoder = "localtee";
        operands = [{ kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; }];
    }
    form {
        mnemonic = "global.get";
        encoder = "globalget";
        operands = [{ kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; }];
    }
    form {
        mnemonic = "i32.load";
