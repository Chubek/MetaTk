            { kind = "imm"; width = 32; imm_min = 0; imm_max = 4294967295; signed = false; }
        ];
    }
    form { mnemonic = "memory.size"; encoder = "memsize"; flags = ["reads_mem"]; }
    form { mnemonic = "memory.grow"; encoder = "memgrow"; flags = ["writes_mem"]; }
    form {
        mnemonic = "memory.copy";
        encoder = "memcopy";
        flags = ["reads_mem", "writes_mem"];
        required = ["bulk-memory"];
    }
    form {
        mnemonic = "memory.fill";
        encoder = "memfill";
        flags = ["writes_mem"];
        required = ["bulk-memory"];
    }
    form {
        mnemonic = "i32.const";
        encoder = "i32const";
        operands = [
            {
                kind = "imm";
                width = 32;
                imm_min = -2147483648;
                imm_max = 2147483647;
                signed = true;
            }
        ];
    }
    form {
        mnemonic = "i64.const";
        encoder = "i64const";
        operands = [
            {
                kind = "imm";
                width = 32;
                imm_min = -2147483648;
                imm_max = 2147483647;
                signed = true;
            }
        ];
    }
    form { mnemonic = "i32.add"; encoder = "i32add"; }
    form { mnemonic = "i32.sub"; encoder = "i32sub"; }
    form { mnemonic = "i32.mul"; encoder = "i32mul"; }
    form { mnemonic = "i32.div_s"; encoder = "i32div"; flags = ["may_trap"]; }
    form { mnemonic = "i32.and"; encoder = "i32and"; }
    form { mnemonic = "i32.or"; encoder = "i32or"; }
    form { mnemonic = "i32.xor"; encoder = "i32xor"; }
    form { mnemonic = "i32.eqz"; encoder = "i32eqz"; }
    form { mnemonic = "i64.add"; encoder = "i64add"; }
    form { mnemonic = "f32.add"; encoder = "f32add"; }
    form { mnemonic = "f64.add"; encoder = "f64add"; }
    form { mnemonic = "i32.wrap_i64"; encoder = "i32wrap"; }
