    register r31 { class = "gpr"; width = 32; enc = 31; flags = ["readable", "writable"]; }
    register pc { class = "special"; width = 32; enc = 2; parent = "r2"; sub_lo = 0; sub_hi = 32; }
    register sp { class = "special"; width = 32; enc = 4; parent = "r4"; sub_lo = 0; sub_hi = 32; }
