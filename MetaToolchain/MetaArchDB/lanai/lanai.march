    register sw { class = "status"; width = 32; enc = 0; }
    mnemonic add {  }
    mnemonic nop {  }
    mnemonic ld {  }
    encoder add_i_lo {
        max_bytes = 4;
        body = "REQUIRE rd >= 0\nREQUIRE rd <= 31\nREQUIRE rs >= 0\nREQUIRE rs <= 31\nREQUIRE imm >= 0\nREQUIRE imm <= 65535\nEMIT32BE rd*8388608 + rs*262144 + imm\n";
    }
    encoder nop { max_bytes = 4; body = "EMIT32BE 1\n"; }
