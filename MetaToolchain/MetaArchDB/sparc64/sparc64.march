    encoder retry { max_bytes = 4; body = "EMIT32BE 0x83F00000\n"; }
    form { mnemonic = "nop"; encoder = "nop"; }
    form {
        mnemonic = "add";
        encoder = "add";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "addcc";
        encoder = "addcc";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "and";
        encoder = "and";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "or";
        encoder = "or";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "xor";
        encoder = "xor";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sub";
        encoder = "sub";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "mulx";
        encoder = "mulx";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sdivx";
        encoder = "sdivx";
        flags = ["may_trap"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sllx";
        encoder = "sllx";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "srlx";
        encoder = "srlx";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "srax";
        encoder = "srax";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "cmp";
        encoder = "cmp";
        operands = [{ kind = "reg"; width = 64; class = "gpr"; }, { kind = "reg"; width = 64; class = "gpr"; }];
    }
    form {
        mnemonic = "sethi";
        encoder = "sethi";
        flags = ["reloc"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "imm"; width = 22; imm_min = 0; imm_max = 4194303; signed = false; }
        ];
    }
    form {
        mnemonic = "ld";
        encoder = "ld";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "ldx";
        encoder = "ldx";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 64; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "ldub";
        encoder = "ldub";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 8; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "st";
        encoder = "st";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 32; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "stx";
        encoder = "stx";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 64; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "stb";
        encoder = "stb";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 8; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "lda";
        encoder = "lda";
        flags = ["privileged", "reads_mem"];
        required = ["priv"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sta";
        encoder = "sta";
        flags = ["privileged", "writes_mem"];
        required = ["priv"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 32; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "jmpl";
        encoder = "jmpl";
        flags = ["branch", "delayed"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; }
        ];
    }
    form {
        mnemonic = "call";
        encoder = "call";
        flags = ["branch", "delayed", "reloc"];
        operands = [{ kind = "sym"; width = 64; }];
    }
    form {
        mnemonic = "br";
        encoder = "br";
        flags = ["cond_branch", "delayed", "reloc"];
        operands = [{ kind = "cond"; width = 8; }, { kind = "sym"; width = 64; }];
    }
    form {
        mnemonic = "cbcond";
        encoder = "cbcond";
        flags = ["cond_branch", "reloc"];
        required = ["cbcond"];
        operands = [{ kind = "reg"; width = 64; class = "gpr"; }, { kind = "sym"; width = 64; }];
    }
    form {
        mnemonic = "save";
        encoder = "save";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "restore";
        encoder = "restore";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form { mnemonic = "ret"; encoder = "ret"; flags = ["return", "terminator", "delayed"]; }
    form { mnemonic = "retl"; encoder = "retl"; flags = ["return", "terminator", "delayed"]; }
    form {
        mnemonic = "ta";
        encoder = "ta";
        flags = ["may_trap"];
        operands = [{ kind = "imm"; width = 8; imm_min = 0; imm_max = 127; signed = false; }];
    }
    form {
        mnemonic = "flush";
        encoder = "flush";
        operands = [{ kind = "reg"; width = 64; class = "gpr"; }, { kind = "reg"; width = 64; class = "gpr"; }];
    }
    form {
        mnemonic = "membar";
        encoder = "membar";
        operands = [{ kind = "imm"; width = 8; imm_min = 0; imm_max = 127; signed = false; }];
    }
    form {
        mnemonic = "prefetch";
        encoder = "prefetch";
        flags = ["reads_mem"];
        operands = [{ kind = "mem"; width = 64; }, { kind = "reg"; width = 64; class = "gpr"; }];
    }
    form {
        mnemonic = "fadds";
        encoder = "fadds";
        required = ["fpu"];
        operands = [
            { kind = "reg"; width = 32; class = "fp"; access = "write"; },
            { kind = "reg"; width = 32; class = "fp"; },
            { kind = "reg"; width = 32; class = "fp"; }
        ];
    }
    form {
        mnemonic = "fmuld";
        encoder = "fmuld";
        required = ["fpu"];
        operands = [
            { kind = "reg"; width = 64; class = "fp"; access = "write"; },
            { kind = "reg"; width = 64; class = "fp"; },
            { kind = "reg"; width = 64; class = "fp"; }
        ];
    }
    form {
        mnemonic = "fcmpd";
        encoder = "fcmpd";
        required = ["fpu"];
        operands = [{ kind = "reg"; width = 64; class = "fp"; }, { kind = "reg"; width = 64; class = "fp"; }];
    }
    form {
        mnemonic = "fpadd16";
        encoder = "fpadd16";
        required = ["vis"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "pdist";
        encoder = "pdist";
        required = ["vis"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "popc";
        encoder = "popc";
        required = ["popc"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "aes";
        encoder = "aes";
        required = ["crypto"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "wrpr";
        encoder = "wrpr";
        flags = ["privileged"];
        required = ["priv"];
        operands = [{ kind = "reg"; width = 64; class = "gpr"; }, { kind = "reg"; width = 64; class = "gpr"; }];
    }
    form {
        mnemonic = "done";
        encoder = "done";
        flags = ["privileged", "return", "terminator"];
        required = ["priv"];
    }
    form {
        mnemonic = "retry";
        encoder = "retry";
        flags = ["privileged", "return", "terminator"];
        required = ["priv"];
    }
    syntax default { comment = "!"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 8;
            content = "data";
        },
        { name = ".tdata"; flags = ["write", "alloc", "tls", "data"]; align = 8; content = "data"; },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        { name = ".plt"; flags = ["exec", "alloc", "code"]; align = 8; content = "code"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "tls_var"; binding = "tls"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; }
    ];
    reloc R_SPARC_NONE { width = 32; expr = "S + A"; }
    reloc R_SPARC_64 { width = 64; expr = "S + A"; }
    reloc R_SPARC_32 { width = 32; expr = "S + A"; }
    reloc R_SPARC_16 { width = 32; expr = "S + A"; }
    reloc R_SPARC_WDISP30 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_SPARC_WDISP22 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_SPARC_WDISP19 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_SPARC_WDISP16 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_SPARC_HI22 { width = 32; expr = "HI22(S + A)"; }
    reloc R_SPARC_LO10 { width = 32; expr = "LO10(S + A)"; }
    reloc R_SPARC_HIX22 { width = 32; expr = "HIX22(S + A)"; }
    reloc R_SPARC_LOX10 { width = 32; expr = "LO10(S + A)"; }
    reloc R_SPARC_GOT22 { width = 32; expr = "GOT(S) + A"; }
    reloc R_SPARC_GOT10 { width = 32; expr = "GOT(S) + A"; }
    reloc R_SPARC_PC22 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_SPARC_PC10 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_SPARC_TLS_GD_HI22 { width = 32; expr = "TLS(S) + A"; }
    reloc R_SPARC_TLS_GD_LO10 { width = 32; expr = "TLS(S) + A"; }
    reloc R_SPARC_TLS_TPOFF32 { width = 32; expr = "TLS(S) + A"; }
    reloc R_SPARC_RELATIVE { width = 64; expr = "B + A"; }
    reloc R_SPARC_GLOB_DAT { width = 64; expr = "S + A"; }
    reloc R_SPARC_JMP_SLOT { width = 64; expr = "S + A"; }
    debug = [
        { kind = "target"; msg = "sparcv9 windows+delay slots+fpu/vis/crypto+priv"; ref = ""; },
        { kind = "form"; msg = "vis forms require vis"; ref = "fpadd16"; },
        { kind = "form"; msg = "privileged ASI forms need priv"; ref = "lda"; }
    ];
    backend = { file = "backend/sparc64.json"; };
}
