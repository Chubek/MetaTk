        ];
    }
    syntax default { comment = ";"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 2; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 4; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 4;
            content = "data";
        },
        { name = ".sdata"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; },
        {
            name = ".sbss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 4;
            content = "data";
        },
        { name = ".init"; flags = ["exec", "alloc", "code"]; align = 2; content = "code"; },
        { name = ".fini"; flags = ["exec", "alloc", "code"]; align = 2; content = "code"; },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; },
        { name = ".eh_frame"; flags = ["alloc", "readonly", "data"]; align = 4; content = "data"; },
        { name = ".comment"; flags = ["readonly", "merge", "meta"]; align = 1; content = "meta"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; }
    ];
    reloc R_ARC_NONE { width = 32; expr = "S + A"; }
    reloc R_ARC_8 { width = 8; expr = "S + A"; }
    reloc R_ARC_16 { width = 16; expr = "S + A"; }
    reloc R_ARC_24 { width = 32; expr = "S + A"; }
    reloc R_ARC_32 { width = 32; expr = "S + A"; }
    reloc R_ARC_N8 { width = 8; expr = "A - S"; }
    reloc R_ARC_N16 { width = 16; expr = "A - S"; }
    reloc R_ARC_N32 { width = 32; expr = "A - S"; }
    reloc R_ARC_SDA { width = 32; expr = "S + A"; }
    reloc R_ARC_SECTOFF { width = 32; expr = "S + A"; }
    reloc R_ARC_S21H_PCREL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARC_S21W_PCREL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARC_S25H_PCREL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARC_S25W_PCREL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARC_SDA32 { width = 32; expr = "S + A"; }
    reloc R_ARC_S13_PCREL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARC_32_PCREL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARC_PC32 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARC_GOT32 { width = 32; expr = "GOT(S) + A"; }
    reloc R_ARC_GOTPC32 { width = 32; signed = true; pcrel = true; expr = "GOT(S) + A - P"; }
    reloc R_ARC_PLT32 { width = 32; signed = true; pcrel = true; expr = "PLT(S) + A - P"; }
    reloc R_ARC_COPY { width = 32; expr = "S"; }
    reloc R_ARC_GLOB_DAT { width = 32; expr = "S"; }
    reloc R_ARC_JMP_SLOT { width = 32; expr = "S"; }
    reloc R_ARC_RELATIVE { width = 32; expr = "B + A"; }
    reloc R_ARC_GOTOFF { width = 32; expr = "S + A"; }
    reloc R_ARC_TLS_DTPMOD { width = 32; expr = "TLS(S) + A"; }
    reloc R_ARC_TLS_DTPOFF { width = 32; expr = "TLS(S) + A"; }
    reloc R_ARC_TLS_TPOFF { width = 32; expr = "TLS(S) + A"; }
    debug = [
        {
            kind = "target";
            msg = "arc ARCv2 base+mpy/shift/cd default; norm/atomic/fpu/dsp/loop/priv opt-in";
            ref = "";
        },
        {
            kind = "form";
            msg = ".f forms set STATUS32; .cc predicated forms consume STATUS32 (see backend Predicates)";
            ref = "add.f";
        },
        {
            kind = "form";
            msg = "compact _s forms require cd; loop forms require loop; priv forms require priv";
            ref = "add_s";
        }
    ];
    backend = { file = "backend/arc.json"; };
}
