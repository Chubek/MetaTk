        operands = [{ kind = "imm"; width = 8; imm_min = 0; imm_max = 127; signed = false; }];
    }
    form {
        mnemonic = "mrs";
        encoder = "mrs";
        flags = ["privileged"];
        required = ["priv"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "ctrl"; }
        ];
    }
    form {
        mnemonic = "msr";
        encoder = "msr";
        flags = ["privileged"];
        required = ["priv"];
        operands = [
            { kind = "reg"; width = 64; class = "ctrl"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "ldxr";
        encoder = "ldxr";
        flags = ["reads_mem"];
        required = ["lse"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 64; }
        ];
    }
    form {
        mnemonic = "stxr";
        encoder = "stxr";
        flags = ["writes_mem"];
        required = ["lse"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 64; }
        ];
    }
    form {
        mnemonic = "cas";
        encoder = "cas";
        flags = ["reads_mem", "writes_mem"];
        required = ["lse"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "mem"; width = 64; }
        ];
    }
    form {
        mnemonic = "fadd";
        encoder = "fadd";
        required = ["fp"];
        operands = [
            { kind = "reg"; width = 64; class = "fp"; },
            { kind = "reg"; width = 64; class = "fp"; },
            { kind = "reg"; width = 64; class = "fp"; }
        ];
    }
    form {
        mnemonic = "fmul";
        encoder = "fmul";
        required = ["fp"];
        operands = [
            { kind = "reg"; width = 64; class = "fp"; },
            { kind = "reg"; width = 64; class = "fp"; },
            { kind = "reg"; width = 64; class = "fp"; }
        ];
    }
    form {
        mnemonic = "fcmp";
        encoder = "fcmp";
        required = ["fp"];
        operands = [{ kind = "reg"; width = 64; class = "fp"; }, { kind = "reg"; width = 64; class = "fp"; }];
    }
    form {
        mnemonic = "fmov";
        encoder = "fmov";
        required = ["fp"];
        operands = [
            { kind = "reg"; width = 64; class = "fp"; access = "write"; },
            { kind = "reg"; width = 64; class = "fp"; }
        ];
    }
    form {
        mnemonic = "vadd";
        encoder = "vadd";
        required = ["neon"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "ld1";
        encoder = "ld1";
        flags = ["reads_mem"];
        required = ["neon"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "mem"; width = 128; }
        ];
    }
    form {
        mnemonic = "st1";
        encoder = "st1";
        flags = ["writes_mem"];
        required = ["neon"];
        operands = [{ kind = "reg"; width = 128; class = "vec"; }, { kind = "mem"; width = 128; }];
    }
    form {
        mnemonic = "aesd";
        encoder = "aesd";
        required = ["aes"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "sha256h";
        encoder = "sha256h";
        required = ["sha2"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "crc32b";
        encoder = "crc32b";
        required = ["crc"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "smull2";
        encoder = "udot";
        required = ["dp"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "rndr";
        encoder = "rndr";
        required = ["rng"];
        operands = [{ kind = "reg"; width = 64; class = "gpr"; access = "write"; }];
    }
    form {
        mnemonic = "pacia";
        encoder = "pacia";
        required = ["paca"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form { mnemonic = "bti"; encoder = "bti"; required = ["bti"]; }
    form {
        mnemonic = "irg";
        encoder = "irg";
        required = ["mte"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form { mnemonic = "sb"; encoder = "sb"; required = ["sb"]; }
    syntax default { comment = "//"; separator = ", "; }
    syntax llvm { comment = "//"; separator = ", "; tmpl = "{mnemonic} {ops}"; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 8;
            content = "data";
        },
        { name = ".tdata"; flags = ["write", "alloc", "tls", "data"]; align = 8; content = "data"; },
        {
            name = ".tbss";
            flags = ["write", "alloc", "zerofill", "tls", "data"];
            align = 8;
            content = "data";
        },
        { name = ".init"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".fini"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".plt"; flags = ["exec", "alloc", "code"]; align = 16; content = "code"; },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        { name = ".eh_frame"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; },
        { name = ".comment"; flags = ["readonly", "merge", "meta"]; align = 1; content = "meta"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "tls_var"; binding = "tls"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; },
        { name = "hidden_func"; binding = "global"; visibility = "hidden"; symtype = "func"; }
    ];
    reloc R_AARCH64_NONE { width = 32; expr = "S + A"; }
    reloc R_AARCH64_ABS64 { width = 64; expr = "S + A"; }
    reloc R_AARCH64_ABS32 { width = 32; expr = "S + A"; }
    reloc R_AARCH64_ABS16 { width = 32; expr = "S + A"; }
    reloc R_AARCH64_PREL64 { width = 64; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_AARCH64_PREL32 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_AARCH64_PREL16 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_AARCH64_JUMP26 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_AARCH64_CALL26 { width = 32; signed = true; pcrel = true; expr = "PLT(S) + A - P"; }
    reloc R_AARCH64_ADR_PREL_PG_HI21 { width = 32; signed = true; pcrel = true; expr = "Page(S + A) - Page(P)"; }
    reloc R_AARCH64_ADR_PREL_PG_HI21_NC { width = 32; pcrel = true; expr = "Page(S + A) - Page(P)"; }
    reloc R_AARCH64_ADD_ABS_LO12_NC { width = 32; expr = "S + A"; }
    reloc R_AARCH64_LDST64_ABS_LO12_NC { width = 32; expr = "S + A"; }
    reloc R_AARCH64_LDST128_ABS_LO12_NC { width = 32; expr = "S + A"; }
    reloc R_AARCH64_MOVW_UABS_G0_NC { width = 32; expr = "S + A"; }
    reloc R_AARCH64_MOVW_UABS_G1_NC { width = 32; expr = "S + A"; }
    reloc R_AARCH64_MOVW_UABS_G2_NC { width = 32; expr = "S + A"; }
    reloc R_AARCH64_MOVW_UABS_G3 { width = 32; expr = "S + A"; }
    reloc R_AARCH64_GOTREL64 { width = 64; expr = "GOT(S) + A"; }
    reloc R_AARCH64_GOTPCREL { width = 32; signed = true; pcrel = true; expr = "GOT(S) + A - P"; }
    reloc R_AARCH64_TLSDESC_ADR_PREL21 { width = 32; signed = true; pcrel = true; expr = "TLS(S) + A - P"; }
    reloc R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21 { width = 32; signed = true; pcrel = true; expr = "TLS(S) + A - P"; }
    reloc R_AARCH64_TLSLE_ADD_TPREL_LO12_NC { width = 32; expr = "TLS(S) + A"; }
    reloc R_AARCH64_GLOB_DAT { width = 64; expr = "S + A"; }
    reloc R_AARCH64_JUMP_SLOT { width = 64; expr = "S + A"; }
    reloc R_AARCH64_RELATIVE { width = 64; expr = "B + A"; }
    reloc R_AARCH64_IRELATIVE { width = 64; expr = "B + A"; }
    debug = [
        { kind = "target"; msg = "a64 base + fp/neon + sve/sme + crypto + lse + system"; ref = ""; },
        { kind = "form"; msg = "sve/sme forms need sve/sme features"; ref = "vadd"; },
        { kind = "form"; msg = "privileged system forms need priv"; ref = "mrs"; }
    ];
    backend = { file = "backend/aarch64.json"; };
}
