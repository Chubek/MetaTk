        encoder = "call";
        flags = ["branch", "reloc"];
        operands = [{ kind = "sym"; width = 64; }];
    }
    form { mnemonic = "ret"; encoder = "ret"; flags = ["return", "terminator"]; }
    form { mnemonic = "exit"; encoder = "exit"; flags = ["terminator"]; }
    form {
        mnemonic = "bar.sync";
        encoder = "bar";
        operands = [{ kind = "imm"; width = 8; imm_min = 0; imm_max = 15; signed = false; }];
    }
    form { mnemonic = "membar"; encoder = "membar"; }
    form {
        mnemonic = "shfl";
        encoder = "shfl";
        required = ["shfl"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "vote";
        encoder = "vote";
        required = ["vote"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "fadd";
        encoder = "fadd";
        operands = [
            { kind = "reg"; width = 32; class = "fp"; access = "write"; },
            { kind = "reg"; width = 32; class = "fp"; },
            { kind = "reg"; width = 32; class = "fp"; }
        ];
    }
    form {
        mnemonic = "fmul";
        encoder = "fmul";
        operands = [
            { kind = "reg"; width = 32; class = "fp"; access = "write"; },
            { kind = "reg"; width = 32; class = "fp"; },
            { kind = "reg"; width = 32; class = "fp"; }
        ];
    }
    form {
        mnemonic = "mma";
        encoder = "mma";
        required = ["mma"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    syntax ptx { comment = "//"; separator = ", "; }
    syntax sass { comment = "//"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".param"; flags = ["alloc", "data"]; align = 4; content = "data"; },
        { name = ".shared"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; },
        { name = ".const"; flags = ["alloc", "readonly", "data"]; align = 4; content = "data"; },
        { name = ".local"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; },
        { name = ".global"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; }
    ];
    linkages = [
        { name = "kernel_entry"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_device"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "var_global"; binding = "global"; visibility = "default"; symtype = "object"; }
    ];
    reloc R_NVPTX_NONE { width = 32; expr = "S + A"; }
    reloc R_NVPTX_ABS64 { width = 64; expr = "S + A"; }
    reloc R_NVPTX_ABS32 { width = 32; expr = "S + A"; }
    reloc R_NVPTX_REL32 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_NVPTX_PARAM { width = 64; expr = "S + A"; }
    debug = [
        {
            kind = "target";
            msg = "ptx virtual ISA: base+fp+mma/copy/async+shfl/vote+atomics";
            ref = "";
        },
        { kind = "form"; msg = "async-copy forms require cp.async"; ref = "cp.async"; },
        { kind = "form"; msg = "mma forms require mma/wmma"; ref = "mma"; }
    ];
    backend = { file = "backend/nvptx.json"; };
}
