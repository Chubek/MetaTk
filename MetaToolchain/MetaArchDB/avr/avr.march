        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT16LE 0x940C\nEMIT16LE 0\nEMIT_RELOCATION sym, R_AVR_CALL\n";
    }
    encoder call {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT16LE 0x940E\nEMIT16LE 0\nEMIT_RELOCATION sym, R_AVR_CALL\n";
    }
    encoder ret { max_bytes = 2; body = "EMIT16LE 0x9508\n"; }
    encoder reti { max_bytes = 2; body = "EMIT16LE 0x9518\n"; }
    encoder brbs { max_bytes = 2; body = "EMIT16LE 0xF000 + rs*128 + ((imm + 64) % 64)\n"; }
    encoder sbi { max_bytes = 2; body = "EMIT16LE 0x9A00 + rs*256 + (imm % 8)\n"; }
    encoder cbi { max_bytes = 2; body = "EMIT16LE 0x9800 + rs*256 + (imm % 8)\n"; }
    encoder bst { max_bytes = 2; body = "EMIT16LE 0xFA00 + rs*16 + (imm % 8)\n"; }
    encoder bld { max_bytes = 2; body = "EMIT16LE 0xF800 + rd*16 + (imm % 8)\n"; }
    encoder sei { max_bytes = 2; body = "EMIT16LE 0x9478\n"; }
    encoder cli { max_bytes = 2; body = "EMIT16LE 0x94F8\n"; }
    encoder sleep { max_bytes = 2; body = "EMIT16LE 0x9588\n"; }
    encoder break { max_bytes = 2; body = "EMIT16LE 0x9598\n"; }
    encoder wdr { max_bytes = 2; body = "EMIT16LE 0x95A8\n"; }
    form { mnemonic = "nop"; encoder = "nop"; }
    form {
