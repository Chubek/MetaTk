    form { mnemonic = "wdr"; encoder = "wdr"; required = ["break"]; }
    syntax default { comment = ";"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 2; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 2; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 2; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 2;
            content = "data";
        },
        { name = ".eeprom"; flags = ["write", "alloc", "data"]; align = 2; content = "data"; },
        { name = ".fuse"; flags = ["alloc", "readonly", "meta"]; align = 1; content = "meta"; }
