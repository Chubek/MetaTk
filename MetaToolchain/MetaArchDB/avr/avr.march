    register r11 { class = "gpr"; width = 8; enc = 11; flags = ["readable", "writable"]; }
    register r12 { class = "gpr"; width = 8; enc = 12; flags = ["readable", "writable"]; }
    register r13 { class = "gpr"; width = 8; enc = 13; flags = ["readable", "writable"]; }
