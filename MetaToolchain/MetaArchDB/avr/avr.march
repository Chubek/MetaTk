    register r25 { class = "gpr"; width = 8; enc = 25; flags = ["readable", "writable"]; }
    register r26 { class = "gpr"; width = 8; enc = 26; flags = ["readable", "writable"]; }
    register r27 { class = "gpr"; width = 8; enc = 27; flags = ["readable", "writable"]; }
    register r28 { class = "gpr"; width = 8; enc = 28; flags = ["readable", "writable"]; }
    register r29 { class = "gpr"; width = 8; enc = 29; flags = ["readable", "writable"]; }
    register r30 { class = "gpr"; width = 8; enc = 30; flags = ["readable", "writable"]; }
    register r31 { class = "gpr"; width = 8; enc = 31; flags = ["readable", "writable"]; }
    register X {
        class = "gpr";
        width = 16;
        enc = 26;
        parent = "r26";
        sub_lo = 0;
        sub_hi = 8;
        flags = ["readable", "writable"];
    }
    register Y {
        class = "gpr";
        width = 16;
        enc = 28;
        parent = "r28";
        sub_lo = 0;
        sub_hi = 8;
        flags = ["readable", "writable"];
    }
    register Z {
        class = "gpr";
        width = 16;
        enc = 30;
        parent = "r30";
        sub_lo = 0;
        sub_hi = 8;
        flags = ["readable", "writable"];
    }
    register SP { class = "special"; width = 16; enc = 0; flags = ["readable", "writable"]; }
    register PC { class = "special"; width = 32; enc = 0; }
    register SREG { class = "status"; width = 8; enc = 0; }
    register RAMPX { class = "ctrl"; width = 8; enc = 0; flags = ["readable", "writable", "modedep"]; }
    register RAMPY { class = "ctrl"; width = 8; enc = 0; flags = ["readable", "writable", "modedep"]; }
    register RAMPZ { class = "ctrl"; width = 8; enc = 0; flags = ["readable", "writable", "modedep"]; }
    register EIND { class = "ctrl"; width = 8; enc = 0; flags = ["readable", "writable", "modedep"]; }
    register SPL { class = "ctrl"; width = 8; enc = 0; flags = ["readable", "writable", "modedep"]; }
    register SPH { class = "ctrl"; width = 8; enc = 0; flags = ["readable", "writable", "modedep"]; }
    mnemonic nop {  }
    mnemonic mov {  }
    mnemonic movw {  }
    mnemonic ldi {  }
    mnemonic add {  }
