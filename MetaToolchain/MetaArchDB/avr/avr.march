# Generated from ArchDB/avr.dsymspec.yaml by tools/compile_archdb.py.
# Regenerate from the YAML source; see MetaArchDB/README.md.
architecture {
    schema = 1;
    target {
        arch = "avr";
        subarch = "avr5";
        addr_size = 16;
        op_size = 8;
        addr_def = 16;
        align = 2;
        byte_order = "little";
        obj_format = "ELF32";
        abi = "AVR-GCC";
        calling_conv = "avr-gcc";
        features = ["base", "enhanced", "movw", "lpm"];
    }
    feature base { desc = "classic AVR base"; }
    feature classic { desc = "classic AVR core"; }
    feature enhanced { desc = "enhanced AVR core"; }
    feature tiny { desc = "tinyAVR (reduced)"; }
    feature xmega { desc = "XMEGA"; }
    feature movw { desc = "MOVW/MULS/MULSU word ops"; }
    feature lpm { desc = "LPM load program memory"; }
    feature elpm { desc = "ELPM extended LPM"; }
    feature spm { desc = "SPM store program memory"; }
    feature break { desc = "BREAK/WDR/SLEEP"; }
    feature priv { desc = "privileged (SPM/EIND/RAMP)"; }
    register r0 { class = "gpr"; width = 8; enc = 0; flags = ["readable", "writable"]; }
    register r1 { class = "gpr"; width = 8; enc = 1; flags = ["readable", "writable"]; }
    register r2 { class = "gpr"; width = 8; enc = 2; flags = ["readable", "writable"]; }
    register r3 { class = "gpr"; width = 8; enc = 3; flags = ["readable", "writable"]; }
