    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "isr_vector"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; }
    ];
    reloc R_AVR_NONE { width = 16; expr = "S + A"; }
    reloc R_AVR_16 { width = 16; expr = "S + A"; }
    reloc R_AVR_32 { width = 32; expr = "S + A"; }
    reloc R_AVR_7_PCREL { width = 16; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_AVR_13_PCREL { width = 16; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_AVR_16_PM { width = 16; expr = "S + A"; }
    reloc R_AVR_LO8_LDI { width = 16; expr = "S + A"; }
    reloc R_AVR_HI8_LDI { width = 16; expr = "S + A"; }
    reloc R_AVR_HH8_LDI { width = 16; expr = "S + A"; }
    reloc R_AVR_CALL { width = 32; pcrel = true; expr = "S + A - P"; }
    reloc R_AVR_LDI { width = 16; expr = "S + A"; }
    reloc R_AVR_PORT6 { width = 16; expr = "S + A"; }
    reloc R_AVR_PORT5 { width = 16; expr = "S + A"; }
    debug = [
        {
            kind = "target";
            msg = "avr 8-bit base+mul+lpm/flash+interrupts stratification";
            ref = "";
        },
        { kind = "form"; msg = "flash forms require lpm/elpm/spm"; ref = "lpm"; },
