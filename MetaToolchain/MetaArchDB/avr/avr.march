    encoder nop { max_bytes = 2; body = "EMIT16LE 0x0000\n"; }
    encoder mov { max_bytes = 2; body = "EMIT16LE 0x2C00 + rd*16 + rs\n"; }
    encoder movw { max_bytes = 2; body = "EMIT16LE 0x0100 + rd*16 + rs\n"; }
    encoder ldi { max_bytes = 2; body = "EMIT16LE 0xE000 + rd*16 + (imm % 16) + ((imm / 16) % 16)*256\n"; }
    encoder add { max_bytes = 2; body = "EMIT16LE 0x0C00 + rd*16 + rs\n"; }
    encoder adc { max_bytes = 2; body = "EMIT16LE 0x1C00 + rd*16 + rs\n"; }
    encoder sub { max_bytes = 2; body = "EMIT16LE 0x1800 + rd*16 + rs\n"; }
    encoder sbc { max_bytes = 2; body = "EMIT16LE 0x0800 + rd*16 + rs\n"; }
    encoder and { max_bytes = 2; body = "EMIT16LE 0x2000 + rd*16 + rs\n"; }
    encoder or { max_bytes = 2; body = "EMIT16LE 0x2800 + rd*16 + rs\n"; }
    encoder eor { max_bytes = 2; body = "EMIT16LE 0x2400 + rd*16 + rs\n"; }
    encoder com { max_bytes = 2; body = "EMIT16LE 0x9400 + rd*16\n"; }
    encoder neg { max_bytes = 2; body = "EMIT16LE 0x9401 + rd*16\n"; }
    encoder inc { max_bytes = 2; body = "EMIT16LE 0x9403 + rd*16\n"; }
    encoder dec { max_bytes = 2; body = "EMIT16LE 0x940A + rd*16\n"; }
    encoder swap { max_bytes = 2; body = "EMIT16LE 0x9402 + rd*16\n"; }
    encoder lsl { max_bytes = 2; body = "EMIT16LE 0x0C00 + rd*16 + rd\n"; }
    encoder lsr { max_bytes = 2; body = "EMIT16LE 0x9406 + rd*16\n"; }
    encoder rol { max_bytes = 2; body = "EMIT16LE 0x1C00 + rd*16 + rd\n"; }
    encoder asr { max_bytes = 2; body = "EMIT16LE 0x9405 + rd*16\n"; }
    encoder mul { max_bytes = 2; body = "EMIT16LE 0x9C00 + rd*16 + rs\n"; }
    encoder muls { max_bytes = 2; body = "EMIT16LE 0x0200 + rd*16 + rs\n"; }
    encoder fmul { max_bytes = 2; body = "EMIT16LE 0x0300 + rd*16 + rs\n"; }
    encoder cpi { max_bytes = 2; body = "EMIT16LE 0x3000 + rd*16 + (imm % 256)\n"; }
    encoder cpc { max_bytes = 2; body = "EMIT16LE 0x0400 + rd*16 + rs\n"; }
    encoder cp { max_bytes = 2; body = "EMIT16LE 0x1400 + rd*16 + rs\n"; }
    encoder lds { max_bytes = 4; body = "EMIT16LE 0x9000 + rd*16\nEMIT16LE imm\n"; }
    encoder sts { max_bytes = 4; body = "EMIT16LE 0x9200 + rd*16\nEMIT16LE imm\n"; }
    encoder ld { max_bytes = 2; body = "EMIT16LE 0x8000 + rd*16\n"; }
    encoder st { max_bytes = 2; body = "EMIT16LE 0x8200 + rd*16\n"; }
    encoder push { max_bytes = 2; body = "EMIT16LE 0x920F + rd*16\n"; }
    encoder pop { max_bytes = 2; body = "EMIT16LE 0x900F + rd*16\n"; }
    encoder lpm { max_bytes = 2; body = "EMIT16LE 0x95C8\n"; }
    encoder elpm { max_bytes = 2; body = "EMIT16LE 0x95D8\n"; }
    encoder spm { max_bytes = 2; body = "EMIT16LE 0x95E8\n"; }
    encoder rjmp {
        max_bytes = 2;
        max_relocs = 1;
        body = "EMIT16LE 0xC000\nEMIT_RELOCATION sym, R_AVR_13_PCREL\n";
    }
    encoder rcall {
        max_bytes = 2;
        max_relocs = 1;
        body = "EMIT16LE 0xD000\nEMIT_RELOCATION sym, R_AVR_13_PCREL\n";
