// Architecture spelling -> LLVM target (little/big endian), GNU cross prefix.
// Object ABI defaults are Linux ELF, except the explicitly named bare targets.
// Additional targets can use --triple and --assembler without changing this table.
ARCHAS_TARGET("amd64",       "x86_64-pc-linux-gnu",       "",                         "x86_64-linux-gnu")
ARCHAS_TARGET("x86",         "i386-pc-linux-gnu",         "",                         "i686-linux-gnu")
ARCHAS_TARGET("aarch64",     "aarch64-linux-gnu",         "aarch64_be-linux-gnu",      "aarch64-linux-gnu")
ARCHAS_TARGET("arm32",       "armv7-linux-gnueabi",       "armebv7-linux-gnueabi",     "arm-linux-gnueabi")
ARCHAS_TARGET("riscv32",     "riscv32-linux-gnu",         "riscv32be-linux-gnu",       "riscv32-linux-gnu")
ARCHAS_TARGET("riscv64",     "riscv64-linux-gnu",         "riscv64be-linux-gnu",       "riscv64-linux-gnu")
ARCHAS_TARGET("ppc32",       "powerpcle-linux-gnu",       "powerpc-linux-gnu",         "powerpc-linux-gnu")
ARCHAS_TARGET("ppc64",       "powerpc64le-linux-gnu",     "powerpc64-linux-gnu",       "powerpc64-linux-gnu")
ARCHAS_TARGET("mips32",      "mipsel-linux-gnu",          "mips-linux-gnu",            "mips-linux-gnu")
ARCHAS_TARGET("mips64",      "mips64el-linux-gnuabi64",   "mips64-linux-gnuabi64",      "mips64-linux-gnuabi64")
ARCHAS_TARGET("s390x",       "",                         "s390x-linux-gnu",           "s390x-linux-gnu")
ARCHAS_TARGET("sparc64",     "",                         "sparcv9-linux-gnu",         "sparc64-linux-gnu")
ARCHAS_TARGET("loongarch32", "loongarch32-linux-gnu",     "",                         "loongarch32-linux-gnu")
ARCHAS_TARGET("loongarch64", "loongarch64-linux-gnu",     "",                         "loongarch64-linux-gnu")
ARCHAS_TARGET("bpf",         "bpfel",                    "bpfeb",                    "bpf")
ARCHAS_TARGET("avr",         "avr",                      "",                         "avr")
ARCHAS_TARGET("msp430",      "msp430",                   "",                         "msp430")
ARCHAS_TARGET("hexagon",     "hexagon",                  "",                         "hexagon")
ARCHAS_TARGET("lanai",       "",                         "lanai",                    "lanai")
ARCHAS_TARGET("xcore",       "xcore",                    "",                         "xcore")
ARCHAS_TARGET("m68k",        "",                         "m68k-linux-gnu",            "m68k-linux-gnu")
ARCHAS_TARGET("wasm",        "wasm32-unknown-unknown",    "",                         "")
ARCHAS_TARGET("amdgpu",      "amdgcn-amd-amdhsa",         "",                         "")
