local xbind = require("lxbind")

-- MetaBFD: the aggregate surface of MetaArch and its BFD object-format
-- catalogue.
--
-- This is the umbrella spec: it names the headers of both halves of the
-- project and binds the cross-cutting query functions a consumer needs
-- before it knows which half it wants -- the ABI version of the
-- architecture side and the enumeration spellings of the object-format
-- side.  The detailed surfaces live in the component specs:
-- MetaArch.xbind (the architecture catalogue) and ArchBFD.xbind (the
-- object-format catalogue).
--
-- Headers are relative to the MetaArch directory.  Functions that need an
-- out-parameter or a caller-owned buffer are deliberately not represented as
-- automatically marshalled calls.
return xbind.library {
  name = "metabfd",
  version = "1.0.0",
  features = { "c-signatures", "explicit-ownership" },
  headers = { "MetaArchABI.h", "ArchBFD.h", "DsymspecIR.h" },
  stdlib = { "typedef", "sexp", "json" },
  targets = {
    xbind.target("D", { module = "metabfd" }),
    xbind.target("Go", { package = "metabfd" }),
    xbind.target("Java", { package = "stone.metabfd", class = "MetaBFD" }),
    xbind.target("Lua", { module = "metabfd" }),
    xbind.target("NodeJS", { addon = "metabfd" }),
    xbind.target("OCaml", { library = "metabfd" }),
    xbind.target("Python", { module = "metabfd" }),
    xbind.target("Ruby", { extension = "metabfd" }),
    xbind.target("Rust", { crate = "metabfd_sys" }),
  },
  typedefs = {
    xbind.typedef("const char *", "string", { ownership = "borrowed" }),
    xbind.typedef("int32_t", "int", { range = "int32" }),
    xbind.typedef("int64_t", "int", { range = "int64" }),
    xbind.typedef("uint32_t", "int", { range = "uint32" }),
    xbind.typedef("uint64_t", "int", { range = "uint64" }),
    xbind.typedef("ArchBFDFormat", "int", { range = "format" }),
    xbind.typedef("ArchBFDByteOrder", "int", { range = "byte-order" }),
    xbind.typedef("ArchBFDOverflow", "int", { range = "overflow" }),
  },
  functions = {
    -- the architecture side --------------------------------------------
    xbind.func("metaarch_abi_version", {
      returns = "uint32_t",
      params = {},
    }),
    -- the object-format side -------------------------------------------
    xbind.func("archbfd_format_name", {
      returns = "const char *", ownership = "borrowed",
      params = { xbind.param("format", "ArchBFDFormat") },
    }),
    xbind.func("archbfd_byte_order_name", {
      returns = "const char *", ownership = "borrowed",
      params = { xbind.param("order", "ArchBFDByteOrder") },
    }),
    xbind.func("archbfd_overflow_name", {
      returns = "const char *", ownership = "borrowed",
      params = { xbind.param("overflow", "ArchBFDOverflow") },
    }),
  },
}
