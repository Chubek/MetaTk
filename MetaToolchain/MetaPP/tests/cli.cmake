execute_process(COMMAND "${TOOL}" -E -P -DCOMMAND=9 -DREMOVED -UREMOVED
  -o "${WORK}/cli-output.i" "${FIXTURES}/cli.c" RESULT_VARIABLE result ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "CLI failed: ${errors}")
endif()
file(READ "${WORK}/cli-output.i" output)
if(NOT output MATCHES "int answer = 9 ;")
  message(FATAL_ERROR "Unexpected CLI output: ${output}")
endif()
execute_process(COMMAND "${TOOL}" --unknown RESULT_VARIABLE result ERROR_VARIABLE errors)
if(NOT result EQUAL 2)
  message(FATAL_ERROR "Unknown option should exit 2")
endif()
execute_process(COMMAND "${TOOL}" "${FIXTURES}/cli.c" RESULT_VARIABLE result ERROR_VARIABLE errors)
if(NOT result EQUAL 1 OR NOT errors MATCHES "incorrect command line macros")
  message(FATAL_ERROR "#error should exit 1 with diagnostic: ${errors}")
endif()
