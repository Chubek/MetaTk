# Architecture declarations feed the same schema binder as YAML/JSON.
architecture {
    schema = 1;
    target { arch = toy; addr_size = 32; byte_order = little; obj_format = ELF32; }
    register r0 { class = gpr; width = 32; enc = 0; }
    register r1 { class = gpr; width = 32; enc = 1; }
    mnemonic mov { aliases = [copy]; }
    encoder mov {
        body = "REQUIRE dst >= 0 && dst < 2\nREQUIRE imm >= -128 && imm <= 127\nEMIT8 0x10 | dst\nEMIT8 imm\n";
    }
    form { mnemonic = mov; encoder = mov; operands = [
        { kind = reg; class = gpr; width = 32; },
        { kind = imm; width = 8; signed = true; imm_min = -128; imm_max = 127; }
    ]; }
    # Explicit mapping; source order need not be bytecode first-use order.
    assembly = { mov = [dst, imm]; };
}
