file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/body.mi" "fn f() { return $(VALUE); }\n")
file(WRITE "${WORK}/input.mjit" "#include <cstdint>\n@jit_begin code\n@include \"body.mi\"\n@jit_end\n")
execute_process(COMMAND "${TOOL}" -D VALUE=42 -o "${WORK}/result.cpp" "${WORK}/input.mjit"
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "CLI valid input: ${error}")
endif()
file(READ "${WORK}/result.cpp" first)
execute_process(COMMAND "${TOOL}" -D VALUE=42 "${WORK}/input.mjit"
  RESULT_VARIABLE status OUTPUT_VARIABLE second)
if(NOT status EQUAL 0 OR NOT first STREQUAL second)
  message(FATAL_ERROR "CLI stdout/file output differs")
endif()
file(WRITE "${WORK}/bad.mjit" "@jit_begin code\nfn f() { return missing; }\n@jit_end\n")
execute_process(COMMAND "${TOOL}" -o "${WORK}/result.cpp" "${WORK}/bad.mjit"
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 1 OR NOT error MATCHES "undefined variable")
  message(FATAL_ERROR "CLI failed to diagnose invalid input: ${error}")
endif()
file(READ "${WORK}/result.cpp" preserved)
if(NOT preserved STREQUAL first)
  message(FATAL_ERROR "Invalid input overwrote existing output")
endif()
execute_process(COMMAND "${TOOL}" --unknown RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(NOT status EQUAL 2)
  message(FATAL_ERROR "CLI usage error must return 2")
endif()
execute_process(COMMAND "${TOOL}" "${WORK}/missing.mjit" RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(NOT status EQUAL 1)
  message(FATAL_ERROR "CLI accepted missing input")
endif()
