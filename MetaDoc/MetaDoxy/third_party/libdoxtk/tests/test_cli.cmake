file(MAKE_DIRECTORY "${WORK}")
set(input "${WORK}/input.txt")
set(output "${WORK}/output.txt")
file(WRITE "${input}" "hello<&>\r\n")

function(run expected program)
  execute_process(COMMAND "${program}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${status}" STREQUAL "${expected}")
    message(FATAL_ERROR "${program} ${ARGN}: expected ${expected}, got ${status}; stdout=${out}; stderr=${err}")
  endif()
  set(stdout "${out}" PARENT_SCOPE)
  set(stderr "${err}" PARENT_SCOPE)
endfunction()

run(0 "${CONVERTER}" --help)
if(NOT stdout MATCHES "Usage:")
  message(FATAL_ERROR "Missing help")
endif()
run(0 "${CONVERTER}" --version)
if(NOT stdout MATCHES "DoxTk 0.1.0")
  message(FATAL_ERROR "Missing version")
endif()
run(0 "${CONVERTER}" --list-formats)
if(NOT stdout MATCHES "json-dump.*write-only")
  message(FATAL_ERROR "Capabilities are not explicit")
endif()
if(NOT stdout MATCHES "markdown.*read-only")
  message(FATAL_ERROR "Markdown was advertised as writable")
endif()
run(2 "${CONVERTER}")
run(2 "${CONVERTER}" --unknown)
run(2 "${CONVERTER}" --to)
run(2 "${CONVERTER}" --to plaintext)
run(2 "${CONVERTER}" --to plaintext "${input}" "${output}" extra)
run(2 "${JSON_TOOL}" --to plaintext "${input}")
run(1 "${CONVERTER}" --from markdown --to plaintext "${input}")
run(0 "${CONVERTER}" --from markdown --to plaintext --allow-lossy "${input}")
if(NOT stderr MATCHES "warning:.*lossy")
  message(FATAL_ERROR "Missing lossiness diagnostic")
endif()
run(1 "${CONVERTER}" --to pdf "${input}")
run(1 "${CONVERTER}" --to plaintext "${WORK}/missing.txt")
run(1 "${CONVERTER}" --to plaintext "${input}" "${WORK}/missing/output.txt")
run(0 "${CONVERTER}" --to plaintext "${input}" "${output}")
file(READ "${input}" original HEX)
file(READ "${output}" converted HEX)
if(NOT original STREQUAL converted)
  message(FATAL_ERROR "Plaintext conversion changed bytes")
endif()

run(0 "${JSON_TOOL}" "${input}")
set(expected "{\"ir\":\"Plaintext\",\"media_type\":\"text/plain\",\"encoding\":\"utf-8\",\"text\":\"hello<&>\\r\\n\",\"metadata\":{}}\n")
if(NOT stdout STREQUAL expected)
  message(FATAL_ERROR "Unexpected JSON output: ${stdout}")
endif()
run(0 "${XML_TOOL}" "${input}" "${output}")
file(READ "${output}" xml)
if(NOT xml MATCHES "<text>hello&lt;&amp;&gt;&#13;&#10;</text>")
  message(FATAL_ERROR "Unexpected XML output: ${xml}")
endif()
run(0 "${CONVERTER}" --to json-dump -- "${input}" "${output}")
string(ASCII 255 invalid)
file(WRITE "${input}" "${invalid}")
file(WRITE "${output}" "preserved")
run(1 "${CONVERTER}" --to plaintext "${input}" "${output}")
file(READ "${output}" preserved)
if(NOT preserved STREQUAL "preserved" OR NOT stderr MATCHES "parse_error")
  message(FATAL_ERROR "Invalid input was not rejected before opening output")
endif()
run(0 "${CONVERTER}" --encoding iso-8859-1 --to plaintext "${input}" "${output}")
file(READ "${output}" latin1 HEX)
if(NOT latin1 STREQUAL "c3bf")
  message(FATAL_ERROR "Latin-1 input was not transcoded")
endif()
run(1 "${CONVERTER}" --encoding ascii --to plaintext "${input}")
run(1 "${CONVERTER}" --encoding utf-16 --to plaintext "${input}")
string(ASCII 1 control)
file(WRITE "${input}" "${control}")
run(1 "${XML_TOOL}" "${input}")
run(0 "${JSON_TOOL}" "${input}")
file(WRITE "${input}" "")
run(0 "${CONVERTER}" --to plaintext "${input}" "${output}")
file(SIZE "${output}" size)
if(NOT size EQUAL 0)
  message(FATAL_ERROR "Empty input did not produce empty plaintext")
endif()
file(WRITE "${input}" "# Heading\n\n*visible*\n\n- item\n")
file(WRITE "${output}" "preserved")
run(1 "${CONVERTER}" --from markdown --to plaintext "${input}" "${output}")
file(READ "${output}" preserved)
if(NOT preserved STREQUAL "preserved")
  message(FATAL_ERROR "Refusing structural loss truncated output")
endif()
run(0 "${CONVERTER}" --from markdown --to plaintext --allow-lossy "${input}" "${output}")
file(READ "${output}" rendered)
if(NOT rendered STREQUAL "Heading\n\nvisible\n\n- item" OR NOT stderr MATCHES "warning:.*lossy")
  message(FATAL_ERROR "Markdown conversion dropped content or diagnostics")
endif()
run(0 "${CONVERTER}" --from markdown --to ir-json "${input}")
if(NOT stdout MATCHES "\"kind\":\"heading\"" OR NOT stdout MATCHES "\"text\":\"visible\"")
  message(FATAL_ERROR "Markdown JSON dump lost AST content")
endif()
run(0 "${CONVERTER}" --from markdown --to ir-xml "${input}")
if(NOT stdout MATCHES "<emphasis")
  message(FATAL_ERROR "Markdown XML dump lost structure or positions")
endif()
