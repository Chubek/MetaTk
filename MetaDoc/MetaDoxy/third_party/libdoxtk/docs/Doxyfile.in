PROJECT_NAME = DoxTk
PROJECT_NUMBER = @PROJECT_VERSION@
OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/generated"
INPUT = "@PROJECT_SOURCE_DIR@/include" "@PROJECT_SOURCE_DIR@/docs"
RECURSIVE = YES
FILE_PATTERNS = *.h *.hpp *.md
USE_MDFILE_AS_MAINPAGE = "@PROJECT_SOURCE_DIR@/docs/Frontpage.md"
GENERATE_HTML = YES
GENERATE_LATEX = NO
EXTRACT_ALL = YES
QUIET = YES
WARN_IF_UNDOCUMENTED = NO
