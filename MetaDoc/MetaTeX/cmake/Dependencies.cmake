# Dependencies are supplied by the enclosing metatk workspace, never downloaded
# by the build. Each path can be overridden for standalone source layouts.
get_filename_component(METATEX_WORKSPACE "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(METATEX_THIRD_PARTY_DIR "${METATEX_WORKSPACE}/third_party" CACHE PATH "Third-party source root")
set(METATEX_DYNALO_DIR "${METATEX_THIRD_PARTY_DIR}/dynalo" CACHE PATH "dynalo source directory")
set(METATEX_REPLXX_DIR "${METATEX_THIRD_PARTY_DIR}/replxx" CACHE PATH "replxx source directory")
set(METATEX_DSLTK_DIR "${METATEX_WORKSPACE}/DSLtk" CACHE PATH "Directory containing DSLtk.hpp")
if(EXISTS "${METATEX_WORKSPACE}/MetaML.hpp")
    set(_metaml_default "${METATEX_WORKSPACE}")
else()
    set(_metaml_default "${METATEX_WORKSPACE}/DSLtk")
endif()
set(METATEX_METAML_DIR "${_metaml_default}" CACHE PATH "Directory containing MetaML.hpp and metalib")
foreach(header IN ITEMS "${METATEX_DSLTK_DIR}/DSLtk.hpp" "${METATEX_DYNALO_DIR}/include/dynalo/dynalo.hpp" "${METATEX_REPLXX_DIR}/include/replxx.hxx" "${METATEX_METAML_DIR}/MetaML.hpp" "${METATEX_METAML_DIR}/metalib/cpp/Metalib.h")
    if(NOT EXISTS "${header}")
        message(FATAL_ERROR "Required dependency missing: ${header}; configure METATEX_*_DIR paths")
    endif()
endforeach()
add_library(metatex_dynalo INTERFACE)
target_include_directories(metatex_dynalo INTERFACE "${METATEX_DYNALO_DIR}/include")
target_link_libraries(metatex_dynalo INTERFACE ${CMAKE_DL_LIBS})
function(metatex_add_replxx)
    set(BUILD_SHARED_LIBS OFF)
    set(REPLXX_BUILD_EXAMPLES OFF CACHE BOOL "Build replxx examples")
    set(REPLXX_BUILD_PACKAGE OFF CACHE BOOL "Build replxx packages")
    add_subdirectory("${METATEX_REPLXX_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/replxx" EXCLUDE_FROM_ALL)
endfunction()
if(NOT TARGET replxx::replxx)
    metatex_add_replxx()
endif()
find_package(Threads REQUIRED)
find_package(SQLite3 REQUIRED)
if(TARGET SQLite3::SQLite3)
    set(_metatex_sqlite SQLite3::SQLite3)
else()
    set(_metatex_sqlite SQLite::SQLite3)
endif()
find_path(METATEX_NNG_INCLUDE_DIR nng/nng.h REQUIRED)
find_library(METATEX_NNG_LIBRARY nng REQUIRED)
find_path(METATEX_HTTPLIB_INCLUDE_DIR httplib.h HINTS "${METATEX_THIRD_PARTY_DIR}/cpp-httplib" REQUIRED)
add_library(metatex_metaml INTERFACE)
target_include_directories(metatex_metaml SYSTEM INTERFACE "${METATEX_METAML_DIR}" "${METATEX_NNG_INCLUDE_DIR}" "${METATEX_HTTPLIB_INCLUDE_DIR}")
target_compile_definitions(metatex_metaml INTERFACE METAML_DEFAULT_STDLIB="${METATEX_METAML_DIR}/metalib")
target_link_libraries(metatex_metaml INTERFACE ${_metatex_sqlite} ${METATEX_NNG_LIBRARY} Threads::Threads ${CMAKE_DL_LIBS})
