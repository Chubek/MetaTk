\section{Retained vector artwork}
The same scene produces inline SVG in HTML and native paths in PDF.
\metavect[width=360]{
metavect-scene 1 360 160;
stroke 0.15 0.2 0.4; fill 0.9 0.94 1; width 2;
rect 10 10 340 140;
fill 0.3 0.55 0.85; circle 90 80 42;
fill none; stroke 0.8 0.25 0.2; width 4;
path M 160 120 C 200 10 260 10 310 120;
}{A circle and a cubic Bezier curve, with an accessible caption.}
\section{Scene files}
\metavectfile[width=360]{vector.mvs}{A chart from an external MetaVect scene artifact.}
