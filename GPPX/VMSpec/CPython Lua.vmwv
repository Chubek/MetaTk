#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "cpython-lua",
  "name": "CPython stack / Lua register comparison",
  "revision": "CPython 3.11 and Lua 5.4",
  "scope": "reference-subset",
  "model": "comparison",
  "state": {
    "py_stack": "CPython operand stack",
    "py_consts": "Python constants",
    "lua_regs": "Lua register window",
    "lua_consts": "Lua constants"
  },
  "invariants": [
    "The two machines execute independently; this is not a shared bytecode ABI.",
    "Operation prefixes identify the machine whose state changes."
  ],
  "operations": [
    {
      "name": "py.LOAD_CONST",
      "operands": [
        "index"
      ],
      "effect": "Push py_consts[index] onto py_stack."
    },
    {
      "name": "py.BINARY_OP",
      "operands": [
        "operation"
      ],
      "effect": "Pop rhs and lhs; perform the indicated Python binary operation and push its result."
    },
    {
      "name": "py.RETURN_VALUE",
      "operands": [],
      "effect": "Pop and return the top Python value."
    },
    {
      "name": "lua.LOADK",
      "operands": [
        "A",
        "Bx"
      ],
      "effect": "lua_regs[A] := lua_consts[Bx]."
    },
    {
      "name": "lua.ADD",
      "operands": [
        "A",
        "B",
        "C"
      ],
      "effect": "Set lua_regs[A] to numeric addition of registers B and C; non-numeric handling requires the Lua fallback path."
    },
    {
      "name": "lua.RETURN1",
      "operands": [
        "A"
      ],
      "effect": "Return lua_regs[A] from the Lua frame."
    }
  ],
  "example": {
    "initial": "py_consts=[20,22], lua_consts=[20,22]; both frames are empty.",
    "steps": [
      {
        "op": "py.LOAD_CONST",
        "args": [
          0
        ]
      },
      {
        "op": "py.LOAD_CONST",
        "args": [
          1
        ]
      },
      {
        "op": "py.BINARY_OP",
        "args": [
          "+"
        ]
      },
      {
        "op": "py.RETURN_VALUE",
        "args": []
      },
      {
        "op": "lua.LOADK",
        "args": [
          0,
          0
        ]
      },
      {
        "op": "lua.LOADK",
        "args": [
          1,
          1
        ]
      },
      {
        "op": "lua.ADD",
        "args": [
          0,
          0,
          1
        ]
      },
      {
        "op": "lua.RETURN1",
        "args": [
          0
        ]
      }
    ],
    "expected": "Each independent frame returns 42."
  },
  "references": [
    "https://docs.python.org/3.11/library/dis.html",
    "https://www.lua.org/source/5.4/lopcodes.h.html"
  ],
  "notes": "The original combined filename is interpreted as a comparison. Python cache entries and Lua metamethod fallback instructions are omitted; examples are symbolic, not serialized bytecode."
}
#undef VMWV_VERSION
