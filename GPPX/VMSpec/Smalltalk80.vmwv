#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "smalltalk80",
  "name": "Smalltalk-80",
  "revision": "Blue Book symbolic bytecodes",
  "scope": "reference-subset",
  "model": "stack",
  "state": {
    "ip": "bytecode position",
    "stack": "object references",
    "receiver": "current receiver",
    "temps": "temporary variables",
    "literals": "method literals",
    "context": "active method or block context"
  },
  "invariants": [
    "Message sends perform class-based method lookup.",
    "Method and block return targets are distinct."
  ],
  "operations": [
    {
      "name": "pushLiteral",
      "operands": [
        "index"
      ],
      "effect": "Push literals[index]."
    },
    {
      "name": "pushTemporary",
      "operands": [
        "index"
      ],
      "effect": "Push temps[index]."
    },
    {
      "name": "storeAndPopTemporary",
      "operands": [
        "index"
      ],
      "effect": "Pop into temps[index]."
    },
    {
      "name": "pushReceiver",
      "operands": [],
      "effect": "Push the current receiver."
    },
    {
      "name": "duplicateTop",
      "operands": [],
      "effect": "Duplicate the top object reference."
    },
    {
      "name": "popStack",
      "operands": [],
      "effect": "Discard the top object reference."
    },
    {
      "name": "send",
      "operands": [
        "selector",
        "argument_count"
      ],
      "effect": "Pop arguments and receiver and invoke the selected method."
    },
    {
      "name": "returnTopFromMethod",
      "operands": [],
      "effect": "Return the top object from the enclosing method context."
    }
  ],
  "example": {
    "initial": "Method literal 0 is SmallInteger 42.",
    "steps": [
      {
        "op": "pushLiteral",
        "args": [
          0
        ]
      },
      {
        "op": "returnTopFromMethod",
        "args": []
      }
    ],
    "expected": "Method returns SmallInteger 42."
  },
  "references": [
    "Adele Goldberg and David Robson, Smalltalk-80: The Language and its Implementation, 1983, chapters 26-30."
  ],
  "notes": "Descriptive bytecode names normalize the compact and extended encodings; no image format is implied."
}
#undef VMWV_VERSION
