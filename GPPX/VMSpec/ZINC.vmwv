#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "zinc",
  "name": "ZINC abstract machine",
  "revision": "Leroy 1990, normalized closure core",
  "scope": "reference-subset",
  "model": "register",
  "state": {
    "acc": "current value",
    "env": "closure environment",
    "stack": "arguments and saved calls",
    "pc": "code position",
    "extra_args": "arguments beyond the current call"
  },
  "invariants": [
    "Function application preserves lexical environments.",
    "Partial application packages supplied arguments with code."
  ],
  "operations": [
    {
      "name": "CONST",
      "operands": [
        "value"
      ],
      "effect": "Place a constant in acc."
    },
    {
      "name": "PUSH",
      "operands": [],
      "effect": "Push acc onto the argument stack."
    },
    {
      "name": "ACCESS",
      "operands": [
        "index"
      ],
      "effect": "Fetch an environment binding into acc."
    },
    {
      "name": "CLOSURE",
      "operands": [
        "code"
      ],
      "effect": "Place a closure of code and env in acc."
    },
    {
      "name": "APPLY",
      "operands": [
        "arity"
      ],
      "effect": "Enter the closure in acc with arity supplied arguments and a saved return continuation."
    },
    {
      "name": "GRAB",
      "operands": [
        "count"
      ],
      "effect": "Consume the required arguments, or return a partial-application closure if too few are available."
    },
    {
      "name": "RETURN",
      "operands": [
        "slots"
      ],
      "effect": "Discard slots arguments and resume the saved continuation, or apply remaining extra arguments."
    }
  ],
  "example": {
    "initial": "Valid return continuation, no extra arguments.",
    "steps": [
      {
        "op": "CONST",
        "args": [
          42
        ]
      },
      {
        "op": "RETURN",
        "args": [
          0
        ]
      }
    ],
    "expected": "Caller receives 42."
  },
  "references": [
    "https://xavierleroy.org/publi/ZINC.pdf"
  ],
  "notes": "Names and operands are normalized for comparison; this is not OCaml bytecode or a binary-compatible ZINC assembler."
}
#undef VMWV_VERSION
