#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "beam",
  "name": "BEAM",
  "revision": "Erlang OTP 26 generic instructions",
  "scope": "reference-subset",
  "model": "register",
  "state": {
    "ip": "instruction pointer",
    "x": "argument and temporary registers",
    "y": "stack slots",
    "cp": "return continuation",
    "heap": "process heap",
    "mailbox": "process messages"
  },
  "invariants": [
    "Process heaps and scheduling belong to the runtime.",
    "Live registers must be known at allocation and garbage-collection points."
  ],
  "operations": [
    {
      "name": "move",
      "operands": [
        "source",
        "destination"
      ],
      "effect": "Copy an Erlang term between a literal/register source and a register destination."
    },
    {
      "name": "allocate",
      "operands": [
        "words",
        "live"
      ],
      "effect": "Save the continuation and allocate words stack slots, preserving live X registers."
    },
    {
      "name": "deallocate",
      "operands": [
        "words"
      ],
      "effect": "Release words stack slots and restore the continuation."
    },
    {
      "name": "call",
      "operands": [
        "arity",
        "label"
      ],
      "effect": "Set the return continuation and call the local label with arguments in X registers."
    },
    {
      "name": "call_only",
      "operands": [
        "arity",
        "label"
      ],
      "effect": "Tail-call the local label without adding a return continuation."
    },
    {
      "name": "return",
      "operands": [],
      "effect": "Resume at cp; X0 carries the result."
    },
    {
      "name": "send",
      "operands": [],
      "effect": "Send the message in X1 to the destination in X0; leave the message in X0."
    }
  ],
  "example": {
    "initial": "Valid caller continuation; no local stack frame.",
    "steps": [
      {
        "op": "move",
        "args": [
          42,
          "x0"
        ]
      },
      {
        "op": "return",
        "args": []
      }
    ],
    "expected": "Caller receives Erlang integer 42 in X0."
  },
  "references": [
    "https://www.erlang.org/docs/26/apps/erts/beam_makeops.html"
  ],
  "notes": "Generic loader-level operations; internal specialized instructions and binary file encoding are not described."
}
#undef VMWV_VERSION
