#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "clr",
  "name": "Common Language Infrastructure",
  "revision": "ECMA-335 sixth edition, integer subset",
  "scope": "reference-subset",
  "model": "stack",
  "state": {
    "pc": "CIL instruction position",
    "stack": "evaluation stack",
    "locals": "typed locals",
    "args": "arguments",
    "heap": "managed objects"
  },
  "invariants": [
    "CIL stack types must agree at control-flow joins.",
    "ret must match the enclosing method return type."
  ],
  "operations": [
    {
      "name": "ldc.i4",
      "operands": [
        "value"
      ],
      "effect": "Push a signed int32 constant."
    },
    {
      "name": "ldloc",
      "operands": [
        "index"
      ],
      "effect": "Push the value of local index."
    },
    {
      "name": "stloc",
      "operands": [
        "index"
      ],
      "effect": "Pop a value into local index."
    },
    {
      "name": "add",
      "operands": [],
      "effect": "Pop two numeric values and push their unchecked sum."
    },
    {
      "name": "sub",
      "operands": [],
      "effect": "Pop rhs and lhs and push unchecked lhs-rhs."
    },
    {
      "name": "dup",
      "operands": [],
      "effect": "Duplicate the top evaluation-stack value."
    },
    {
      "name": "br",
      "operands": [
        "target"
      ],
      "effect": "Transfer control to target with the current stack."
    },
    {
      "name": "ret",
      "operands": [],
      "effect": "Return the declared result, or no value for a void method."
    }
  ],
  "example": {
    "initial": "Empty evaluation stack in an int32-returning method.",
    "steps": [
      {
        "op": "ldc.i4",
        "args": [
          20
        ]
      },
      {
        "op": "ldc.i4",
        "args": [
          22
        ]
      },
      {
        "op": "add",
        "args": []
      },
      {
        "op": "ret",
        "args": []
      }
    ],
    "expected": "Caller receives int32 42."
  },
  "references": [
    "https://ecma-international.org/publications-and-standards/standards/ecma-335/"
  ],
  "notes": "Symbolic operations describe selected semantics; no binary encoding or complete runtime is specified."
}
#undef VMWV_VERSION
