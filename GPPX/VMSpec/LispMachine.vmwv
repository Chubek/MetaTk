#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "lispmachine",
  "name": "Lisp machine semantic model",
  "revision": "tagged Lisp execution, CADR-inspired",
  "scope": "reference-subset",
  "model": "stack",
  "state": {
    "stack": "tagged Lisp values",
    "environment": "lexical bindings",
    "heap": "cons cells and objects",
    "control": "call continuation"
  },
  "invariants": [
    "CAR and CDR require list-compatible operands.",
    "Object tags determine how values are interpreted."
  ],
  "operations": [
    {
      "name": "constant",
      "operands": [
        "value"
      ],
      "effect": "Push a tagged constant."
    },
    {
      "name": "cons",
      "operands": [],
      "effect": "Pop cdr then car, allocate a cons cell, and push its reference."
    },
    {
      "name": "car",
      "operands": [],
      "effect": "Pop a cons reference and push its car."
    },
    {
      "name": "cdr",
      "operands": [],
      "effect": "Pop a cons reference and push its cdr."
    },
    {
      "name": "eq",
      "operands": [],
      "effect": "Pop two values and push their identity comparison result."
    },
    {
      "name": "call",
      "operands": [
        "function",
        "arity"
      ],
      "effect": "Apply function to arity argument values with a saved continuation."
    },
    {
      "name": "return",
      "operands": [],
      "effect": "Return the top tagged value to the saved caller."
    }
  ],
  "example": {
    "initial": "Empty value stack with a valid caller continuation.",
    "steps": [
      {
        "op": "constant",
        "args": [
          42
        ]
      },
      {
        "op": "constant",
        "args": [
          "nil"
        ]
      },
      {
        "op": "cons",
        "args": []
      },
      {
        "op": "car",
        "args": []
      },
      {
        "op": "return",
        "args": []
      }
    ],
    "expected": "Caller receives tagged integer 42."
  },
  "references": [
    "https://www.bitsavers.org/pdf/mit/cadr/Weinreb_Moon-Lisp_Machine_Manual_Jan_1979.pdf"
  ],
  "notes": "Generic Lisp semantics, not CADR microcode or a hardware ISA. Instruction names and stack convention are local to this reference model."
}
#undef VMWV_VERSION
