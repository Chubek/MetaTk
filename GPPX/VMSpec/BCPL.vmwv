#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "bcpl",
  "name": "BCPL Cintcode",
  "revision": "symbolic Cintcode core",
  "scope": "reference-subset",
  "model": "register",
  "state": {
    "A": "primary accumulator",
    "B": "secondary accumulator",
    "P": "stack frame pointer",
    "G": "global vector pointer",
    "PC": "code pointer",
    "W": "word-addressed memory"
  },
  "invariants": [
    "Words represent both addresses and values.",
    "Frame and global accesses must refer to allocated memory."
  ],
  "operations": [
    {
      "name": "L",
      "operands": [
        "constant"
      ],
      "effect": "B := A; A := constant."
    },
    {
      "name": "LP",
      "operands": [
        "offset"
      ],
      "effect": "B := A; A := W[P+offset]."
    },
    {
      "name": "SP",
      "operands": [
        "offset"
      ],
      "effect": "W[P+offset] := A."
    },
    {
      "name": "LG",
      "operands": [
        "index"
      ],
      "effect": "B := A; A := W[G+index]."
    },
    {
      "name": "SG",
      "operands": [
        "index"
      ],
      "effect": "W[G+index] := A."
    },
    {
      "name": "ADD",
      "operands": [],
      "effect": "A := B + A using the implementation word arithmetic."
    },
    {
      "name": "SUB",
      "operands": [],
      "effect": "A := B - A using the implementation word arithmetic."
    },
    {
      "name": "J",
      "operands": [
        "label"
      ],
      "effect": "PC := label."
    }
  ],
  "example": {
    "initial": "A=0, B=0; stop after the listed fragment.",
    "steps": [
      {
        "op": "L",
        "args": [
          20
        ]
      },
      {
        "op": "L",
        "args": [
          22
        ]
      },
      {
        "op": "ADD",
        "args": []
      }
    ],
    "expected": "A=42."
  },
  "references": [
    "https://www.cl.cam.ac.uk/~mr10/BCPL.html"
  ],
  "notes": "BCPL is a language; this entry selects its Cintcode execution model. Compact opcode variants, syscalls and word width are not fixed here."
}
#undef VMWV_VERSION
