#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "jvm",
  "name": "Java Virtual Machine",
  "revision": "Java SE 8 integer subset",
  "scope": "reference-subset",
  "model": "stack",
  "state": {
    "pc": "bytecode position",
    "stack": "typed operands",
    "locals": "local variable array",
    "heap": "objects",
    "frames": "method activations"
  },
  "invariants": [
    "Operand types must satisfy bytecode verification.",
    "Integer arithmetic wraps to signed 32 bits."
  ],
  "operations": [
    {
      "name": "bipush",
      "operands": [
        "byte"
      ],
      "effect": "Sign-extend a signed 8-bit operand and push it as int."
    },
    {
      "name": "iload",
      "operands": [
        "index"
      ],
      "effect": "Push int locals[index]."
    },
    {
      "name": "istore",
      "operands": [
        "index"
      ],
      "effect": "Pop an int into locals[index]."
    },
    {
      "name": "iadd",
      "operands": [],
      "effect": "Pop rhs and lhs; push their sum modulo 2^32."
    },
    {
      "name": "isub",
      "operands": [],
      "effect": "Pop rhs and lhs; push lhs-rhs modulo 2^32."
    },
    {
      "name": "dup",
      "operands": [],
      "effect": "Duplicate a category-1 stack value."
    },
    {
      "name": "goto",
      "operands": [
        "offset"
      ],
      "effect": "Branch relative to the address of this opcode."
    },
    {
      "name": "ireturn",
      "operands": [],
      "effect": "Return the top int to the caller."
    }
  ],
  "example": {
    "initial": "Empty stack in a method returning int.",
    "steps": [
      {
        "op": "bipush",
        "args": [
          20
        ]
      },
      {
        "op": "bipush",
        "args": [
          22
        ]
      },
      {
        "op": "iadd",
        "args": []
      },
      {
        "op": "ireturn",
        "args": []
      }
    ],
    "expected": "Caller receives int 42."
  },
  "references": [
    "https://docs.oracle.com/javase/specs/jvms/se8/html/jvms-6.html"
  ],
  "notes": "Symbolic operations describe selected semantics; no binary encoding or complete runtime is specified."
}
#undef VMWV_VERSION
