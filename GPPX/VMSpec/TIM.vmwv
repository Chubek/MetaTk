#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "tim",
  "name": "Three Instruction Machine",
  "revision": "Peyton Jones and Lester, Mark 1",
  "scope": "reference-subset",
  "model": "closure",
  "state": {
    "code": "instruction sequence",
    "frame": "current frame pointer",
    "stack": "argument closures",
    "heap": "frames",
    "globals": "named code blocks"
  },
  "invariants": [
    "A closure consists of code and a frame pointer.",
    "Take requires enough pending arguments."
  ],
  "operations": [
    {
      "name": "Take",
      "operands": [
        "count"
      ],
      "effect": "Allocate a frame containing count closures popped from the argument stack; make it current."
    },
    {
      "name": "Push",
      "operands": [
        "mode"
      ],
      "effect": "Resolve an addressing mode to a closure and push it on the argument stack."
    },
    {
      "name": "Enter",
      "operands": [
        "mode"
      ],
      "effect": "Resolve an addressing mode to a closure and replace code and frame with its components."
    }
  ],
  "example": {
    "initial": "stack=[closure([],f_answer)], globals unused.",
    "steps": [
      {
        "op": "Take",
        "args": [
          1
        ]
      },
      {
        "op": "Enter",
        "args": [
          "Arg 1"
        ]
      }
    ],
    "expected": "code=[], frame=f_answer; identity has entered its argument closure."
  },
  "references": [
    "https://www.microsoft.com/en-us/research/publication/implementing-functional-languages-a-tutorial/"
  ],
  "notes": "Arg indices are one-based. Mark 1 is a closure machine without the update machinery added in later variants."
}
#undef VMWV_VERSION
