#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "v8",
  "name": "V8 Ignition",
  "revision": "symbolic Ignition accumulator subset",
  "scope": "reference-subset",
  "model": "register",
  "state": {
    "pc": "bytecode position",
    "acc": "implicit accumulator",
    "registers": "frame register slots",
    "context": "lexical environment",
    "feedback": "runtime feedback vector"
  },
  "invariants": [
    "JavaScript values are tagged.",
    "Arithmetic includes language coercions and may throw."
  ],
  "operations": [
    {
      "name": "LdaSmi",
      "operands": [
        "immediate"
      ],
      "effect": "Place a small integer immediate in acc."
    },
    {
      "name": "Ldar",
      "operands": [
        "register"
      ],
      "effect": "Copy the named register into acc."
    },
    {
      "name": "Star",
      "operands": [
        "register"
      ],
      "effect": "Copy acc into the named register."
    },
    {
      "name": "Add",
      "operands": [
        "register",
        "feedback_slot"
      ],
      "effect": "Compute register + acc with JavaScript addition and record feedback."
    },
    {
      "name": "Sub",
      "operands": [
        "register",
        "feedback_slot"
      ],
      "effect": "Compute register - acc and record feedback."
    },
    {
      "name": "Jump",
      "operands": [
        "offset"
      ],
      "effect": "Jump by the encoded relative byte offset."
    },
    {
      "name": "Return",
      "operands": [],
      "effect": "Return acc from the current function."
    }
  ],
  "example": {
    "initial": "Registers and feedback slot 0 are available.",
    "steps": [
      {
        "op": "LdaSmi",
        "args": [
          20
        ]
      },
      {
        "op": "Star",
        "args": [
          "r0"
        ]
      },
      {
        "op": "LdaSmi",
        "args": [
          22
        ]
      },
      {
        "op": "Add",
        "args": [
          "r0",
          0
        ]
      },
      {
        "op": "Return",
        "args": []
      }
    ],
    "expected": "JavaScript Number 42 is returned."
  },
  "references": [
    "https://v8.dev/docs/ignition"
  ],
  "notes": "Ignition is one execution tier in V8. This symbolic subset fixes no release-specific opcode numbers, operand widths or feedback layout."
}
#undef VMWV_VERSION
