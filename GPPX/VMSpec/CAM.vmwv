#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "cam",
  "name": "Categorical Abstract Machine",
  "revision": "categorical closure model",
  "scope": "reference-subset",
  "model": "transition",
  "state": {
    "term": "current value or environment",
    "code": "remaining instructions",
    "stack": "saved terms"
  },
  "invariants": [
    "Pairs preserve left/right component order.",
    "Closures pair code with the captured environment."
  ],
  "operations": [
    {
      "name": "quote",
      "operands": [
        "value"
      ],
      "effect": "Replace term by value."
    },
    {
      "name": "car",
      "operands": [],
      "effect": "Replace pair(a,b) by a."
    },
    {
      "name": "cdr",
      "operands": [],
      "effect": "Replace pair(a,b) by b."
    },
    {
      "name": "push",
      "operands": [],
      "effect": "Push the current term on stack."
    },
    {
      "name": "swap",
      "operands": [],
      "effect": "Exchange the term with the top saved term."
    },
    {
      "name": "cons",
      "operands": [],
      "effect": "Pop saved a and replace term b by pair(a,b)."
    },
    {
      "name": "cur",
      "operands": [
        "body"
      ],
      "effect": "Replace environment e by closure(body,e)."
    },
    {
      "name": "app",
      "operands": [],
      "effect": "For term=pair(closure(body,e),arg), set term=pair(e,arg) and prefix body to code."
    }
  ],
  "example": {
    "initial": "term=unit, stack=[].",
    "steps": [
      {
        "op": "quote",
        "args": [
          20
        ]
      },
      {
        "op": "push",
        "args": []
      },
      {
        "op": "quote",
        "args": [
          42
        ]
      },
      {
        "op": "cons",
        "args": []
      },
      {
        "op": "cdr",
        "args": []
      }
    ],
    "expected": "term=42."
  },
  "references": [
    "https://www.classes.cs.uchicago.edu/archive/2010/fall/22100-1/papers/BRICS-RS-03-13.pdf"
  ],
  "notes": "Symbolic operations describe selected semantics; no binary encoding or complete runtime is specified."
}
#undef VMWV_VERSION
