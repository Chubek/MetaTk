#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "luavm",
  "name": "Lua virtual machine",
  "revision": "Lua 5.4 numeric subset",
  "scope": "reference-subset",
  "model": "register",
  "state": {
    "pc": "instruction position",
    "R": "frame register window",
    "K": "constant table",
    "top": "dynamic frame top",
    "upvalues": "captured variables"
  },
  "invariants": [
    "Registers contain tagged Lua values.",
    "Numeric ADD is shown without its paired metamethod fallback instruction."
  ],
  "operations": [
    {
      "name": "MOVE",
      "operands": [
        "A",
        "B"
      ],
      "effect": "R[A] := R[B]."
    },
    {
      "name": "LOADI",
      "operands": [
        "A",
        "sBx"
      ],
      "effect": "R[A] := signed integer immediate sBx."
    },
    {
      "name": "LOADK",
      "operands": [
        "A",
        "Bx"
      ],
      "effect": "R[A] := K[Bx]."
    },
    {
      "name": "ADD",
      "operands": [
        "A",
        "B",
        "C"
      ],
      "effect": "For numeric operands set R[A] := R[B]+R[C]; otherwise use the runtime fallback path."
    },
    {
      "name": "SUB",
      "operands": [
        "A",
        "B",
        "C"
      ],
      "effect": "For numeric operands set R[A] := R[B]-R[C]; otherwise use the runtime fallback path."
    },
    {
      "name": "JMP",
      "operands": [
        "sJ"
      ],
      "effect": "Advance pc by signed sJ relative to the following instruction."
    },
    {
      "name": "RETURN1",
      "operands": [
        "A"
      ],
      "effect": "Return the one value R[A]."
    },
    {
      "name": "RETURN0",
      "operands": [],
      "effect": "Return no values."
    }
  ],
  "example": {
    "initial": "Three available registers; integer operands.",
    "steps": [
      {
        "op": "LOADI",
        "args": [
          0,
          20
        ]
      },
      {
        "op": "LOADI",
        "args": [
          1,
          22
        ]
      },
      {
        "op": "ADD",
        "args": [
          2,
          0,
          1
        ]
      },
      {
        "op": "RETURN1",
        "args": [
          2
        ]
      }
    ],
    "expected": "Caller receives integer 42."
  },
  "references": [
    "https://www.lua.org/source/5.4/lopcodes.h.html"
  ],
  "notes": "Symbolic operations describe selected semantics; no binary encoding or complete runtime is specified."
}
#undef VMWV_VERSION
