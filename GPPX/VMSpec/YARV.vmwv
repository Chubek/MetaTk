#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "yarv",
  "name": "Ruby YARV",
  "revision": "Ruby 3.3.0",
  "scope": "reference-subset",
  "model": "stack",
  "state": {
    "pc": "instruction sequence position",
    "stack": "Ruby VALUE operands",
    "frame": "locals and control frame",
    "heap": "Ruby objects"
  },
  "invariants": [
    "Method dispatch uses Ruby method lookup.",
    "Operands are tagged Ruby values, not unboxed machine integers."
  ],
  "operations": [
    {
      "name": "putobject",
      "operands": [
        "value"
      ],
      "effect": "Push a literal Ruby object."
    },
    {
      "name": "dup",
      "operands": [],
      "effect": "Duplicate the top operand."
    },
    {
      "name": "pop",
      "operands": [],
      "effect": "Discard the top operand."
    },
    {
      "name": "swap",
      "operands": [],
      "effect": "Exchange the top two operands."
    },
    {
      "name": "newarray",
      "operands": [
        "count"
      ],
      "effect": "Pop count values in source order and push their array."
    },
    {
      "name": "branchif",
      "operands": [
        "label"
      ],
      "effect": "Pop a value; branch unless it is false or nil."
    },
    {
      "name": "branchunless",
      "operands": [
        "label"
      ],
      "effect": "Pop a value; branch when it is false or nil."
    },
    {
      "name": "leave",
      "operands": [],
      "effect": "Return the top operand from the current frame."
    }
  ],
  "example": {
    "initial": "Empty operand stack.",
    "steps": [
      {
        "op": "putobject",
        "args": [
          42
        ]
      },
      {
        "op": "leave",
        "args": []
      }
    ],
    "expected": "Current frame returns Integer 42."
  },
  "references": [
    "https://github.com/ruby/ruby/blob/v3_3_0/insns.def"
  ],
  "notes": "Symbolic operations describe selected semantics; no binary encoding or complete runtime is specified."
}
#undef VMWV_VERSION
