#define VMWV_VERSION 1
{
  "format": "gppx-vmwv",
  "version": VMWV_VERSION,
  "id": "wam",
  "name": "Warren Abstract Machine",
  "revision": "symbolic Prolog core",
  "scope": "reference-subset",
  "model": "logic",
  "state": {
    "P": "instruction pointer",
    "CP": "continuation",
    "H": "heap top",
    "E": "environment",
    "B": "choice point",
    "TR": "trail top",
    "X": "temporary registers",
    "A": "argument registers"
  },
  "invariants": [
    "Backtracking restores heap, trail and saved registers.",
    "Binding older variables must be trailed when a choice point may need them restored."
  ],
  "operations": [
    {
      "name": "put_variable",
      "operands": [
        "Xn",
        "Ai"
      ],
      "effect": "Allocate an unbound heap variable and copy its reference into Xn and Ai."
    },
    {
      "name": "put_structure",
      "operands": [
        "functor",
        "Ai"
      ],
      "effect": "Allocate a structure header for functor and put its reference in Ai."
    },
    {
      "name": "set_variable",
      "operands": [
        "Xn"
      ],
      "effect": "Append a fresh variable argument to the new structure and retain it in Xn."
    },
    {
      "name": "set_value",
      "operands": [
        "Xn"
      ],
      "effect": "Append the term reference in Xn as the next structure argument."
    },
    {
      "name": "get_constant",
      "operands": [
        "constant",
        "Ai"
      ],
      "effect": "Unify constant with Ai; bind an unbound variable or fail on mismatch."
    },
    {
      "name": "call",
      "operands": [
        "predicate"
      ],
      "effect": "Save the following instruction in CP and enter predicate."
    },
    {
      "name": "proceed",
      "operands": [],
      "effect": "Resume at CP."
    },
    {
      "name": "try_me_else",
      "operands": [
        "label"
      ],
      "effect": "Save a choice point whose alternative begins at label."
    }
  ],
  "example": {
    "initial": "A1 is an unbound variable and CP is a valid caller continuation.",
    "steps": [
      {
        "op": "get_constant",
        "args": [
          "answer",
          "A1"
        ]
      },
      {
        "op": "proceed",
        "args": []
      }
    ],
    "expected": "The caller resumes with A1 bound to atom answer."
  },
  "references": [
    "https://www.softwarepreservation.org/projects/prolog/argonne/doc/Gabriel_et_al-Tutorial%20on%20the%20Warren%20abstract%20machine%20for%20computational%20logic-1985.pdf"
  ],
  "notes": "Functor operands include arity (for example pair/2). Indexing, cuts and full read/write unification sequences are outside this subset."
}
#undef VMWV_VERSION
