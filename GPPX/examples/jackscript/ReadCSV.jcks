#!/usr/bin/env jsc
#define READER "std.Reader"
#define STRING "std.String"
#ifndef INPUT
#define INPUT "input.csv"
#endif
#define FIELD(row, column) String:Split(row, ",")[column]

// GPPX expands only explicit $(...) forms in the jackscript profile.
const Reader := G:LoadLib($(READER));
const String := G:LoadLib($(STRING));
const file := Reader:Open($(INPUT));
const firstLine := Reader:ReadLine(file);
const firstField := $(FIELD(firstLine, 0));
Reader:Close(file);
