" GPPX default, percent, and template profiles. Installed as syntax/gppx.vim.
if exists('b:current_syntax')
  finish
endif
syn case match
syn sync fromstart
syn keyword gppxTodo TODO FIXME XXX contained
syn match gppxLineComment +//.*$+ contains=gppxTodo
syn region gppxBlockComment start=+/\*+ end=+\*/+ contains=gppxTodo
syn region gppxString start=+"+ skip=+\\.+ end=+"+
syn region gppxCharacter start=+'+ skip=+\\.+ end=+'+
syn match gppxNumber '\<\d\+\>'
syn match gppxNumber '\<0[xX][0-9a-fA-F]\+\>'
syn match gppxMacro '\$(\h\w*\%(([^)]*)\)\?)'
syn region gppxTemplateMacro start='{{' end='}}' oneline
syn match gppxDirective '^\s*[#%@]\s*\h\w*' contains=gppxDirectiveName
syn keyword gppxDirectiveName define undef macro endmacro push_macro pop_macro if ifdef ifndef elif else endif ifmatch elifmatch include include_once import embed repeat endrepeat for endfor emit eval raw endraw rewrite clear_rewrites syntax plugin pragma line region endregion sink assert error warning contained
" Raw blocks are verbatim, including strings, macros and directive-like text.
syn region gppxRaw matchgroup=gppxDirective start='^\s*#\s*raw\>' end='^\s*#\s*endraw\>' keepend
syn region gppxRaw matchgroup=gppxDirective start='^\s*%\s*raw\>' end='^\s*%\s*endraw\>' keepend
syn region gppxRaw matchgroup=gppxDirective start='^\s*@\s*raw\>' end='^\s*@\s*endraw\>' keepend
hi def link gppxDirective PreProc
hi def link gppxDirectiveName PreProc
hi def link gppxMacro Identifier
hi def link gppxTemplateMacro Identifier
hi def link gppxString String
hi def link gppxCharacter Character
hi def link gppxNumber Number
hi def link gppxLineComment Comment
hi def link gppxBlockComment Comment
hi def link gppxTodo Todo
hi def link gppxRaw String
let b:current_syntax = 'gppx'
