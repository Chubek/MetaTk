-- Shared language and portable-library regression assertions.
assert name condition := if condition then () else Core.error(name)
assert "checked add" (Int.checked_add Int.max_value 1 == None)
assert "checked sub" (Int.checked_sub Int.min_value 1 == None)
assert "checked mul" (Int.checked_mul Int.min_value (~1) == None)
assert "checked mul min" (Int.checked_mul Int.min_value 1 == Some Int.min_value)
assert "checked zero" (Int.checked_mul Int.min_value 0 == Some 0)
assert "checked ordinary" (Int.checked_add 2 3 == Some 5 && Int.checked_sub 2 3 == Some (~1) && Int.checked_mul (~2) 3 == Some (~6))
assert "checked extremes" (Int.checked_add Int.min_value Int.max_value == Some (~1) && Int.checked_sub Int.max_value Int.min_value == None && Int.checked_sub Int.min_value Int.max_value == None)
assert "checked negative overflow" (Int.checked_add Int.min_value (~1) == None && Int.checked_sub Int.max_value (~1) == None)
assert "checked product signs" (Int.checked_mul Int.min_value Int.min_value == None && Int.checked_mul Int.max_value Int.max_value == None && Int.checked_mul (~3) (~4) == Some 12)
assert "checked half boundary" (Int.checked_mul (~4611686018427387904) 2 == Some Int.min_value && Int.checked_mul 4611686018427387904 2 == None)
assert "finite" (Float.is_finite 1.0 && not (Float.is_finite Float.nan) && Float.is_infinite Float.infinity)
assert "strict numeric strings" (Int.from_string "1_" == None && Float.from_string "_" == None && Float.from_string "" == None)
assert "split_at" (List.split_at 2 [1, 2, 3] == ([1, 2], [3]))
assert "negative split" (List.split_at (~1) [1] == ([], [1]))
assert "span" (List.span (< 3) [1, 2, 3, 1] == ([1, 2], [3, 1]))
assert "take/drop while" (List.take_while (< 2) [1, 2] == [1] && List.drop_while (< 2) [1, 2] == [2])
assert "zip_with" (List.zip_with (+) [1, 2] [10] == [11])
assert "scan" (List.scan (+) 0 [1, 2, 3] == [0, 1, 3, 6])
assert "scan empty" (List.scan (+) 0 [] == [0])
assert "find_index" (List.find_index (> 2) [1, 3, 4] == Some 1)
assert "option sequence" (Option.sequence [Some 1, Some 2] == Some [1, 2])
assert "option none" (Option.sequence [Some 1, None] == None)
assert "option empty" (Option.sequence [] == Some [])
assert "option flatten" (Option.flatten (Some (Some 1)) == Some 1)
assert "option to result" (Option.to_result "missing" None == Err "missing")
assert "result sequence" (Result.sequence [Ok 1, Ok 2] == Ok [1, 2])
assert "result first error" (Result.sequence [Ok 1, Err "first", Err "second"] == Err "first")
assert "result empty" (Result.sequence [] == Ok [])
assert "result flatten" (Result.flatten (Ok (Ok 1)) == Ok 1)
assert "result map2" (Result.map2 (+) (Ok 2) (Ok 3) == Ok 5)
assert "short circuit option" (Option.traverse (fn x -> if x == 0 then None else if x == 9 then Core.error("must not run") else Some x) [1, 0, 9] == None)
assert "short circuit result" (Result.traverse (fn x -> if x == 0 then Err "zero" else if x == 9 then Core.error("must not run") else Ok x) [1, 0, 9] == Err "zero")
print "extensions passed"
