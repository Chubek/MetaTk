module Parser := struct
  val string := Parsec.string($1)
  val char := Parsec.char($1)
  val any := Parsec.any($1)
  val satisfy := Parsec.satisfy($1)
  val one_of := Parsec.one_of($1)
  val seq := Parsec.seq($1, $2)
  val left := Parsec.left($1, $2)
  val right := Parsec.right($1, $2)
  val between := Parsec.between($1, $2, $3)
  val alt := Parsec.alt($1, $2)
  val choice := Parsec.choice($1)
  val many := Parsec.many($1)
  val many1 := Parsec.many1($1)
  val sep_by := Parsec.sep_by($1, $2)
  val map := Parsec.map($1, $2)
  val bind := Parsec.bind($1, $2)
  val pure := Parsec.pure($1)
  val fail := Parsec.fail($1)
  val optional := Parsec.optional($1)
  val lazy := Parsec.lazy($1)
  val label := Parsec.label($1, $2)
  val regex := Parsec.regex($1)
  val token := Parsec.token($1)
  val spaces := Parsec.spaces($1)
  val eof := Parsec.eof($1)
  val run := Parsec.run($1, $2)
  val run_prefix := Parsec.run_prefix($1, $2)
end
