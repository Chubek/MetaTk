module Memory := struct
  val create := Buffer.create($1)
  val of_string := Buffer.of_string($1)
  val contents := Buffer.contents($1)
  val length := Buffer.length($1)
  val append := Buffer.add($1, $2)
  val byte_at := Buffer.byte_at($1, $2)
  val slice := Buffer.sub($1, $2, $3)
  val truncate := Buffer.truncate($1, $2)
  val clear := Buffer.clear($1)
end
