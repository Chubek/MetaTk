% ---------------------------------------------------------------------------
% 7. TikZ styles for the diagrams used throughout the book
% ---------------------------------------------------------------------------

\tikzset{
  dslnode/.style={
    draw=nodefg, fill=nodebg, rounded corners=2pt,
    minimum height=7mm, minimum width=20mm,
    font=\small\sffamily, align=center, inner sep=4pt
  },
  dslbox/.style={
    draw=nodefg, fill=nodebg, rounded corners=2pt,
    minimum height=6mm, text width=28mm,
    font=\small\sffamily, align=center, inner sep=4pt
  },
  dsllarge/.style={
    draw=nodefg, fill=nodebg, rounded corners=2pt,
    minimum height=9mm, text width=34mm,
    font=\small\sffamily, align=center, inner sep=5pt
  },
  dslsmall/.style={
    draw=nodefg, fill=nodebg, rounded corners=2pt,
    minimum height=5mm, text width=18mm,
    font=\scriptsize\sffamily, align=center, inner sep=3pt
  },
  dsldecision/.style={
    draw=nodefg, fill=decisionbg, diamond, aspect=2.2,
    font=\small\sffamily, align=center, inner sep=2pt
  },
  dslterm/.style={
    draw=nodefg, fill=termbg, ellipse,
    font=\small\sffamily, align=center, inner sep=3pt
  },
  dsledge/.style={
    -{Latex[length=2.2mm]}, draw=edgefg, thick
  },
  dslledge/.style={dsledge},
  dsledgedash/.style={
    -{Latex[length=2mm]}, draw=edgefg, thick, dashed
  },
  dslfeedback/.style={
    -{Latex[length=2mm]}, draw=edgefg, thick, dotted
  },
  dslgroupr/.style={
    draw=groupfg, fill=groupbg, rounded corners=3pt, inner sep=6pt
  },
  dslgkey/.style={
    draw=nodefg, fill=decisionbg, circle, inner sep=1.5pt,
    font=\scriptsize\bfseries\sffamily
  }
}

% \dslgraph{...} -- a centred, breakable TikZ figure with a caption
\newenvironment{dslgraph}[1][]{%
  \begin{center}
  \begin{adjustbox}{max width=\linewidth}
  \begin{tikzpicture}[>=stealth, node distance=7mm, every node/.style={transform shape}]
}{%
  \end{tikzpicture}
  \end{adjustbox}
  \end{center}
}

% ---------------------------------------------------------------------------
% 8. Table helpers
% ---------------------------------------------------------------------------

% Column type for narrow centred entries used in wide comparison tables
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}

% ---------------------------------------------------------------------------
% 9. Symbols used by the mathematics in the text
