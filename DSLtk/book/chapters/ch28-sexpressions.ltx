\texttt{\textbackslash r} & carriage return inside a quoted atom \\
\texttt{\textbackslash t} & tab inside a quoted atom \\
\texttt{\textbackslash\textbackslash} & a literal backslash inside a quoted atom \\
\texttt{\textbackslash"} & a literal double quote inside a quoted atom \\
anything else & an ordinary byte of a bare atom \\
