  \node[dslbox, text width=26mm, font=\footnotesize\sffamily] (r0) at (0,0) {Result<int,E>};
  \node[dslsmall, text width=25mm, font=\footnotesize\sffamily] (f) at (2.7,0) {f : int to\\Result<string,E>};
  \node[dslbox, text width=26mm, font=\footnotesize\sffamily] (r1) at (5.4,0) {Result<string,\\E>};
  \node[dslsmall, text width=25mm, font=\footnotesize\sffamily] (g) at (8.1,0) {g : string to\\Result<int,E>};
  \node[dslbox, text width=26mm, font=\footnotesize\sffamily] (r2) at (10.8,0) {Result<int,E>};

  \draw[dsledge] (r0) -- (f);
  \draw[dsledge] (f) -- (r1);
  \draw[dsledge] (r1) -- (g);
  \draw[dsledge] (g) -- (r2);

  \node[dslsmall, text width=34mm] (err) at (5.2,-2.4)
    {the error payload E is carried\\unchanged to the end of the chain};
  \draw[dslfeedback] (r0.south) -- (0,-2.4) -- (err.west);
  \draw[dslfeedback] (err.east) -- (10.4,-2.4) -- (r2.south);
\end{dslgraph}
\caption{A chain of chained steps. A successful value passes through every
step; an error bypasses all of them and arrives at the end unchanged, with
