\chapter{Rewrite Sets and Fixpoint Optimization}
\label{ch:rewrite-sets}

\section{One rule is not a rewriting system}

A single rule, as \chapref{ch:rewrite} described, is a transformation
applied at one place in a tree. A \emph{rewriting system} is something
else: a collection of rules applied repeatedly until the tree stops
changing. The difference matters for two reasons.

First, a transformation that appears local is rarely local. Eliminating a
double negation may expose a constant expression; folding a constant
expression may expose a redundant multiplication; removing a redundant
multiplication may make an enclosing rule applicable that was not
applicable before. None of these rules needs to know about the others,
but the \emph{composition} needs to be iterated.

Second, the interesting question about a rewriting system is not what it
does to one node but what it does to a whole tree, repeatedly, until
nothing more can be done. That is a fixpoint computation, and it has its
own failure modes: it may not terminate, and it may terminate at a point
the user did not expect.

\DSLtk{} implements the fixpoint loop in \api{RewriteSet}, declared at
line 6821 of \texttt{DSLtk.hpp}. The class is small --- one public data
member for the rules, one public data member for the iteration budget, one
constructor, one public method, and one private helper --- and it is the
only part of the toolkit that imposes an order on the user's rules.

\section{A worked example}

The program below normalises a small boolean expression and reports how
many passes the fixpoint loop needed. It then demonstrates three
properties of the engine: that every matching rule fires within a single
pass, that a rule can create a redex that only an \emph{earlier} rule can
match, and that the iteration budget is exhausted silently.

\begin{lstlisting}[style=dslcpp,caption={Boolean normalisation with a rewrite set, and three demonstrations of the engine's behaviour.},label={lst:rewriteset-demo}]
#include "DSLtk.hpp"
#include <iostream>
#include <string>
#include <string_view>

using dsl::ASTNode;

bool
tag_is (ASTNode const &n, std::string_view t)
{
  return !n.is_leaf () && n.tag () == t;
}

bool
is_lit (ASTNode const &n, std::string_view t)
{
  return n.is_leaf () && n.tag () == "lit" && n.value () == t;
}

// A rule that never fires, but counts how many times the root is examined.
// The root is examined exactly once per pass, so this is a pass counter.
int passes = 0;
auto count_passes
    = dsl::rule<"count-passes"> (
        [] (ASTNode const &n) {
          if (n.tag () == "expr")
            ++passes;
          return false;
        },
        [] (ASTNode const &n) { return n; });

// not(true) -> false ; not(false) -> true
auto not_literal
    = dsl::rule<"not-literal"> (
        [] (ASTNode const &n) {
          return tag_is (n, "not") && n.size () == 1 && n.child (0).is_leaf ()
                 && n.child (0).tag () == "lit"
                 && (n.child (0).value () == "true" || n.child (0).value () == "false");
        },
        [] (ASTNode const &n) {
          return dsl::leaf<"lit"> (n.child (0).value () == "true" ? "false" : "true");
        });

// and(x, true) -> x ; and(true, x) -> x
auto and_true
    = dsl::rule<"and-true"> (
        [] (ASTNode const &n) {
          return tag_is (n, "and") && n.size () == 2
                 && (is_lit (n.child (0), "true") || is_lit (n.child (1), "true"));
        },
        [] (ASTNode const &n) {
          return is_lit (n.child (0), "true") ? n.child (1) : n.child (0);
        });

// and(x, false) -> false ; and(false, x) -> false
auto and_false
    = dsl::rule<"and-false"> (
        [] (ASTNode const &n) {
          return tag_is (n, "and") && n.size () == 2
                 && (is_lit (n.child (0), "false") || is_lit (n.child (1), "false"));
        },
        [] (ASTNode const &) { return dsl::leaf<"lit"> ("false"); });

// or(x, false) -> x ; or(false, x) -> x
auto or_false
    = dsl::rule<"or-false"> (
        [] (ASTNode const &n) {
          return tag_is (n, "or") && n.size () == 2
                 && (is_lit (n.child (0), "false") || is_lit (n.child (1), "false"));
        },
        [] (ASTNode const &n) {
          return is_lit (n.child (0), "false") ? n.child (1) : n.child (0);
        });

// or(x, true) -> true ; or(true, x) -> true
auto or_true
    = dsl::rule<"or-true"> (
        [] (ASTNode const &n) {
          return tag_is (n, "or") && n.size () == 2
                 && (is_lit (n.child (0), "true") || is_lit (n.child (1), "true"));
        },
        [] (ASTNode const &) { return dsl::leaf<"lit"> ("true"); });

// not(not(x)) -> x
auto double_not
    = dsl::rule<"double-not"> (
        [] (ASTNode const &n) {
          return tag_is (n, "not") && n.size () == 1 && tag_is (n.child (0), "not")
                 && n.child (0).size () == 1;
        },
        [] (ASTNode const &n) { return n.child (0).child (0); });

int
main ()
{
  auto rules = dsl::rewrite_set (count_passes, not_literal, and_true, and_false,
                                 or_false, or_true, double_not);

  ASTNode tree = dsl::node<"expr"> (
      dsl::node<"and"> (dsl::node<"or"> (dsl::leaf<"lit"> ("true"),
                                         dsl::leaf<"lit"> ("false")),
                        dsl::node<"not"> (dsl::leaf<"lit"> ("false"))));

  std::cout << "before : " << tree.dump () << '\n';
  ASTNode after = rules.apply (tree);
  std::cout << "after  : " << after.dump () << '\n';
  std::cout << "passes : " << passes << '\n';

  // Every matching rule fires in the same pass: "a" -> "b" -> "c".
  auto a_to_b = dsl::rule<"a-to-b"> (
      [] (ASTNode const &n) { return n.tag () == "a"; },
      [] (ASTNode const &) { return dsl::leaf<"b"> (0); });
  auto b_to_c = dsl::rule<"b-to-c"> (
      [] (ASTNode const &n) { return n.tag () == "b"; },
      [] (ASTNode const &) { return dsl::leaf<"c"> (0); });
  auto chain = dsl::rewrite_set (a_to_b, b_to_c);
  std::cout << "chain  : " << chain.apply (dsl::leaf<"a"> (0)).dump () << '\n';

  // A rule whose output creates a redex for an *earlier* rule needs a
  // second pass of the outer fixpoint loop.
  passes = 0;
  auto one_to_done = dsl::rule<"one-to-done"> (
      [] (ASTNode const &n) { return n.tag () == "one"; },
      [] (ASTNode const &) { return dsl::leaf<"done"> (0); });
  auto two_to_one = dsl::rule<"two-to-one"> (
      [] (ASTNode const &n) { return n.tag () == "two"; },
      [] (ASTNode const &n) { return dsl::node<"one"> (n.child (0)); });
  auto late = dsl::rewrite_set (count_passes, one_to_done, two_to_one);
  std::cout << "late   : " << late.apply (dsl::node<"expr"> (dsl::node<"two"> (dsl::leaf<"three"> (0)))).dump ()
            << '\n';
  std::cout << "passes : " << passes << '\n';

  // Silent truncation: the budget is exhausted and the last tree is returned.
  auto bump = dsl::rule<"bump"> (
      [] (ASTNode const &n) { return n.is_leaf () && n.tag () == "num"; },
      [] (ASTNode const &n) { return dsl::leaf<"num"> (std::stoi (n.value ()) + 1); });
  auto looping = dsl::rewrite_set (bump);
  looping.max_iterations = 4;
  std::cout << "trunc  : " << looping.apply (dsl::node<"expr"> (dsl::leaf<"num"> (0))).dump ()
            << '\n';
  return 0;
}
\end{lstlisting}

The output is

\begin{lstlisting}[style=dslcmd,caption={Output of Listing~\ref{lst:rewriteset-demo}.},label={lst:rewriteset-demo-out}]
before : (expr (and (or (lit true) (lit false)) (not (lit false))))
after  : (expr (lit true))
passes : 2
chain  : (c 0)
late   : (expr (done 0))
passes : 3
trunc  : (expr (num 4))
\end{lstlisting}

