    \node[dslsmall, right=of v] (s1) {stage 1\\\code{a.fn}};
    \node[dslsmall, right=of s1] (s2) {stage 2\\\code{b.fn}};
    \node[dslsmall, right=of s2] (s3) {stage 3\\\code{c.fn}};
