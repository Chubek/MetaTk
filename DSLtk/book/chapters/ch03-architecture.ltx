  \node[dslbox, text width=62mm, minimum height=11mm] (l1) at (0,-7.75) {\textbf{Layer 1: core value types}\\\code{FixedString}, \code{ASTNode}, \code{Maybe<T>}, \code{Result<T,E>}, \code{Lazy<T>}};

  \draw[dsledge] (l1) -- (l2);
  \draw[dsledge] (l2) -- (l3);
