  \node[dslbox, below=8mm of src, text width=56mm] (st1) {\texttt{stack: [(num 1)]}};
  \node[dslbox, below=5mm of st1, text width=56mm] (st2) {\texttt{stack: [(num 1), (op +)]}};
  \node[dslbox, below=5mm of st2, text width=56mm] (st3) {\texttt{stack: [(add (num 1) (num 2))]}};
