  \draw[dslfeedback] (ok.west) -- ++(-18mm,0) |- node[left, font=\scriptsize] {no: the next arm} (loop.west);
  \draw[dsledgedash] (loop.east) -- ++(24mm,0) |- node[right, font=\scriptsize] {every arm has failed} (wild.east);
