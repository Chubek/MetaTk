option(METAML_ENABLE_QBE "Enable the optional host-native QBE backend" OFF)
if(NOT METAML_ENABLE_QBE)
    return()
endif()
if(NOT UNIX OR CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "The MetaML QBE backend currently requires a native POSIX build")
endif()
enable_language(C)
set(METAML_QBE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../third_party/qbe" CACHE PATH "QBE source directory")
set(METAML_QBE_EXECUTABLE "" CACHE FILEPATH "Use an existing QBE executable instead of building vendored QBE")
if(METAML_QBE_EXECUTABLE)
    set(_metaml_qbe_compiler "${METAML_QBE_EXECUTABLE}")
else()
    set(_qbe_sources main util parse abi cfg mem ssa alias load copy fold gvn gcm simpl ifopt live spill rega emit)
    foreach(_arch IN ITEMS amd64 arm64 rv64)
        if(_arch STREQUAL amd64)
            list(APPEND _qbe_sources amd64/targ amd64/sysv amd64/isel amd64/emit)
        else()
            list(APPEND _qbe_sources ${_arch}/targ ${_arch}/abi ${_arch}/isel ${_arch}/emit)
        endif()
    endforeach()
    list(TRANSFORM _qbe_sources PREPEND "${METAML_QBE_DIR}/")
    list(TRANSFORM _qbe_sources APPEND ".c")
    set(_qbe_target T_amd64_sysv)
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
        set(_qbe_target T_arm64)
    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^riscv64")
        set(_qbe_target T_rv64)
    elseif(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
        message(FATAL_ERROR "Unsupported QBE host: ${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    if(APPLE)
        string(APPEND _qbe_target "_apple")
    endif()
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/qbe-config")
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/qbe-config/config.h" CONTENT "#define Deftgt ${_qbe_target}\n")
    add_executable(metaml-qbe-compiler ${_qbe_sources})
    set_target_properties(metaml-qbe-compiler PROPERTIES OUTPUT_NAME qbe C_STANDARD 99 C_STANDARD_REQUIRED YES)
    target_include_directories(metaml-qbe-compiler PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/qbe-config")
    set(_metaml_qbe_compiler "$<TARGET_FILE:metaml-qbe-compiler>")
    install(TARGETS metaml-qbe-compiler RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
    install(FILES "${METAML_QBE_DIR}/LICENSE" DESTINATION share/doc/metaml RENAME QBE-LICENSE)
endif()
add_library(metaml-qbe STATIC "${CMAKE_CURRENT_LIST_DIR}/../metaml-backends/QBE.cpp")
target_compile_features(metaml-qbe PRIVATE cxx_std_20)
target_link_libraries(metaml-qbe PUBLIC ${CMAKE_DL_LIBS})
target_compile_definitions(metaml-qbe PRIVATE
    METAML_QBE_DEFAULT_COMPILER="${_metaml_qbe_compiler}"
    METAML_QBE_DEFAULT_CC="${CMAKE_C_COMPILER}")
if(TARGET metaml-qbe-compiler)
    add_dependencies(metaml-qbe metaml-qbe-compiler)
endif()
target_compile_definitions(DSLtk INTERFACE METAML_ENABLE_QBE)
target_link_libraries(DSLtk INTERFACE metaml-qbe)
install(TARGETS metaml-qbe EXPORT DSLtkTargets ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
