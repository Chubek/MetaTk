cmake_minimum_required(VERSION 3.20)

# Byte arrays avoid C99's small guaranteed string-literal length and make
# escaping independent of QScript syntax. Break lines at sixteen source bytes.
function(mlvm_array name path)
    file(READ "${path}" source HEX)
    string(LENGTH "${source}" count)
    set(text "static const unsigned char ${name}[] = {\n")
    set(offset 0)
    while(offset LESS count)
        math(EXPR take "${count} - ${offset}")
        if(take GREATER 32)
            set(take 32)
        endif()
        string(SUBSTRING "${source}" ${offset} ${take} chunk)
        string(REGEX REPLACE "(..)" "0x\\1," chunk "${chunk}")
        string(APPEND text "    ${chunk}\n")
        math(EXPR offset "${offset} + ${take}")
    endwhile()
    string(APPEND text "    0\n};\n")
    set(body "${body}${text}" PARENT_SCOPE)
endfunction()

set(body "/* Generated by MLVM/cmake/Embed.cmake. Do not edit. */\n#include \"MLVM/bridge/Embedded.h\"\n")
string(REPLACE "|" ";" LIBRARIES "${LIBRARIES}")
set(table "")
set(index 0)
foreach(name IN LISTS LIBRARIES)
    mlvm_array(source_${index} "${SOURCE_ROOT}/${name}.qs")
    string(APPEND table "    {\"${name}\", source_${index}, sizeof(source_${index}) - 1},\n")
    math(EXPR index "${index} + 1")
endforeach()
mlvm_array(entry "${ENTRY}")
string(APPEND body "static const mlvm_library_source libraries[] = {\n${table}};\n")
string(APPEND body "const mlvm_library_source *mlvm_embedded_libraries(size_t *n) { *n = sizeof(libraries)/sizeof(libraries[0]); return libraries; }\n")
string(APPEND body "const unsigned char *mlvm_embedded_entry(size_t *n) { *n = sizeof(entry)-1; return entry; }\n")
file(WRITE "${OUTPUT}" "${body}")
