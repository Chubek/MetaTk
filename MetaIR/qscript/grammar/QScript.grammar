# The QScript grammar, in the Raku-style grammar language of
# qscript/include/QScript-Grammar.h. It is compiled into the QScript library
# and is the only parser QScript uses: there is no separate lexer.
#
#   token  matches exactly what it says (no implicit whitespace)
#   rule   whitespace after an atom in the source means <.ws> (sigspace)
#   proto  variants are tried longest-literal-first (`<=` before `<`)
#
# The match tree is turned into the QScript AST by qscript/src/AST.cpp, which
# also applies operator precedence to the flat <binary> operand lists.
#
# Grammar declarations inside QScript source are matched here only as
# balanced text (<gbody>); the body is then compiled by the same grammar
# engine when the program is compiled, so grammars are checked at compile time.

grammar QScript {
    rule TOP        { <.ws> <item>* }
    rule item       { <use> | <fn> | <const> | <grammar-decl> | <statement> }

    # ---- declarations ---------------------------------------------------
    rule use        { <.kw-use> <libname>+ % ',' ';' }
    token libname   { <ident>+ % '::' }
    rule fn         { [ <.kw-fn> | <.kw-sub> ] <name=ident> '(' <params>? ')' <rettype>? <block> }
    rule params     { <param>+ % ',' }
    rule param      { <name=ident> <ptype>? }
    rule ptype      { ':' <type> }
    rule rettype    { ':' <type> }
    rule const      { <.kw-const> <name=ident> '=' <expr> ';' }
    rule block      { '{' <statement>* '}' }

    rule grammar-decl { <.kw-grammar> <name=ident> [ <.kw-is> <parent=ident> ]? '{' <gbody> '}' }

    # Types: int, str, grammar, match and list<T>. Names are not keywords
    # elsewhere, so `list` and `match` remain usable as identifiers.
    rule type       { <.kw-list> '<' <elem=type> '>' | <simple-type> }
    token simple-type { [ 'int' | 'str' | 'grammar' | 'match' ] >> }

    # ---- statements -----------------------------------------------------
    proto rule statement {*}
    rule statement:sym<block>    { <block> }
    rule statement:sym<let>      { <let> ';' }
    rule statement:sym<if>       { <.kw-if> <cond> <then=statement> <elsif>* [ <.kw-else> <else=statement> ]? }
    rule statement:sym<unless>   { <.kw-unless> <cond> <then=statement> [ <.kw-else> <else=statement> ]? }
    rule statement:sym<while>    { <.kw-while> <cond> <statement> }
    rule statement:sym<until>    { <.kw-until> <cond> <statement> }
    rule statement:sym<do>       { <.kw-do> <block> [ <while=.kw-while> | <until=.kw-until> ] <cond> ';' }
    rule statement:sym<foreach>  { <.kw-for> '(' [ <.kw-my> | <.kw-let> ] <name=ident> <.kw-in> <expr> ')' <statement> }
    rule statement:sym<for>      { <.kw-for> '(' <init=forinit>? ';' <test=expr>? ';' <step=simple>? ')' <statement> }
    rule statement:sym<loop>     { <.kw-loop> <block> }
    rule statement:sym<break>    { [ <.kw-break> | <.kw-last> ] <modifier>? ';' }
    rule statement:sym<continue> { [ <.kw-continue> | <.kw-next> ] <modifier>? ';' }
    rule statement:sym<return>   { <.kw-return> <expr>? <modifier>? ';' }
    rule statement:sym<exit>     { <.kw-exit> <expr>? <modifier>? ';' }
    rule statement:sym<print>    { [ <.kw-print> | <.kw-say> ] <expr>+ % ',' <modifier>? ';' }
    rule statement:sym<assert>   { <.kw-assert> <expr> <modifier>? ';' }
    rule statement:sym<simple>   { <simple> <modifier>? ';' }
    rule statement:sym<empty>    { ';' }

    rule let        { [ <.kw-let> | <.kw-my> ] <name=ident> <vtype>? '=' <expr> }
    rule vtype      { ':' <type> }
    rule cond       { '(' <expr> ')' }
    rule elsif      { <.kw-elsif> <cond> <statement> }
    rule forinit    { <let> | <simple> }
    rule simple     { <assign> | <incdec> | <expr> }
    rule assign     { <name=ident> [ '[' <index=expr> ']' ]* <assignop> <expr> }
    rule incdec     { <name=ident> [ '[' <index=expr> ']' ]* <incop> }
    rule modifier   { [ <if=.kw-if> | <unless=.kw-unless> ] <expr> }

    proto token assignop {*}
    token assignop:sym<=>    { '=' <!before '='> }
    token assignop:sym<+=>   { <sym> }
    token assignop:sym<-=>   { <sym> }
    token assignop:sym<*=>   { <sym> }
    token assignop:sym</=>   { <sym> }
    token assignop:sym<%=>   { <sym> }
    token assignop:sym<&=>   { <sym> }
    token assignop:sym<|=>   { <sym> }
    token assignop:sym<^=>   { <sym> }
    token assignop:sym<~=>   { <sym> }
    token assignop:sym<**=>  { <sym> }
    token assignop:sym«<<=»  { <sym> }
    token assignop:sym«>>=»  { <sym> }
    token incop     { '++' | '--' }

    # ---- expressions ----------------------------------------------------
    # Operands and infix operators are matched flat; precedence and
    # associativity are applied afterwards (operator-precedence parsing, as
    # Raku does for its own EXPR).
    rule expr       { <ternary> }
    rule ternary    { <binary> [ '?' <then=expr> ':' <else=ternary> ]? }
    rule binary     { <operand>+ % <infix> }
    rule operand    { [ <prefix> ]* <term> }

    proto token prefix {*}
    token prefix:sym<->    { <sym> <!before '-'> }
    token prefix:sym<+>    { <sym> <!before '+'> }
    token prefix:sym<!>    { <sym> }
    token prefix:sym<~>    { <sym> }
    token prefix:sym<not>  { <sym> >> }

    proto token infix {*}
    token infix:sym<||>   { <sym> }
    token infix:sym<or>   { <sym> >> }
    token infix:sym<&&>   { <sym> }
    token infix:sym<and>  { <sym> >> }
    token infix:sym<|>    { <sym> <!before '='> }
    token infix:sym<^>    { <sym> <!before '='> }
    token infix:sym<&>    { <sym> <!before '='> }
    token infix:sym<==>   { <sym> }
    token infix:sym<!=>   { <sym> }
    token infix:sym«<=»   { <sym> }
    token infix:sym«>=»   { <sym> }
    token infix:sym«<»    { <sym> }
    token infix:sym«>»    { <sym> }
    token infix:sym«<<»   { <sym> <!before '='> }
    token infix:sym«>>»   { <sym> <!before '='> }
    token infix:sym<+>    { <sym> <!before '='> }
    token infix:sym<->    { <sym> <!before '='> }
    token infix:sym<~>    { <sym> <!before '='> }
    token infix:sym<*>    { <sym> <!before '='> }
    token infix:sym</>    { <sym> <!before '='> }
    token infix:sym<%>    { <sym> <!before '='> }
    token infix:sym<**>   { <sym> <!before '='> }

    # A term is a primary followed by any number of indexes and method calls.
    rule term       { <primary> <postfix>* }
    rule primary    { <call> | <number> | <char> | <string> | <true=.kw-true> | <false=.kw-false>
                    | <grammar-lit> | <list> | <var> | <group> }
    rule postfix    { <index> | <method> }
    rule index      { '[' <expr> ']' }
    rule method     { '.' <name=method-name> '(' <args>? ')' }
    # Method names may be keywords (s.sub(1, 2), xs.last()): after a dot there is no ambiguity.
    token method-name { <[A..Za..z_]> \w* }
    rule group      { '(' <expr> ')' }
    rule call       { <qname> '(' <args>? ')' }
    rule args       { <expr>+ % ',' }
    rule list       { '[' <expr>* % ',' ']' }
    rule grammar-lit { <.kw-grammar> '{' <gbody> '}' }
    token qname     { <ident>+ % '::' }
    token var       { <ident>+ % '::' }
    token number    { [ '0' <[xX]> <[0..9a..fA..F_]>+ | '0' <[bB]> <[01_]>+ | '0' <[oO]> <[0..7_]>+ | \d <[0..9_]>* ] >> }
    token char      { "'" [ '\\' [ 'x' <xdigit> <xdigit> | <[nrt0\\'"]> ] | <-['\\\n]> ] "'" }
    token string    { '"' [ '\\' . | <-["\\]> ]* '"' }

    # ---- grammar bodies --------------------------------------------------
    # Balanced text up to the closing brace. Quoted literals, character
    # classes, escapes and comments may contain braces without counting.
    token gbody     { [ <gnest> | <gquote> | <gclass> | <gcomment> | '\\' . | <-[{}'"#\\<]> | '<' ]* }
    token gnest     { '{' <gbody> '}' }
    token gquote    { "'" [ '\\' . | <-['\\]> ]* "'" | '"' [ '\\' . | <-["\\]> ]* '"' }
    token gclass    { '<' [ '-' | '+' ]? '[' [ '\\' . | <-[\]\\]> ]* ']' }
    token gcomment  { '#' \N* }

    # ---- lexical --------------------------------------------------------
    token ident     { <!keyword> <[A..Za..z_]> \w* }
    token ws        { [ \s+ | '//' \N* | '#' \N* | '/*' .*? '*/' ]* }

    token keyword   { <.kw-use> | <.kw-fn> | <.kw-sub> | <.kw-const> | <.kw-let> | <.kw-my>
                    | <.kw-if> | <.kw-elsif> | <.kw-else> | <.kw-unless> | <.kw-while> | <.kw-until>
                    | <.kw-do> | <.kw-for> | <.kw-in> | <.kw-loop> | <.kw-break> | <.kw-last> | <.kw-continue>
                    | <.kw-next> | <.kw-return> | <.kw-exit> | <.kw-print> | <.kw-say> | <.kw-assert>
                    | <.kw-and> | <.kw-or> | <.kw-not> | <.kw-true> | <.kw-false>
                    | <.kw-grammar> | <.kw-is> }
    token kw-use      { 'use' >> }
    token kw-fn       { 'fn' >> }
    token kw-sub      { 'sub' >> }
    token kw-const    { 'const' >> }
    token kw-let      { 'let' >> }
    token kw-my       { 'my' >> }
    token kw-if       { 'if' >> }
    token kw-elsif    { 'elsif' >> }
    token kw-else     { 'else' >> }
    token kw-unless   { 'unless' >> }
    token kw-while    { 'while' >> }
    token kw-until    { 'until' >> }
    token kw-do       { 'do' >> }
    token kw-for      { 'for' >> }
    token kw-in       { 'in' >> }
    token kw-loop     { 'loop' >> }
    token kw-break    { 'break' >> }
    token kw-last     { 'last' >> }
    token kw-continue { 'continue' >> }
    token kw-next     { 'next' >> }
    token kw-return   { 'return' >> }
    token kw-exit     { 'exit' >> }
    token kw-print    { 'print' >> }
    token kw-say      { 'say' >> }
    token kw-assert   { 'assert' >> }
    token kw-and      { 'and' >> }
    token kw-or       { 'or' >> }
    token kw-not      { 'not' >> }
    token kw-true     { 'true' >> }
    token kw-false    { 'false' >> }
    token kw-grammar  { 'grammar' >> }
    token kw-is       { 'is' >> }
    token kw-list     { 'list' >> }
}
