# The Carbinefile grammar, in the Raku-style grammar language of
# qscript/include/QScript-Grammar.h. Carbine compiles it into the binary
# (CMake embeds it as carbine_grammar.h) and parses every Carbinefile with it.
#
#   project NAME;                  names the project (optional)
#   import DIR;                    also reads DIR/Carbinefile
#   target KIND NAME {
#       sources PATTERN...;        globs relative to the Carbinefile; !PATTERN excludes
#       deps NAME...;              other targets this one needs first
#       include DIR...;            C include directories
#       define NAME...;            C macros, becoming -DNAME
#       flags WORD...;             compiler flags (-Wl,... and -l/-L also reach links)
#   }
#
# KIND is lib (a static library of .c files), exe (an executable of .c files)
# or program (QScript .c15 sources built with `qscript build`).
# Comments run from '#' or '//' to the end of the line, or between '/*' and '*/'.
# A quoted path may contain spaces; an unquoted one may not.

grammar Carbinefile {
    rule TOP            { <.ws> <item>* <.ws> <!before .> }

    proto rule item    {*}
    rule item:sym<project> { <.kw-project> <name=ident> <.semi> }
    rule item:sym<import>  { <.kw-import> <path> <.semi> }
    rule item:sym<target>  { <.kw-target> <kind=ident> <name=ident> '{' <stmt>* '}' }

    proto rule stmt    {*}
    rule stmt:sym<sources> { <.kw-sources> <path>+ <.semi> }
    rule stmt:sym<deps>    { <.kw-deps> <ident>+ <.semi> }
    rule stmt:sym<include> { <.kw-include> <path>+ <.semi> }
    rule stmt:sym<define>  { <.kw-define> <ident>+ <.semi> }
    rule stmt:sym<flags>   { <.kw-flags> <path>+ <.semi> }

    token semi         { ';' }
    token path         { '"' <-["]>* '"' | '!'? <[A-Za-z0-9_./*?+@%=:,~-]>+ }
    token ident        { <[A-Za-z_]> <[A-Za-z0-9_.-]>* }
    token ws           { [ \s+ | '#' \N* | '//' \N* | '/*' .*? '*/' ]* }

    token kw-project   { 'project' >> }
    token kw-import    { 'import' >> }
    token kw-target    { 'target' >> }
    token kw-sources   { 'sources' >> }
    token kw-deps      { 'deps' >> }
    token kw-include   { 'include' >> }
    token kw-define    { 'define' >> }
    token kw-flags     { 'flags' >> }
}
