import metaarch;
import std.file : read;
import std.stdio : writeln;
import std.string : fromStringz, toStringz;

int main(string[] args) {
    assert(args.length == 2);
    assert(metaarch_abi_version() == METAARCH_ABI_VERSION);
    auto d = metaarch_diagnostics_create();
    assert(d !is null);
    scope(exit) metaarch_diagnostics_free(d);
    auto s = metaarch_spec_load(toStringz(args[1]), MA_AUTO, MA_LOAD_STRICT | MA_LOAD_LINT, d);
    scope(exit) metaarch_spec_free(s);
    assert(s !is null && metaarch_diagnostics_count(d) == 0);
    assert(metaarch_spec_target_count(s) == 2 && metaarch_spec_register_count(s) == 2);
    assert(metaarch_spec_encoder_count(s) == 3 && metaarch_spec_form_count(s) == 3);
    MaTargetView target;
    assert(metaarch_spec_target(s, 0, &target) == MA_OK);
    assert(fromStringz(target.arch) == "test" && fromStringz(target.subarch) == "v1");
    assert(fromStringz(target.object_format) == "ELF32" && fromStringz(target.abi) == "test");
    assert(target.address_width == 32 && target.byte_order == MA_LITTLE_ENDIAN);
    MaRegisterView reg;
    assert(metaarch_spec_register(s, 1, &reg) == MA_OK);
    assert(fromStringz(reg.name) == "r1" && fromStringz(reg.reg_class) == "gpr");
    assert(reg.width == 32 && reg.encoding == 1);
    assert(metaarch_spec_find_register(s, "r1") == 1 && metaarch_spec_find_encoder(s, "branch") == 1);
    assert(fromStringz(metaarch_spec_encoder_name(s, 0)) == "pair");
    MaFormView form;
    assert(metaarch_spec_form(s, 0, &form) == MA_OK && form.operand_count == 3 && form.visible_operand_count == 2);
    assert(fromStringz(form.mnemonic) == "pair" && fromStringz(form.encoder) == "pair");
    const(char)*[2] names = ["dst".ptr, "imm".ptr];
    long[2] values = [1, -1];
    auto r = metaarch_spec_encode(s, "pair", 0, names.ptr, values.ptr, values.length, d);
    assert(r !is null && metaarch_result_size(r) == 4);
    assert(metaarch_result_data(r)[0 .. 4] == [1, 255, 0, 0]);
    metaarch_result_free(r);
    r = metaarch_spec_encode_form(s, 0, 1, values.ptr, values.length, d);
    assert(r !is null && metaarch_result_data(r)[0 .. 4] == [0, 0, 255, 1]);
    metaarch_result_free(r);
    values[1] = 11;
    assert(metaarch_spec_encode_form(s, 0, 0, values.ptr, values.length, d) is null);
    MaDiagnosticView diag;
    assert(metaarch_diagnostics_get(d, 0, &diag) == MA_OK && diag.severity == MA_ERROR);
    assert(fromStringz(diag.message).length > 0);
    metaarch_diagnostics_clear(d);
    assert(metaarch_diagnostics_count(d) == 0);
    foreach (f; MA_YAML .. MA_SEXPR + 1) {
        r = metaarch_spec_write(s, f, MA_WRITE_REF_BACKEND, d);
        assert(r !is null);
        auto copy = metaarch_spec_parse(metaarch_result_data(r), metaarch_result_size(r), f, "copy", 0, d);
        assert(copy !is null && metaarch_spec_form_count(copy) == 3);
        metaarch_spec_free(copy);
        metaarch_result_free(r);
    }
    const(char)*[1] symbol = ["symbol".ptr];
    long[1] value = [42];
    r = metaarch_spec_encode(s, "branch", 0, symbol.ptr, value.ptr, 1, d);
    assert(r !is null && metaarch_result_relocation_count(r) == 1);
    metaarch_spec_free(s); s = null;
    MaRelocationView relocation;
    assert(metaarch_result_relocation(r, 0, &relocation) == MA_OK);
    assert(fromStringz(relocation.name) == "R_FIX" && relocation.offset == 1 && relocation.size == 4);
    assert(relocation.bit_offset == 5 && relocation.bit_width == 20 && relocation.byte_order == MA_BIG_ENDIAN);
    assert(relocation.symbol_parameter == 0 && relocation.symbol_value == 42);
    metaarch_result_free(r);
    auto bytes = read(args[1]);
    s = metaarch_spec_parse(bytes.ptr, bytes.length, MA_YAML, toStringz(args[1]), 0, d);
    assert(s !is null);
    assert(metaarch_spec_load_backend(s, d));
    assert(metaarch_spec_target(s, size_t.max, &target) == MA_NOT_FOUND);
    assert(metaarch_spec_parse("bad: [".ptr, 6, MA_YAML, "bad.yaml", 0, d) is null);
    assert(metaarch_diagnostics_count(d) > 0);
    assert(metaarch_diagnostics_get(d, metaarch_diagnostics_count(d) - 1, &diag) == MA_OK);
    assert(diag.line > 0 && fromStringz(diag.file) == "bad.yaml");
    writeln("D ABI interface tests passed");
    return 0;
}
