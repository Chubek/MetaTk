        { kind = "form"; msg = "shader entry forms require shader"; ref = "entrypoint"; },
        { kind = "form"; msg = "atomic forms require atomic"; ref = "atomiciadd"; }
    ];
    backend = { file = "backend/spirv.json"; };
}
