            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sub";
        encoder = "sub";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "and";
        encoder = "and";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "orr";
        encoder = "orr";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "eor";
        encoder = "eor";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "mov";
        encoder = "mov";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "imm"; width = 8; imm_min = 0; imm_max = 255; signed = false; }
        ];
    }
    form {
        mnemonic = "mvn";
        encoder = "mvn";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "imm"; width = 8; imm_min = 0; imm_max = 255; signed = false; }
        ];
    }
    form {
        mnemonic = "cmp";
        encoder = "cmp";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "tst";
        encoder = "tst";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "lsl";
        encoder = "lsl";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 8; imm_min = 0; imm_max = 31; signed = false; }
        ];
    }
    form {
        mnemonic = "mul";
        encoder = "mul";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "mla";
        encoder = "mla";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sdiv";
        encoder = "sdiv";
        flags = ["may_trap"];
        required = ["hwdiv"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "ldr";
        encoder = "ldr";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "str";
        encoder = "str";
        flags = ["writes_mem"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "mem"; width = 32; }];
    }
    form {
        mnemonic = "ldrb";
        encoder = "ldrb";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 8; }
        ];
    }
    form {
        mnemonic = "strb";
        encoder = "strb";
        flags = ["writes_mem"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "mem"; width = 8; }];
    }
    form {
        mnemonic = "ldm";
        encoder = "ldm";
        flags = ["reads_mem"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "reglist"; width = 32; }];
    }
    form {
        mnemonic = "stm";
        encoder = "stm";
        flags = ["writes_mem"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "reglist"; width = 32; }];
    }
    form {
        mnemonic = "bx";
        encoder = "bx";
        flags = ["branch", "terminator"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "blx";
        encoder = "blx";
        flags = ["branch"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "b";
        encoder = "b";
        flags = ["branch", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "bl";
        encoder = "bl";
        flags = ["branch", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "svc";
        encoder = "svc";
        flags = ["may_trap"];
        operands = [{ kind = "imm"; width = 24; imm_min = 0; imm_max = 16777215; signed = false; }];
    }
    form {
        mnemonic = "mrs";
        encoder = "mrs";
        flags = ["privileged"];
        required = ["priv"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; access = "write"; }];
    }
    form {
        mnemonic = "msr";
        encoder = "msr";
        flags = ["privileged"];
        required = ["priv"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }];
    }
    form { mnemonic = "dmb"; encoder = "dmb"; }
    form { mnemonic = "clrex"; encoder = "clrex"; }
    form {
        mnemonic = "ldrexd";
        encoder = "ldrexd";
        flags = ["reads_mem"];
        required = ["mp"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 64; }
        ];
    }
    form {
        mnemonic = "t.add";
        encoder = "tadd";
        required = ["thumb"];
        syntaxes = ["thumb"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "t.cbz";
        encoder = "tcbz";
        flags = ["cond_branch", "reloc"];
        required = ["thumb2"];
        syntaxes = ["thumb"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "fadds";
        encoder = "fadds";
        required = ["vfpv3"];
        operands = [
            { kind = "reg"; width = 32; class = "fp"; access = "write"; },
            { kind = "reg"; width = 32; class = "fp"; },
            { kind = "reg"; width = 32; class = "fp"; }
        ];
    }
    form {
        mnemonic = "fmuls";
        encoder = "fmuls";
        required = ["vfpv3"];
        operands = [
            { kind = "reg"; width = 32; class = "fp"; access = "write"; },
            { kind = "reg"; width = 32; class = "fp"; },
            { kind = "reg"; width = 32; class = "fp"; }
        ];
    }
    form {
        mnemonic = "vadd";
        encoder = "vadd";
        required = ["neon"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "vld1";
        encoder = "vld1";
        flags = ["reads_mem"];
        required = ["neon"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "mem"; width = 128; }
        ];
    }
    form {
        mnemonic = "aese";
        encoder = "aese";
        required = ["crypto"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "readwrite"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "crc32b";
        encoder = "crc32b";
        required = ["crc"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sadd16";
        encoder = "sadd16";
        required = ["dsp"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "smlabb";
        encoder = "smlabb";
        required = ["dsp"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    syntax default { comment = "@"; separator = ", "; }
    syntax thumb { comment = "@"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 4; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 4;
            content = "data";
        },
        { name = ".tdata"; flags = ["write", "alloc", "tls", "data"]; align = 4; content = "data"; },
        { name = ".init"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; },
        { name = ".eh_frame"; flags = ["alloc", "readonly", "data"]; align = 4; content = "data"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "tls_var"; binding = "tls"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; }
    ];
    reloc R_ARM_NONE { width = 32; expr = "S + A"; }
    reloc R_ARM_ABS32 { width = 32; expr = "S + A"; }
    reloc R_ARM_ABS16 { width = 32; expr = "S + A"; }
    reloc R_ARM_JUMP24 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARM_CALL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARM_THM_JUMP24 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARM_THM_JUMP6 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARM_THM_CALL { width = 32; signed = true; pcrel = true; expr = "PLT(S) + A - P"; }
    reloc R_ARM_MOVW_ABS_NC { width = 32; expr = "S + A"; }
    reloc R_ARM_MOVT_ABS { width = 32; expr = "S + A"; }
    reloc R_ARM_MOVW_PREL_NC { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARM_MOVT_PREL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARM_GOT32 { width = 32; expr = "GOT(S) + A"; }
    reloc R_ARM_GOT_PREL { width = 32; signed = true; pcrel = true; expr = "GOT(S) + A - P"; }
    reloc R_ARM_TLS_GD32 { width = 32; expr = "TLS(S) + A"; }
    reloc R_ARM_TLS_IE32 { width = 32; expr = "TLS(S) + A"; }
    reloc R_ARM_TLS_LE32 { width = 32; expr = "TLS(S) + A"; }
    reloc R_ARM_GLOB_DAT { width = 32; expr = "S"; }
    reloc R_ARM_JUMP_SLOT { width = 32; expr = "S"; }
    reloc R_ARM_RELATIVE { width = 32; expr = "B + A"; }
    reloc R_ARM_PREL31 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_ARM_TARGET1 { width = 32; expr = "S + A"; }
    reloc R_ARM_V4BX { width = 32; expr = "S + A"; }
    debug = [
        { kind = "target"; msg = "arm+thumb2+vfp+neon+dsp+crypto stratification"; ref = ""; },
        { kind = "form"; msg = "thumb forms use thumb syntax"; ref = "t.add"; },
        { kind = "form"; msg = "privileged system forms need priv"; ref = "mrs"; }
    ];
    backend = { file = "backend/arm32.json"; };
}
