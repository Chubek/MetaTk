            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "addi";
        encoder = "r_addi";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; }
        ];
    }
    form {
        mnemonic = "mpyi";
        encoder = "mpyi";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; }
        ];
    }
    form {
        mnemonic = "memw.ld";
        encoder = "memwld";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "memw.st";
        encoder = "memwst";
        flags = ["writes_mem"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "mem"; width = 32; }];
    }
    form {
        mnemonic = "jump";
        encoder = "jump";
        flags = ["branch", "terminator", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "jumpr";
        encoder = "jumpr";
        flags = ["branch", "terminator"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "call";
        encoder = "call";
        flags = ["branch", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "deallocreturn";
        encoder = "dealloc";
        flags = ["return", "terminator"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "trap";
        encoder = "trap";
        flags = ["may_trap"];
        operands = [{ kind = "imm"; width = 8; imm_min = 0; imm_max = 255; signed = false; }];
    }
    form {
        mnemonic = "vadd";
        encoder = "vadd";
        required = ["hvx"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "vmul";
        encoder = "vmul";
        required = ["hvx"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "vld";
        encoder = "vld";
        flags = ["reads_mem"];
        required = ["hvx"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "mem"; width = 128; }
        ];
    }
    form {
        mnemonic = "vst";
        encoder = "vst";
        flags = ["writes_mem"];
        required = ["hvx"];
        operands = [{ kind = "reg"; width = 128; class = "vec"; }, { kind = "mem"; width = 128; }];
    }
    syntax default { comment = "//"; separator = ", "; }
    syntax packet { comment = "//"; separator = " ; "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 4; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 4;
            content = "data";
        },
        { name = ".tdata"; flags = ["write", "alloc", "tls", "data"]; align = 4; content = "data"; },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; }
    ];
    reloc R_HEX_NONE { width = 32; expr = "S + A"; }
    reloc R_HEX_32 { width = 32; expr = "S + A"; }
    reloc R_HEX_16 { width = 16; expr = "S + A"; }
    reloc R_HEX_B22_PCREL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_HEX_B15_PCREL { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_HEX_LO16 { width = 16; expr = "S + A"; }
    reloc R_HEX_HI16 { width = 16; expr = "S + A"; }
    reloc R_HEX_GOTREL_LO16 { width = 16; expr = "GOT(S) + A"; }
    reloc R_HEX_GOTREL_HI16 { width = 16; expr = "GOT(S) + A"; }
    reloc R_HEX_TLS_GD { width = 32; expr = "TLS(S) + A"; }
    reloc R_HEX_TLS_TPREL { width = 32; expr = "TLS(S) + A"; }
    reloc R_HEX_GLOB_DAT { width = 32; expr = "S"; }
    reloc R_HEX_JMP_SLOT { width = 32; expr = "S"; }
    reloc R_HEX_RELATIVE { width = 32; expr = "B + A"; }
    debug = [
        { kind = "target"; msg = "hexagon VLIW packets: scalar base + hvx + duplex"; ref = ""; },
        { kind = "form"; msg = "hvx forms require hvx"; ref = "vadd"; },
        { kind = "syntax"; msg = "packet syntax separates slots with ;"; ref = "packet"; }
    ];
    backend = { file = "backend/hexagon.json"; };
}
