    mnemonic vld {  }
    mnemonic vst {  }
    encoder nop { max_bytes = 4; body = "EMIT32LE 0x7800C000\n"; }
    encoder add { max_bytes = 4; body = "EMIT32LE 0x51000000 + rd*65536 + rs*2048 + rt\n"; }
    encoder sub { max_bytes = 4; body = "EMIT32LE 0x51000040 + rd*65536 + rs*2048 + rt\n"; }
    encoder and { max_bytes = 4; body = "EMIT32LE 0x52000000 + rd*65536 + rs*2048 + rt\n"; }
    encoder or { max_bytes = 4; body = "EMIT32LE 0x52000040 + rd*65536 + rs*2048 + rt\n"; }
    encoder xor { max_bytes = 4; body = "EMIT32LE 0x52000080 + rd*65536 + rs*2048 + rt\n"; }
    encoder r_addi { max_bytes = 4; body = "EMIT32LE 0x39000000 + rd*65536 + rs*2048 + ((imm + 2048) % 4096)\n"; }
    encoder mpyi { max_bytes = 4; body = "EMIT32LE 0x57000000 + rd*65536 + rs*2048 + ((imm + 2048) % 4096)\n"; }
    encoder memwld { max_bytes = 4; body = "EMIT32LE 0x67000000 + rd*65536 + rs*2048\n"; }
    encoder memwst { max_bytes = 4; body = "EMIT32LE 0x5F000000 + rs*65536 + rt*2048\n"; }
    encoder jump {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT32LE 0x58000000\nEMIT_RELOCATION sym, R_HEX_B22_PCREL\n";
    }
    encoder jumpr { max_bytes = 4; body = "EMIT32LE 0x4E800000 + rs*2048\n"; }
    encoder call {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT32LE 0x5A000000\nEMIT_RELOCATION sym, R_HEX_B22_PCREL\n";
    }
    encoder dealloc { max_bytes = 4; body = "EMIT32LE 0x6B000000 + rs*2048\n"; }
    encoder trap { max_bytes = 4; body = "EMIT32LE 0x6B40C000 + (imm % 256)\n"; }
    encoder vadd { max_bytes = 4; body = "EMIT32LE 0xE1000000 + rd*65536 + rs*2048 + rt\n"; }
    encoder vmul { max_bytes = 4; body = "EMIT32LE 0xE1200000 + rd*65536 + rs*2048 + rt\n"; }
    encoder vld { max_bytes = 4; body = "EMIT32LE 0xE3000000 + rd*65536 + rs*2048\n"; }
    encoder vst { max_bytes = 4; body = "EMIT32LE 0xE3800000 + rs*65536 + rt*2048\n"; }
    form { mnemonic = "nop"; encoder = "nop"; }
    form {
        mnemonic = "add";
        encoder = "add";
