    encoder neg { max_bytes = 3; body = "EMIT8 0xF7\nEMIT_MODRM 3, dst\n"; }
    encoder not { max_bytes = 3; body = "EMIT8 0xF7\nEMIT_MODRM 2, dst\n"; }
    encoder imul { max_bytes = 4; body = "EMIT8 0x0F\nEMIT8 0xAF\nEMIT_MODRM src, dst\n"; }
    encoder div { max_bytes = 3; body = "EMIT8 0xF7\nEMIT_MODRM 6, src\n"; }
    encoder idiv { max_bytes = 3; body = "EMIT8 0xF7\nEMIT_MODRM 7, src\n"; }
    encoder shl { max_bytes = 3; body = "EMIT8 0xD3\nEMIT_MODRM 4, dst\n"; }
    encoder shr { max_bytes = 3; body = "EMIT8 0xD3\nEMIT_MODRM 5, dst\n"; }
    encoder sar { max_bytes = 3; body = "EMIT8 0xD3\nEMIT_MODRM 7, dst\n"; }
