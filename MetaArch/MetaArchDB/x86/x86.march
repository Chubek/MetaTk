    encoder popcnt { max_bytes = 5; body = "EMIT8 0xF3\nEMIT8 0x0F\nEMIT8 0xB8\nEMIT_MODRM src, dst\n"; }
    encoder tzcnt { max_bytes = 5; body = "EMIT8 0xF3\nEMIT8 0x0F\nEMIT8 0xBC\nEMIT_MODRM src, dst\n"; }
