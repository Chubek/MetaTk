            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sub";
        encoder = "sub";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "and";
        encoder = "and";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "or";
        encoder = "or";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "xor";
        encoder = "xor";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "adc";
        encoder = "adc";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sbb";
        encoder = "sbb";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "cmp";
        encoder = "cmp";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "test";
        encoder = "test";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "inc";
        encoder = "inc";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; }];
    }
    form {
        mnemonic = "dec";
        encoder = "dec";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; }];
    }
    form {
        mnemonic = "neg";
        encoder = "neg";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; }];
    }
    form {
        mnemonic = "not";
        encoder = "not";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; }];
    }
    form {
        mnemonic = "imul";
        encoder = "imul";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "div";
        encoder = "div";
        flags = ["may_trap"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "idiv";
        encoder = "idiv";
        flags = ["may_trap"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "shl";
        encoder = "shl";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "shr";
        encoder = "shr";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sar";
        encoder = "sar";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "andn";
        encoder = "andn";
        required = ["bmi1"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "popcnt";
        encoder = "popcnt";
        required = ["popcnt"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "tzcnt";
        encoder = "tzcnt";
        required = ["lzcnt"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "push";
        encoder = "push";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "pop";
        encoder = "pop";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; access = "write"; }];
    }
    form { mnemonic = "pushf"; encoder = "pushf"; }
    form { mnemonic = "popf"; encoder = "popf"; }
    form {
        mnemonic = "call";
        encoder = "call";
        flags = ["branch", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "jmp";
        encoder = "jmp";
        flags = ["branch", "terminator", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "jcc";
        encoder = "jcc";
        flags = ["cond_branch", "reloc"];
        operands = [{ kind = "cond"; width = 8; }, { kind = "sym"; width = 32; }];
    }
    form { mnemonic = "leave"; encoder = "leave"; }
    form { mnemonic = "syscall"; encoder = "syscall"; flags = ["privileged", "may_trap"]; }
    form {
        mnemonic = "int";
        encoder = "int";
        flags = ["may_trap"];
        operands = [{ kind = "imm"; width = 8; imm_min = 0; imm_max = 255; signed = false; }];
    }
    form { mnemonic = "cpuid"; encoder = "cpuid"; }
    form {
        mnemonic = "movaps";
        encoder = "movaps";
        required = ["sse"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "addps";
        encoder = "addps";
        required = ["sse"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "vaddps";
        encoder = "vaddps";
        required = ["avx"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "vfmadd";
        encoder = "vfmadd";
        required = ["fma"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "aesenc";
        encoder = "aesenc";
        required = ["aes"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "fld";
        encoder = "fld";
        required = ["x87"];
        operands = [{ kind = "mem"; width = 80; }];
    }
    form {
        mnemonic = "fadd";
        encoder = "fadd";
        required = ["x87"];
        operands = [{ kind = "reg"; width = 80; class = "fp"; access = "readwrite"; }];
    }
    form {
        mnemonic = "rdrnd";
        encoder = "rdrnd";
        required = ["rdrnd"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; access = "write"; }];
    }
    form { mnemonic = "cli"; encoder = "cli"; flags = ["privileged"]; required = ["priv"]; }
    form { mnemonic = "sti"; encoder = "sti"; flags = ["privileged"]; required = ["priv"]; }
    form { mnemonic = "hlt"; encoder = "hlt"; flags = ["privileged"]; required = ["priv"]; }
    form { mnemonic = "pause"; encoder = "pause"; }
    syntax intel { comment = ";"; separator = ", "; }
    syntax att { order = 1; reg_prefix = "%"; imm_prefix = "$"; comment = "#"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 16; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 8;
            content = "data";
        },
        { name = ".tdata"; flags = ["write", "alloc", "tls", "data"]; align = 8; content = "data"; },
        {
            name = ".tbss";
            flags = ["write", "alloc", "zerofill", "tls", "data"];
            align = 8;
            content = "data";
        },
        { name = ".init"; flags = ["exec", "alloc", "code"]; align = 16; content = "code"; },
        { name = ".fini"; flags = ["exec", "alloc", "code"]; align = 16; content = "code"; },
        { name = ".plt"; flags = ["exec", "alloc", "code"]; align = 16; content = "code"; },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        { name = ".eh_frame"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; },
        { name = ".comment"; flags = ["readonly", "merge", "meta"]; align = 1; content = "meta"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "tls_var"; binding = "tls"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; },
        { name = "hidden_func"; binding = "global"; visibility = "hidden"; symtype = "func"; }
    ];
    reloc R_386_NONE { width = 32; expr = "S + A"; }
    reloc R_386_32 { width = 32; expr = "S + A"; }
    reloc R_386_PC8 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_386_PC16 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_386_PC32 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_386_PLT32 { width = 32; signed = true; pcrel = true; expr = "PLT(S) + A - P"; }
    reloc R_386_GOT32 { width = 32; expr = "GOT(S) + A"; }
    reloc R_386_GOTPC { width = 32; pcrel = true; expr = "GOT + A - P"; }
    reloc R_386_GOTOFF { width = 32; expr = "S + A - GOT"; }
    reloc R_386_GOT32X { width = 32; expr = "GOT(S) + A"; }
    reloc R_386_TLS_GD { width = 32; pcrel = true; expr = "TLS(S) + A - P"; }
    reloc R_386_TLS_LD { width = 32; pcrel = true; expr = "TLS(S) + A - P"; }
    reloc R_386_TLS_TPOFF32 { width = 32; expr = "TLS(S) + A"; }
    reloc R_386_TLS_DTPOFF32 { width = 32; expr = "TLS(S) + A"; }
    reloc R_386_GLOB_DAT { width = 32; expr = "S"; }
    reloc R_386_JMP_SLOT { width = 32; expr = "S"; }
    reloc R_386_RELATIVE { width = 32; expr = "B + A"; }
    reloc R_386_IRELATIVE { width = 32; expr = "B + A"; }
    reloc R_386_COPY { width = 32; expr = "S"; }
    debug = [
        { kind = "target"; msg = "i386 base + bmi + sse/avx/fma + aes + x87 + priv"; ref = ""; },
        { kind = "form"; msg = "vector forms require sse/avx/fma"; ref = "vaddps"; },
        { kind = "form"; msg = "privileged forms require priv"; ref = "cli"; }
    ];
    backend = { file = "backend/x86.json"; };
}
