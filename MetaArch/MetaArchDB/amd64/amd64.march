            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "vaddps";
        encoder = "vaddps";
        required = ["avx"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "vfmadd";
        encoder = "vfmadd";
        required = ["fma"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "aesenc";
        encoder = "aesenc";
        required = ["aes"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "fld";
        encoder = "fld";
        required = ["x87"];
        operands = [{ kind = "mem"; width = 80; }];
    }
    form {
        mnemonic = "fadd";
        encoder = "fadd";
        required = ["x87"];
        operands = [{ kind = "reg"; width = 80; class = "fp"; access = "readwrite"; }];
    }
    form {
        mnemonic = "rdrnd";
        encoder = "rdrnd";
        required = ["rdrnd"];
        operands = [{ kind = "reg"; width = 64; class = "gpr"; access = "write"; }];
    }
    form { mnemonic = "cli"; encoder = "cli"; flags = ["privileged"]; required = ["priv"]; }
    form { mnemonic = "sti"; encoder = "sti"; flags = ["privileged"]; required = ["priv"]; }
    form { mnemonic = "hlt"; encoder = "hlt"; flags = ["privileged"]; required = ["priv"]; }
    form { mnemonic = "pause"; encoder = "pause"; }
    syntax intel { comment = ";"; separator = ", "; }
    syntax att { order = 1; reg_prefix = "%"; imm_prefix = "$"; comment = "#"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 16; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 8;
            content = "data";
        },
        { name = ".tdata"; flags = ["write", "alloc", "tls", "data"]; align = 8; content = "data"; },
        {
            name = ".tbss";
            flags = ["write", "alloc", "zerofill", "tls", "data"];
            align = 8;
            content = "data";
        },
        { name = ".init"; flags = ["exec", "alloc", "code"]; align = 16; content = "code"; },
        { name = ".fini"; flags = ["exec", "alloc", "code"]; align = 16; content = "code"; },
        { name = ".plt"; flags = ["exec", "alloc", "code"]; align = 16; content = "code"; },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        { name = ".eh_frame"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; },
        { name = ".comment"; flags = ["readonly", "merge", "meta"]; align = 1; content = "meta"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "tls_var"; binding = "tls"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; },
        { name = "hidden_func"; binding = "global"; visibility = "hidden"; symtype = "func"; }
    ];
    reloc R_X86_64_NONE { width = 64; expr = "S + A"; }
    reloc R_X86_64_64 { width = 64; expr = "S + A"; }
    reloc R_X86_64_32 { width = 32; expr = "S + A"; }
    reloc R_X86_64_32S { width = 32; signed = true; expr = "S + A"; }
    reloc R_X86_64_16 { width = 32; expr = "S + A"; }
    reloc R_X86_64_8 { width = 32; expr = "S + A"; }
    reloc R_X86_64_PC8 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_X86_64_PC16 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_X86_64_PC32 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_X86_64_PC64 { width = 64; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_X86_64_PLT32 { width = 32; signed = true; pcrel = true; expr = "PLT(S) + A - P"; }
    reloc R_X86_64_PLTOFF64 { width = 64; expr = "PLT(S) + A"; }
    reloc R_X86_64_GOT32 { width = 32; expr = "GOT(S) + A"; }
    reloc R_X86_64_GOTPCREL { width = 32; signed = true; pcrel = true; expr = "GOT(S) + A - P"; }
    reloc R_X86_64_GOTPCRELX { width = 32; signed = true; pcrel = true; expr = "GOT(S) + A - P"; }
    reloc R_X86_64_REX_GOTPCRELX { width = 32; signed = true; pcrel = true; expr = "GOT(S) + A - P"; }
    reloc R_X86_64_TLSGD { width = 32; signed = true; pcrel = true; expr = "TLS(S) + A - P"; }
    reloc R_X86_64_TLSLD { width = 32; signed = true; pcrel = true; expr = "TLS(S) + A - P"; }
    reloc R_X86_64_TPOFF32 { width = 32; expr = "TLS(S) + A"; }
    reloc R_X86_64_DTPOFF32 { width = 32; expr = "TLS(S) + A"; }
    reloc R_X86_64_GOTTPOFF { width = 32; signed = true; pcrel = true; expr = "TLS(S) + A - P"; }
    reloc R_X86_64_RELATIVE { width = 64; expr = "B + A"; }
    reloc R_X86_64_IRELATIVE { width = 64; expr = "B + A"; }
    reloc R_X86_64_GLOB_DAT { width = 64; expr = "S + A"; }
    reloc R_X86_64_JUMP_SLOT { width = 64; expr = "S + A"; }
    reloc R_X86_64_COPY { width = 64; expr = "S"; }
    debug = [
        { kind = "target"; msg = "x86-64 base + bmi + sse/avx/fma + aes + x87 + priv"; ref = ""; },
        { kind = "form"; msg = "vector forms require sse/avx/fma"; ref = "vaddps"; },
        { kind = "form"; msg = "privileged forms require priv"; ref = "cli"; }
    ];
    asmtk = {
        schema = 1;
        encodings = [
            { mnemonic = "nop"; form = "Fixed"; widths = []; encoder = "nop"; },
            { mnemonic = "ret"; form = "Fixed"; widths = []; encoder = "ret"; },
            { mnemonic = "syscall"; form = "Fixed"; widths = []; encoder = "syscall"; },
            { mnemonic = "int3"; form = "Fixed"; widths = []; opcode = [204]; },
            { mnemonic = "ud2"; form = "Fixed"; widths = []; opcode = [15, 11]; },
            { mnemonic = "cqo"; form = "Fixed"; widths = []; opcode = [72, 153]; },
            { mnemonic = "leave"; form = "Fixed"; widths = []; encoder = "leave"; },
            { mnemonic = "mov"; form = "RegisterRegister"; widths = [32, 64]; encoder = "mov"; },
            { mnemonic = "mov"; form = "RegisterRegister"; widths = [8]; opcode = [136]; },
            { mnemonic = "mov"; form = "Load"; widths = [32, 64]; opcode = [139]; reg_operand = 0; },
            { mnemonic = "mov"; form = "Load"; widths = [8]; opcode = [138]; reg_operand = 0; },
            { mnemonic = "mov"; form = "Store"; widths = [32, 64]; encoder = "mov"; },
            { mnemonic = "mov"; form = "Store"; widths = [8]; opcode = [136]; },
            { mnemonic = "mov"; form = "MoveImmediate"; widths = [32, 64]; encoder = "movimm"; },
            { mnemonic = "mov"; form = "MoveImmediate"; widths = [8]; opcode = [176]; },
            {
                mnemonic = "lea";
                form = "Load";
                widths = [32, 64];
                encoder = "lea";
                reg_operand = 0;
            },
            { mnemonic = "add"; form = "RegisterRegister"; widths = [32, 64]; encoder = "add"; },
            { mnemonic = "sub"; form = "RegisterRegister"; widths = [32, 64]; encoder = "sub"; },
            { mnemonic = "and"; form = "RegisterRegister"; widths = [32, 64]; encoder = "and"; },
            { mnemonic = "or"; form = "RegisterRegister"; widths = [32, 64]; encoder = "or"; },
            { mnemonic = "xor"; form = "RegisterRegister"; widths = [32, 64]; encoder = "xor"; },
            { mnemonic = "cmp"; form = "RegisterRegister"; widths = [32, 64]; encoder = "cmp"; },
            { mnemonic = "test"; form = "RegisterRegister"; widths = [32, 64]; encoder = "test"; },
            { mnemonic = "imul"; form = "RegisterRegister"; widths = [32, 64]; encoder = "imul"; },
            {
                mnemonic = "push";
                form = "OpcodeRegister";
                widths = [64];
                encoder = "push";
                rex_w = false;
            },
            {
                mnemonic = "pop";
                form = "OpcodeRegister";
                widths = [64];
                encoder = "pop";
                rex_w = false;
            },
            {
                mnemonic = "call";
                form = "Indirect";
                widths = [64];
                opcode = [255];
                group = 2;
                rex_w = false;
            },
            {
                mnemonic = "jmp";
                form = "Indirect";
                widths = [64];
                opcode = [255];
                group = 4;
                rex_w = false;
            },
            { mnemonic = "inc"; form = "Unary"; widths = [32, 64]; encoder = "inc"; },
            { mnemonic = "dec"; form = "Unary"; widths = [32, 64]; encoder = "dec"; },
            { mnemonic = "neg"; form = "Unary"; widths = [32, 64]; encoder = "neg"; },
            { mnemonic = "not"; form = "Unary"; widths = [32, 64]; encoder = "not"; },
            { mnemonic = "div"; form = "Unary"; widths = [32, 64]; encoder = "div"; },
            { mnemonic = "idiv"; form = "Unary"; widths = [32, 64]; encoder = "idiv"; },
            {
                mnemonic = "shl";
                form = "ShiftCL";
                widths = [32, 64];
                encoder = "shl";
                implicit_register = "cl";
            },
            {
                mnemonic = "shr";
                form = "ShiftCL";
                widths = [32, 64];
                encoder = "shr";
                implicit_register = "cl";
            },
            {
                mnemonic = "sar";
                form = "ShiftCL";
                widths = [32, 64];
                encoder = "sar";
                implicit_register = "cl";
            },
            {
                mnemonic = "shl";
                form = "ShiftImmediate";
                widths = [32, 64];
                opcode = [193];
                group = 4;
            },
            {
                mnemonic = "shr";
                form = "ShiftImmediate";
                widths = [32, 64];
                opcode = [193];
                group = 5;
            },
            {
                mnemonic = "sar";
                form = "ShiftImmediate";
                widths = [32, 64];
                opcode = [193];
                group = 7;
            },
            {
                mnemonic = "add";
                form = "ArithmeticImmediate";
                widths = [32, 64];
                opcode = [129];
                group = 0;
            },
            {
                mnemonic = "or";
                form = "ArithmeticImmediate";
                widths = [32, 64];
                opcode = [129];
                group = 1;
            },
            {
                mnemonic = "and";
                form = "ArithmeticImmediate";
                widths = [32, 64];
                opcode = [129];
                group = 4;
            },
            {
                mnemonic = "sub";
                form = "ArithmeticImmediate";
                widths = [32, 64];
                opcode = [129];
                group = 5;
            },
            {
                mnemonic = "xor";
                form = "ArithmeticImmediate";
                widths = [32, 64];
                opcode = [129];
                group = 6;
            },
            {
                mnemonic = "cmp";
                form = "ArithmeticImmediate";
                widths = [32, 64];
                opcode = [129];
                group = 7;
            },
            { mnemonic = "call"; form = "Relative"; widths = []; encoder = "call"; relocation = 4; },
            { mnemonic = "jmp"; form = "Relative"; widths = []; encoder = "jmp"; relocation = 2; }
        ];
        conditions = [
            { code = 0; names = ["jo"]; },
            { code = 1; names = ["jno"]; },
            { code = 2; names = ["jb", "jc", "jnae"]; },
            { code = 3; names = ["jae", "jnc", "jnb"]; },
            { code = 4; names = ["je", "jz"]; },
            { code = 5; names = ["jne", "jnz"]; },
            { code = 6; names = ["jbe", "jna"]; },
            { code = 7; names = ["ja", "jnbe"]; },
            { code = 8; names = ["js"]; },
            { code = 9; names = ["jns"]; },
            { code = 10; names = ["jp", "jpe"]; },
            { code = 11; names = ["jnp", "jpo"]; },
            { code = 12; names = ["jl", "jnge"]; },
            { code = 13; names = ["jge", "jnl"]; },
            { code = 14; names = ["jle", "jng"]; },
            { code = 15; names = ["jg", "jnle"]; }
        ];
    };
    metachain = {
        schema = 1;
        scheduling_model = "SkylakeClientModel";
        register_class = "GR64";
        lowering = {
            copy = "mov";
            return = "ret";
            stack_pointer = "rsp";
            accumulator = "rax";
            scratch = "rdx";
        };
        allocation = {
            reserved = ["rsp", "rbp"];
            callee_saved = ["rbx", "rbp", "r12", "r13", "r14", "r15"];
            arguments = ["rdi", "rsi", "rdx", "rcx", "r8", "r9"];
            results = ["rax", "rdx"];
            stack_alignment = 16;
        };
        values = [
            {
                symbol = "add64";
                semantic = "Add";
                mnemonic = "add";
                instruction = "ADD64rr";
                pattern = "X86add_flag";
            },
            {
                symbol = "sub64";
                semantic = "Sub";
                mnemonic = "sub";
                instruction = "SUB64rr";
                pattern = "X86sub_flag";
            },
            {
                symbol = "mul64";
                semantic = "Mul";
                mnemonic = "imul";
                instruction = "IMUL64rr";
                pattern = "X86smul_flag";
            },
            {
                symbol = "and64";
                semantic = "And";
                mnemonic = "and";
                instruction = "AND64rr";
                pattern = "X86and_flag";
            },
            {
                symbol = "or64";
                semantic = "Or";
                mnemonic = "or";
                instruction = "OR64rr";
                pattern = "X86or_flag";
            },
            {
                symbol = "xor64";
                semantic = "Xor";
                mnemonic = "xor";
                instruction = "XOR64rr";
                pattern = "X86xor_flag";
            }
        ];
    };
    backend = { file = "backend/amd64.json"; };
}
