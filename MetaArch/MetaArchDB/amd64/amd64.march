        ];
    }
    form {
        mnemonic = "sar";
        encoder = "sar";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "readwrite"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "andn";
        encoder = "andn";
        required = ["bmi1"];
        operands = [
