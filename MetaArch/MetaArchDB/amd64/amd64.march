    encoder nop { max_bytes = 1; body = "EMIT8 0x90\n"; }
    encoder ret { max_bytes = 1; body = "EMIT8 0xC3\n"; }
    encoder mov { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x89\nEMIT_MODRM src, dst\n"; }
    encoder movimm { max_bytes = 10; body = "EMIT8 0x48\nEMIT8 0xB8 + dst\nEMIT_IMM 8, imm\n"; }
    encoder movzx { max_bytes = 4; body = "EMIT8 0x48\nEMIT8 0x0F\nEMIT8 0xB7\nEMIT_MODRM src, dst\n"; }
    encoder movsx { max_bytes = 4; body = "EMIT8 0x48\nEMIT8 0x0F\nEMIT8 0xBF\nEMIT_MODRM src, dst\n"; }
    encoder xchg { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x87\nEMIT_MODRM src, dst\n"; }
    encoder lea { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x8D\nEMIT_MODRM dst, src\n"; }
    encoder add { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x01\nEMIT_MODRM src, dst\n"; }
    encoder sub { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x29\nEMIT_MODRM src, dst\n"; }
    encoder and { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x21\nEMIT_MODRM src, dst\n"; }
    encoder or { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x09\nEMIT_MODRM src, dst\n"; }
    encoder xor { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x31\nEMIT_MODRM src, dst\n"; }
    encoder adc { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x11\nEMIT_MODRM src, dst\n"; }
    encoder sbb { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x19\nEMIT_MODRM src, dst\n"; }
    encoder cmp { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x39\nEMIT_MODRM src, dst\n"; }
    encoder test { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0x85\nEMIT_MODRM src, dst\n"; }
    encoder inc { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0xFF\nEMIT_MODRM 0, dst\n"; }
    encoder dec { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0xFF\nEMIT_MODRM 1, dst\n"; }
    encoder neg { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0xF7\nEMIT_MODRM 3, dst\n"; }
    encoder not { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0xF7\nEMIT_MODRM 2, dst\n"; }
    encoder imul { max_bytes = 4; body = "EMIT8 0x48\nEMIT8 0x0F\nEMIT8 0xAF\nEMIT_MODRM dst, src\n"; }
    encoder div { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0xF7\nEMIT_MODRM 6, src\n"; }
    encoder idiv { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0xF7\nEMIT_MODRM 7, src\n"; }
    encoder shl { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0xD3\nEMIT_MODRM 4, dst\n"; }
    encoder shr { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0xD3\nEMIT_MODRM 5, dst\n"; }
    encoder sar { max_bytes = 3; body = "EMIT8 0x48\nEMIT8 0xD3\nEMIT_MODRM 7, dst\n"; }
    encoder andn {
        max_bytes = 5;
        body = "EMIT8 0xC4\nEMIT8 0xE2\nEMIT8 0xF0\nEMIT_MODRM src, dst\nEMIT8 0xC0 + src2\n";
    }
    encoder popcnt {
        max_bytes = 5;
        body = "EMIT8 0xF3\nEMIT8 0x48\nEMIT8 0x0F\nEMIT8 0xB8\nEMIT_MODRM src, dst\n";
    }
    encoder tzcnt {
        max_bytes = 5;
        body = "EMIT8 0xF3\nEMIT8 0x48\nEMIT8 0x0F\nEMIT8 0xBC\nEMIT_MODRM src, dst\n";
    }
    encoder push { max_bytes = 1; body = "EMIT8 0x50 + dst\n"; }
    encoder pop { max_bytes = 1; body = "EMIT8 0x58 + dst\n"; }
    encoder pushf { max_bytes = 1; body = "EMIT8 0x9C\n"; }
    encoder popf { max_bytes = 1; body = "EMIT8 0x9D\n"; }
    encoder call {
        max_bytes = 5;
        max_relocs = 1;
        body = "EMIT8 0xE8\nEMIT_IMM 4, 0\nEMIT_RELOCATION sym, R_X86_64_PLT32\n";
    }
    encoder jmp {
        max_bytes = 5;
        max_relocs = 1;
        body = "EMIT8 0xE9\nEMIT_IMM 4, 0\nEMIT_RELOCATION sym, R_X86_64_PC32\n";
    }
    encoder jcc {
        max_bytes = 6;
        max_relocs = 1;
        body = "EMIT8 0x0F\nEMIT8 0x80 + cond\nEMIT_IMM 4, 0\nEMIT_RELOCATION sym, R_X86_64_PC32\n";
    }
    encoder leave { max_bytes = 1; body = "EMIT8 0xC9\n"; }
    encoder syscall { max_bytes = 2; body = "EMIT8 0x0F\nEMIT8 0x05\n"; }
    encoder int { max_bytes = 2; body = "EMIT8 0xCD\nEMIT8 imm\n"; }
    encoder cpuid { max_bytes = 2; body = "EMIT8 0x0F\nEMIT8 0xA2\n"; }
    encoder movaps { max_bytes = 3; body = "EMIT8 0x0F\nEMIT8 0x28\nEMIT_MODRM src, dst\n"; }
    encoder addps { max_bytes = 3; body = "EMIT8 0x0F\nEMIT8 0x58\nEMIT_MODRM src, dst\n"; }
    encoder vaddps {
        max_bytes = 5;
        body = "EMIT8 0xC5\nEMIT8 0xF8\nEMIT8 0x58\nEMIT_MODRM src, dst\nEMIT8 0xC0 + src2\n";
    }
    encoder vfmadd {
        max_bytes = 6;
        body = "EMIT8 0xC4\nEMIT8 0xE2\nEMIT8 0x78\nEMIT8 0x98\nEMIT_MODRM src, dst\nEMIT8 0xC0 + src2\n";
    }
    encoder aesenc {
        max_bytes = 5;
        body = "EMIT8 0x66\nEMIT8 0x0F\nEMIT8 0x38\nEMIT8 0xDC\nEMIT_MODRM src, dst\n";
    }
    encoder fld { max_bytes = 2; body = "EMIT8 0xD9\nEMIT8 0x00 + dst\n"; }
    encoder fadd { max_bytes = 2; body = "EMIT8 0xD8\nEMIT8 0xC0 + dst\n"; }
    encoder rdrnd { max_bytes = 4; body = "EMIT8 0x48\nEMIT8 0x0F\nEMIT8 0xC7\nEMIT_MODRM 6, dst\n"; }
    encoder cli { max_bytes = 1; body = "EMIT8 0xFA\n"; }
    encoder sti { max_bytes = 1; body = "EMIT8 0xFB\n"; }
    encoder hlt { max_bytes = 1; body = "EMIT8 0xF4\n"; }
    encoder pause { max_bytes = 2; body = "EMIT8 0xF3\nEMIT8 0x90\n"; }
