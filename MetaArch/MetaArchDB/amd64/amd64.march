        operands = [{ kind = "reg"; width = 64; class = "gpr"; }, { kind = "reg"; width = 64; class = "gpr"; }];
    }
    form {
        mnemonic = "inc";
        encoder = "inc";
        operands = [{ kind = "reg"; width = 64; class = "gpr"; access = "readwrite"; }];
    }
    form {
        mnemonic = "dec";
        encoder = "dec";
        operands = [{ kind = "reg"; width = 64; class = "gpr"; access = "readwrite"; }];
    }
