            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "tzcnt";
        encoder = "tzcnt";
        required = ["lzcnt"];
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "push";
        encoder = "push";
        operands = [{ kind = "reg"; width = 64; class = "gpr"; }];
    }
    form {
        mnemonic = "pop";
        encoder = "pop";
        operands = [{ kind = "reg"; width = 64; class = "gpr"; access = "write"; }];
    }
    form { mnemonic = "pushf"; encoder = "pushf"; }
    form { mnemonic = "popf"; encoder = "popf"; }
    form {
        mnemonic = "call";
        encoder = "call";
        flags = ["branch", "reloc"];
        operands = [{ kind = "sym"; width = 64; }];
    }
    form {
        mnemonic = "jmp";
        encoder = "jmp";
        flags = ["branch", "terminator", "reloc"];
        operands = [{ kind = "sym"; width = 64; }];
    }
    form {
        mnemonic = "jcc";
        encoder = "jcc";
        flags = ["cond_branch", "reloc"];
        operands = [{ kind = "cond"; width = 8; }, { kind = "sym"; width = 64; }];
    }
    form { mnemonic = "leave"; encoder = "leave"; }
    form { mnemonic = "syscall"; encoder = "syscall"; flags = ["privileged", "may_trap"]; }
    form {
        mnemonic = "int";
        encoder = "int";
        flags = ["may_trap"];
        operands = [{ kind = "imm"; width = 8; imm_min = 0; imm_max = 255; signed = false; }];
    }
    form { mnemonic = "cpuid"; encoder = "cpuid"; }
    form {
        mnemonic = "movaps";
        encoder = "movaps";
        required = ["sse"];
        operands = [
