        encoder = "not";
        operands = [{ kind = "reg"; width = 64; class = "gpr"; access = "readwrite"; }];
    }
    form {
        mnemonic = "imul";
        encoder = "imul";
        operands = [
            { kind = "reg"; width = 64; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 64; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "div";
        encoder = "div";
        flags = ["may_trap"];
        operands = [{ kind = "reg"; width = 64; class = "gpr"; }];
    }
    form {
