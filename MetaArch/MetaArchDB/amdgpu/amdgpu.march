    register a247 { class = "gpr"; width = 32; enc = 247; flags = ["readable", "writable"]; }
    register a248 { class = "gpr"; width = 32; enc = 248; flags = ["readable", "writable"]; }
    register a249 { class = "gpr"; width = 32; enc = 249; flags = ["readable", "writable"]; }
    register a250 { class = "gpr"; width = 32; enc = 250; flags = ["readable", "writable"]; }
    register a251 { class = "gpr"; width = 32; enc = 251; flags = ["readable", "writable"]; }
    register a252 { class = "gpr"; width = 32; enc = 252; flags = ["readable", "writable"]; }
    register a253 { class = "gpr"; width = 32; enc = 253; flags = ["readable", "writable"]; }
    register a254 { class = "gpr"; width = 32; enc = 254; flags = ["readable", "writable"]; }
    register a255 { class = "gpr"; width = 32; enc = 255; flags = ["readable", "writable"]; }
    register exec { class = "mask"; width = 64; enc = 0; flags = ["readable", "writable"]; }
    register vcc { class = "mask"; width = 64; enc = 0; flags = ["readable", "writable"]; }
    register scc { class = "status"; width = 8; enc = 0; flags = ["readable", "writable"]; }
    register m0 { class = "special"; width = 32; enc = 0; flags = ["readable", "writable"]; }
    register flat_scratch { class = "special"; width = 64; enc = 0; flags = ["readable", "writable"]; }
    register xnack_mask { class = "mask"; width = 64; enc = 0; flags = ["readable", "writable"]; }
    register pc { class = "special"; width = 64; enc = 0; }
    mnemonic s_nop {  }
    mnemonic s_add {  }
    mnemonic s_sub {  }
    mnemonic s_and {  }
    mnemonic s_or {  }
    mnemonic s_mov {  }
    mnemonic s_branch {  }
    mnemonic s_cbranch {  }
    mnemonic s_endpgm {  }
    mnemonic s_waitcnt {  }
    mnemonic s_barrier {  }
    mnemonic s_load {  }
    mnemonic s_store {  }
    mnemonic s_getreg {  }
    mnemonic v_add {  }
    mnemonic v_sub {  }
    mnemonic v_mul {  }
    mnemonic v_mov {  }
    mnemonic v_cmp {  }
    mnemonic v_cndmask {  }
    mnemonic flat_load {  }
    mnemonic flat_store {  }
    mnemonic ds_read {  }
    mnemonic ds_write {  }
    mnemonic buffer_load {  }
    mnemonic buffer_store {  }
    mnemonic image_load {  }
    mnemonic mfma {  }
    encoder s_nop { max_bytes = 4; body = "EMIT32LE 0xBF800000\n"; }
    encoder s_add { max_bytes = 4; body = "EMIT32LE 0x81000000 + dst*16777216 + src0*256 + src1\n"; }
    encoder s_sub { max_bytes = 4; body = "EMIT32LE 0x82000000 + dst*16777216 + src0*256 + src1\n"; }
    encoder s_and { max_bytes = 4; body = "EMIT32LE 0x88000000 + dst*16777216 + src0*256 + src1\n"; }
    encoder s_or { max_bytes = 4; body = "EMIT32LE 0x8A000000 + dst*16777216 + src0*256 + src1\n"; }
    encoder s_mov { max_bytes = 4; body = "EMIT32LE 0xBE000000 + dst*16777216 + src0\n"; }
    encoder s_branch {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT32LE 0xBF800002\nEMIT_RELOCATION sym, R_AMDGPU_REL32\n";
    }
    encoder s_cbranch {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT32LE 0xBF840000\nEMIT_RELOCATION sym, R_AMDGPU_REL32\n";
    }
    encoder s_endpgm { max_bytes = 4; body = "EMIT32LE 0xBF810000\n"; }
    encoder s_waitcnt { max_bytes = 4; body = "EMIT32LE 0xBF8C0000 + imm\n"; }
    encoder s_barrier { max_bytes = 4; body = "EMIT32LE 0xBF8A0000\n"; }
    encoder s_load { max_bytes = 4; body = "EMIT32LE 0xC0000000 + dst*16777216 + src0*256\n"; }
    encoder s_store { max_bytes = 4; body = "EMIT32LE 0xC8000000 + src0*256 + src1\n"; }
    encoder s_getreg { max_bytes = 4; body = "EMIT32LE 0xB0000000 + dst*16777216 + src0\n"; }
    encoder v_add { max_bytes = 4; body = "EMIT32LE 0x4A000000 + dst*16777216 + src0*256 + src1\n"; }
    encoder v_sub { max_bytes = 4; body = "EMIT32LE 0x4A800000 + dst*16777216 + src0*256 + src1\n"; }
    encoder v_mul { max_bytes = 4; body = "EMIT32LE 0x4C000000 + dst*16777216 + src0*256 + src1\n"; }
    encoder v_mov { max_bytes = 4; body = "EMIT32LE 0x7E000000 + dst*16777216 + src0\n"; }
    encoder v_cmp { max_bytes = 4; body = "EMIT32LE 0x4F000000 + src0*256 + src1\n"; }
    encoder v_cndmask { max_bytes = 4; body = "EMIT32LE 0x4E000000 + dst*16777216 + src0*256 + src1\n"; }
    encoder flat_load { max_bytes = 8; body = "EMIT64LE 0xDC50000000000000 + dst*16777216 + src0*4294967296\n"; }
    encoder flat_store { max_bytes = 8; body = "EMIT64LE 0xDC70000000000000 + src0*4294967296 + src1*16777216\n"; }
    encoder ds_read { max_bytes = 4; body = "EMIT32LE 0xD8000000 + dst*16777216 + src0*256\n"; }
    encoder ds_write { max_bytes = 4; body = "EMIT32LE 0xD9000000 + src0*256 + src1\n"; }
    encoder buffer_load { max_bytes = 4; body = "EMIT32LE 0xE0000000 + dst*16777216 + src0*256\n"; }
    encoder buffer_store { max_bytes = 4; body = "EMIT32LE 0xE8000000 + src0*256 + src1\n"; }
    encoder image_load { max_bytes = 4; body = "EMIT32LE 0xF0000000 + dst*16777216 + src0*256\n"; }
    encoder mfma { max_bytes = 8; body = "EMIT64LE 0xD000000000000000 + dst*16777216 + src0*4294967296\n"; }
    form { mnemonic = "s_nop"; encoder = "s_nop"; }
    form {
        mnemonic = "s_add";
        encoder = "s_add";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "s_sub";
        encoder = "s_sub";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "s_and";
        encoder = "s_and";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "s_or";
        encoder = "s_or";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "s_mov";
        encoder = "s_mov";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "s_branch";
        encoder = "s_branch";
        flags = ["branch", "terminator", "reloc"];
        operands = [{ kind = "sym"; width = 64; }];
    }
    form {
        mnemonic = "s_cbranch";
        encoder = "s_cbranch";
        flags = ["cond_branch", "reloc"];
        operands = [{ kind = "sym"; width = 64; }];
    }
    form { mnemonic = "s_endpgm"; encoder = "s_endpgm"; flags = ["return", "terminator"]; }
    form {
        mnemonic = "s_waitcnt";
        encoder = "s_waitcnt";
        operands = [{ kind = "imm"; width = 16; imm_min = 0; imm_max = 65535; signed = false; }];
    }
    form { mnemonic = "s_barrier"; encoder = "s_barrier"; }
    form {
        mnemonic = "s_load";
        encoder = "s_load";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "s_store";
        encoder = "s_store";
        flags = ["writes_mem"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "mem"; width = 32; }];
    }
    form {
        mnemonic = "s_getreg";
        encoder = "s_getreg";
        flags = ["privileged"];
        required = ["priv"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "v_add";
        encoder = "v_add";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "v_sub";
        encoder = "v_sub";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "v_mul";
        encoder = "v_mul";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "v_mov";
        encoder = "v_mov";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "v_cmp";
        encoder = "v_cmp";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "v_cndmask";
        encoder = "v_cndmask";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "flat_load";
        encoder = "flat_load";
        flags = ["reads_mem"];
        required = ["flat"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "flat_store";
        encoder = "flat_store";
        flags = ["writes_mem"];
        required = ["flat"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "mem"; width = 32; }];
    }
    form {
        mnemonic = "ds_read";
        encoder = "ds_read";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "ds_write";
        encoder = "ds_write";
        flags = ["writes_mem"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "mem"; width = 32; }];
    }
    form {
        mnemonic = "buffer_load";
        encoder = "buffer_load";
        flags = ["reads_mem"];
        required = ["image"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "buffer_store";
        encoder = "buffer_store";
        flags = ["writes_mem"];
        required = ["image"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "mem"; width = 32; }];
    }
    form {
        mnemonic = "image_load";
        encoder = "image_load";
        flags = ["reads_mem"];
        required = ["image"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "mfma";
        encoder = "mfma";
        required = ["mfma"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    syntax default { comment = ";"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 4; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; },
        {
            name = ".AMDGPU.config";
            flags = ["alloc", "readonly", "meta"];
            align = 4;
            content = "meta";
        },
        {
            name = ".AMDGPU.disasm";
            flags = ["alloc", "readonly", "meta"];
            align = 4;
            content = "meta";
        },
        { name = ".note"; flags = ["alloc", "readonly", "meta"]; align = 4; content = "meta"; }
    ];
    linkages = [
        { name = "kernel_entry"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_local"; binding = "local"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; }
    ];
    reloc R_AMDGPU_NONE { width = 32; expr = "S + A"; }
    reloc R_AMDGPU_ABS32 { width = 32; expr = "S + A"; }
    reloc R_AMDGPU_ABS64 { width = 64; expr = "S + A"; }
    reloc R_AMDGPU_REL32 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_AMDGPU_GOT { width = 64; expr = "GOT(S) + A"; }
    reloc R_AMDGPU_RELATIVE { width = 64; expr = "B + A"; }
    reloc R_AMDGPU_GLOB_DAT { width = 64; expr = "S + A"; }
    debug = [
        {
            kind = "target";
            msg = "amdgpu SIMT: sop+vop+flat/ds/image+mfma stratification";
            ref = "";
        },
        { kind = "form"; msg = "flat forms require flat"; ref = "flat_load"; },
        { kind = "form"; msg = "mfma forms require cdna/mfma"; ref = "mfma"; }
    ];
    backend = { file = "backend/amdgpu.json"; };
}
