# Generated from ArchDB/amdgpu.dsymspec.yaml by tools/compile_archdb.py.
# Regenerate from the YAML source; see MetaArchDB/README.md.
architecture {
    schema = 1;
    target {
        arch = "amdgpu";
        subarch = "gfx900";
        addr_size = 64;
        op_size = 32;
        addr_def = 64;
        align = 4;
        byte_order = "little";
        obj_format = "ELF64";
        abi = "amdgpu-HSA";
        calling_conv = "amdgpu-hsa-kernel";
        features = ["base", "gcn", "wave64"];
    }
    feature base { desc = "scalar SOP base"; }
    feature gcn { desc = "Graphics Core Next"; }
    feature rdna { desc = "RDNA"; }
    feature cdna { desc = "CDNA (matrix cores)"; }
    feature wave32 { desc = "32-lane wavefront"; }
    feature wave64 { desc = "64-lane wavefront"; }
    feature flat { desc = "flat addressing (FLAT/GLOBAL)"; }
    feature xnack { desc = "execute-mask XNACK"; }
    feature priv { desc = "privileged (s_getreg/s_setreg)"; }
    feature image { desc = "image/memory ops (MUBUF/MTBUF/MIMG)"; }
    feature mfma { desc = "matrix-fused multiply-add (CDNA)"; }
