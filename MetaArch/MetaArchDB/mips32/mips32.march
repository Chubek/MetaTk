            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sll";
        encoder = "sll";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 8; imm_min = 0; imm_max = 31; signed = false; }
        ];
    }
    form {
        mnemonic = "srl";
        encoder = "srl";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 8; imm_min = 0; imm_max = 31; signed = false; }
        ];
    }
    form {
        mnemonic = "sra";
        encoder = "sra";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 8; imm_min = 0; imm_max = 31; signed = false; }
        ];
    }
    form {
        mnemonic = "addi";
        encoder = "addi";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; }
        ];
    }
    form {
        mnemonic = "addiu";
        encoder = "addiu";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; }
        ];
    }
    form {
        mnemonic = "lui";
        encoder = "lui";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "imm"; width = 16; imm_min = 0; imm_max = 65535; signed = false; }
        ];
    }
    form {
        mnemonic = "ori";
        encoder = "ori";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 16; imm_min = 0; imm_max = 65535; signed = false; }
        ];
    }
    form {
        mnemonic = "mul";
        encoder = "mul";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "mult";
        encoder = "mult";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "div";
        encoder = "div";
        flags = ["may_trap"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "mfhi";
        encoder = "mfhi";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; access = "write"; }];
    }
    form {
        mnemonic = "mflo";
        encoder = "mflo";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; access = "write"; }];
    }
    form {
        mnemonic = "lw";
        encoder = "lw";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sw";
        encoder = "sw";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "lb";
        encoder = "lb";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "lbu";
        encoder = "lbu";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "lh";
        encoder = "lh";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sb";
        encoder = "sb";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sh";
        encoder = "sh";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "ld";
        encoder = "ld";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sd";
        encoder = "sd";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "mem"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "ll";
        encoder = "ll";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "sc";
        encoder = "sc";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "beq";
        encoder = "beq";
        flags = ["cond_branch", "delayed", "reloc"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "sym"; width = 32; }
        ];
    }
    form {
        mnemonic = "bne";
        encoder = "bne";
        flags = ["cond_branch", "delayed", "reloc"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "sym"; width = 32; }
        ];
    }
    form {
        mnemonic = "j";
        encoder = "j";
        flags = ["branch", "delayed", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "jal";
        encoder = "jal";
        flags = ["branch", "delayed", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "jr";
        encoder = "jr";
        flags = ["branch", "terminator", "delayed"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }];
    }
    form {
        mnemonic = "jalr";
        encoder = "jalr";
        flags = ["branch", "delayed"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form { mnemonic = "syscall"; encoder = "syscall"; flags = ["may_trap"]; }
    form {
        mnemonic = "break";
        encoder = "break";
        flags = ["may_trap"];
        operands = [{ kind = "imm"; width = 20; imm_min = 0; imm_max = 1048575; signed = false; }];
    }
    form { mnemonic = "sync"; encoder = "sync"; }
    form {
        mnemonic = "eret";
        encoder = "eret";
        flags = ["privileged", "return", "terminator"];
        required = ["priv"];
    }
    form {
        mnemonic = "mfc0";
        encoder = "mfc0";
        flags = ["privileged"];
        required = ["priv"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "ctrl"; }
        ];
    }
    form {
        mnemonic = "mtc0";
        encoder = "mtc0";
        flags = ["privileged"];
        required = ["priv"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "ctrl"; }
        ];
    }
    form { mnemonic = "tlbwi"; encoder = "tlbwi"; flags = ["privileged"]; required = ["priv"]; }
    form { mnemonic = "wait"; encoder = "wait"; flags = ["privileged"]; required = ["priv"]; }
    form {
        mnemonic = "add.s";
        encoder = "add_s";
        required = ["fpu"];
        operands = [
            { kind = "reg"; width = 32; class = "fp"; access = "write"; },
            { kind = "reg"; width = 32; class = "fp"; },
            { kind = "reg"; width = 32; class = "fp"; }
        ];
    }
    form {
        mnemonic = "mul.s";
        encoder = "mul_s";
        required = ["fpu"];
        operands = [
            { kind = "reg"; width = 32; class = "fp"; access = "write"; },
            { kind = "reg"; width = 32; class = "fp"; },
            { kind = "reg"; width = 32; class = "fp"; }
        ];
    }
    form {
        mnemonic = "lwc1";
        encoder = "lwc1";
        flags = ["reads_mem"];
        required = ["fpu"];
        operands = [
            { kind = "reg"; width = 32; class = "fp"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "swc1";
        encoder = "swc1";
        flags = ["writes_mem"];
        required = ["fpu"];
        operands = [{ kind = "reg"; width = 32; class = "fp"; }, { kind = "mem"; width = 32; }];
    }
    form {
        mnemonic = "addq.ph";
        encoder = "addq";
        required = ["dsp"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "msa.addv";
        encoder = "msaaddv";
        required = ["msa"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "msa.ld";
        encoder = "msald";
        flags = ["reads_mem"];
        required = ["msa"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "mem"; width = 128; }
        ];
    }
    syntax default { comment = "#"; separator = ", "; }
    syntax numeric { comment = "#"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 8;
            content = "data";
        },
        { name = ".tdata"; flags = ["write", "alloc", "tls", "data"]; align = 8; content = "data"; },
        {
            name = ".mips.options";
            flags = ["alloc", "readonly", "meta"];
            align = 4;
            content = "meta";
        },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        { name = ".eh_frame"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "tls_var"; binding = "tls"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; },
        { name = "micro_func"; binding = "global"; visibility = "default"; symtype = "func"; }
    ];
    reloc R_MIPS_NONE { width = 32; expr = "S + A"; }
    reloc R_MIPS_16 { width = 32; expr = "S + A"; }
    reloc R_MIPS_32 { width = 32; expr = "S + A"; }
    reloc R_MIPS_REL32 { width = 32; expr = "S + A"; }
    reloc R_MIPS_26 { width = 32; expr = "S + A"; }
    reloc R_MIPS_HI16 { width = 32; expr = "S + A"; }
    reloc R_MIPS_LO16 { width = 32; expr = "S + A"; }
    reloc R_MIPS_PC16 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_MIPS_CALL16 { width = 32; signed = true; pcrel = true; expr = "PLT(S) + A - P"; }
    reloc R_MIPS_GOT16 { width = 32; expr = "GOT(S) + A"; }
    reloc R_MIPS_GOT_PAGE { width = 32; expr = "GOT(S) + A"; }
    reloc R_MIPS_TLS_GD { width = 32; expr = "TLS(S) + A"; }
    reloc R_MIPS_TLS_LDM { width = 32; expr = "TLS(S) + A"; }
    reloc R_MIPS_TLS_TPREL_HI16 { width = 32; expr = "TLS(S) + A"; }
    reloc R_MIPS_TLS_TPREL_LO16 { width = 32; expr = "TLS(S) + A"; }
    reloc R_MIPS_JALR { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_MIPS_JUMP_SLOT { width = 32; expr = "S + A"; }
    reloc R_MIPS_GLOB_DAT { width = 32; expr = "S + A"; }
    reloc R_MIPS_RELATIVE { width = 32; expr = "B + A"; }
    reloc R_MIPS_GOT_DISP { width = 32; expr = "GOT(S) + A"; }
    debug = [
        { kind = "target"; msg = "mips32r2 base+fpu+dsp/msa+priv(delayed branches)"; ref = ""; },
        { kind = "form"; msg = "delayed branch forms carry delayed flag"; ref = "j"; },
        { kind = "form"; msg = "privileged CP0/TLB forms need priv"; ref = "eret"; }
    ];
    backend = { file = "backend/mips32.json"; };
}
