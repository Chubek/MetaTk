# Generated from ArchDB/m68k.dsymspec.yaml by tools/compile_archdb.py.
# Regenerate from the YAML source; see MetaArchDB/README.md.
architecture {
    schema = 1;
    target {
        arch = "m68k";
        subarch = "68020";
        addr_size = 32;
        op_size = 32;
        addr_def = 32;
        align = 2;
        byte_order = "big";
        obj_format = "ELF32";
        abi = "SystemV";
        calling_conv = "m68k-cdecl";
        features = ["68000", "68020", "fpu"];
    }
    features = [
        { name = "68000"; desc = "MC68000 base"; },
        { name = "68010"; desc = "MC68010 (loop/move16?/full MMU)"; },
        { name = "68020"; desc = "MC68020 (bitfield/cas/bfins)"; },
        { name = "68040"; desc = "MC68040 (FPU integrated)"; },
        { name = "68060"; desc = "MC68060"; },
        { name = "coldfire"; desc = "ColdFire subset"; },
        { name = "fpu"; desc = "68881/68882 FPU"; },
        { name = "mmu"; desc = "paged MMU (PFLUSH/PMOVE)"; },
        { name = "bitfield"; desc = "bitfield instructions"; },
        { name = "cas"; desc = "compare-and-swap (CAS/CAS2)"; },
        { name = "priv"; desc = "privileged (MOVEC/MOVES/RTE)"; }
    ];
    register d0 { class = "gpr"; width = 32; enc = 0; flags = ["readable", "writable"]; }
    register d1 { class = "gpr"; width = 32; enc = 1; flags = ["readable", "writable"]; }
    register d2 { class = "gpr"; width = 32; enc = 2; flags = ["readable", "writable"]; }
    register d3 { class = "gpr"; width = 32; enc = 3; flags = ["readable", "writable"]; }
    register d4 { class = "gpr"; width = 32; enc = 4; flags = ["readable", "writable"]; }
    register d5 { class = "gpr"; width = 32; enc = 5; flags = ["readable", "writable"]; }
    register d6 { class = "gpr"; width = 32; enc = 6; flags = ["readable", "writable"]; }
    register d7 { class = "gpr"; width = 32; enc = 7; flags = ["readable", "writable"]; }
    register a0 { class = "gpr"; width = 32; enc = 8; flags = ["readable", "writable"]; }
    register a1 { class = "gpr"; width = 32; enc = 9; flags = ["readable", "writable"]; }
    register a2 { class = "gpr"; width = 32; enc = 10; flags = ["readable", "writable"]; }
    register a3 { class = "gpr"; width = 32; enc = 11; flags = ["readable", "writable"]; }
    register a4 { class = "gpr"; width = 32; enc = 12; flags = ["readable", "writable"]; }
    register a5 { class = "gpr"; width = 32; enc = 13; flags = ["readable", "writable"]; }
    register a6 { class = "gpr"; width = 32; enc = 14; flags = ["readable", "writable"]; }
    register a7 { class = "gpr"; width = 32; enc = 15; flags = ["readable", "writable"]; }
    register fp0 { class = "fp"; width = 80; enc = 0; flags = ["readable", "writable"]; }
    register fp1 { class = "fp"; width = 80; enc = 1; flags = ["readable", "writable"]; }
    register fp2 { class = "fp"; width = 80; enc = 2; flags = ["readable", "writable"]; }
    register fp3 { class = "fp"; width = 80; enc = 3; flags = ["readable", "writable"]; }
    register fp4 { class = "fp"; width = 80; enc = 4; flags = ["readable", "writable"]; }
    register fp5 { class = "fp"; width = 80; enc = 5; flags = ["readable", "writable"]; }
    register fp6 { class = "fp"; width = 80; enc = 6; flags = ["readable", "writable"]; }
    register fp7 { class = "fp"; width = 80; enc = 7; flags = ["readable", "writable"]; }
    register sp { class = "gpr"; width = 32; enc = 15; flags = ["readable", "writable"]; }
    register usp { class = "gpr"; width = 32; enc = 15; flags = ["readable", "writable", "modedep"]; }
    register ssp { class = "gpr"; width = 32; enc = 15; flags = ["readable", "writable", "modedep"]; }
    register pc { class = "special"; width = 32; enc = 0; }
    register sr { class = "status"; width = 16; enc = 0; }
    register ccr { class = "status"; width = 8; enc = 0; parent = "sr"; sub_lo = 0; sub_hi = 8; }
    register fpiar { class = "ctrl"; width = 32; enc = 0; }
    register fpcr { class = "ctrl"; width = 32; enc = 0; }
    register fpsr { class = "status"; width = 32; enc = 0; }
    register sfc { class = "ctrl"; width = 32; enc = 0; flags = ["modedep"]; }
    register dfc { class = "ctrl"; width = 32; enc = 0; flags = ["modedep"]; }
    register vbr { class = "ctrl"; width = 32; enc = 0; flags = ["modedep"]; }
    mnemonic nop {  }
    mnemonic move {  }
    mnemonic add {  }
    mnemonic sub {  }
    mnemonic and {  }
    mnemonic or {  }
    mnemonic eor {  }
    mnemonic cmp {  }
    mnemonic tst {  }
    mnemonic neg {  }
    mnemonic not {  }
    mnemonic clr {  }
    mnemonic ext {  }
    mnemonic swap {  }
    mnemonic lea {  }
    mnemonic pea {  }
    mnemonic link {  }
    mnemonic unlk {  }
    mnemonic movem {  }
    mnemonic addq {  }
    mnemonic subq {  }
    mnemonic lsl {  }
    mnemonic lsr {  }
    mnemonic asl {  }
    mnemonic asr {  }
    mnemonic rol {  }
    mnemonic muls {  }
    mnemonic mulu {  }
    mnemonic divs {  }
    mnemonic divu {  }
    mnemonic bra {  }
    mnemonic bcc {  }
    mnemonic bsr {  }
    mnemonic jmp {  }
    mnemonic jsr {  }
    mnemonic rts {  }
    mnemonic rte {  }
    mnemonic trap {  }
    mnemonic chk {  }
    mnemonic tas {  }
    mnemonic cas {  }
    mnemonic bfset {  }
    mnemonic fadd {  }
    mnemonic fmove {  }
    mnemonic movec {  }
    mnemonic stop {  }
    mnemonic reset {  }
    encoder nop { max_bytes = 2; body = "EMIT16BE 0x4E71\n"; }
    encoder move { max_bytes = 10; body = "EMIT16BE 0x3000 + dst*512 + src\n"; }
    encoder add { max_bytes = 10; body = "EMIT16BE 0xD000 + dst*512 + src\n"; }
    encoder sub { max_bytes = 10; body = "EMIT16BE 0x9000 + dst*512 + src\n"; }
    encoder and { max_bytes = 10; body = "EMIT16BE 0xC000 + dst*512 + src\n"; }
    encoder or { max_bytes = 10; body = "EMIT16BE 0x8000 + dst*512 + src\n"; }
    encoder eor { max_bytes = 10; body = "EMIT16BE 0xB100 + dst*512 + src\n"; }
    encoder cmp { max_bytes = 10; body = "EMIT16BE 0xB000 + dst*512 + src\n"; }
    encoder tst { max_bytes = 6; body = "EMIT16BE 0x4A00 + dst\n"; }
    encoder neg { max_bytes = 6; body = "EMIT16BE 0x4400 + dst\n"; }
    encoder not { max_bytes = 6; body = "EMIT16BE 0x4600 + dst\n"; }
    encoder clr { max_bytes = 6; body = "EMIT16BE 0x4200 + dst\n"; }
    encoder ext { max_bytes = 2; body = "EMIT16BE 0x4800 + dst\n"; }
    encoder swap { max_bytes = 2; body = "EMIT16BE 0x4840 + dst\n"; }
    encoder lea { max_bytes = 6; body = "EMIT16BE 0x41C0 + dst*512 + src\nEMIT16BE imm\n"; }
    encoder pea { max_bytes = 6; body = "EMIT16BE 0x4840 + src\n"; }
    encoder link { max_bytes = 4; body = "EMIT16BE 0x4E50 + dst\nEMIT16BE imm\n"; }
    encoder unlk { max_bytes = 2; body = "EMIT16BE 0x4E58 + dst\n"; }
    encoder movem { max_bytes = 6; body = "EMIT16BE 0x48C0 + rlist + ea\n"; }
    encoder addq { max_bytes = 6; body = "EMIT16BE 0x5000 + ((imm + 8) % 8)*512 + dst\n"; }
    encoder subq { max_bytes = 6; body = "EMIT16BE 0x5100 + ((imm + 8) % 8)*512 + dst\n"; }
    encoder lsl { max_bytes = 4; body = "EMIT16BE 0xE100 + dst*512 + src\n"; }
    encoder lsr { max_bytes = 4; body = "EMIT16BE 0xE080 + dst*512 + src\n"; }
    encoder asl { max_bytes = 4; body = "EMIT16BE 0xE120 + dst*512 + src\n"; }
    encoder asr { max_bytes = 4; body = "EMIT16BE 0xE0A0 + dst*512 + src\n"; }
    encoder rol { max_bytes = 4; body = "EMIT16BE 0xE190 + dst*512 + src\n"; }
    encoder muls { max_bytes = 6; body = "EMIT16BE 0xC1C0 + dst*512 + src\n"; }
    encoder mulu { max_bytes = 6; body = "EMIT16BE 0xC0C0 + dst*512 + src\n"; }
    encoder divs { max_bytes = 6; body = "EMIT16BE 0x81C0 + dst*512 + src\n"; }
    encoder divu { max_bytes = 6; body = "EMIT16BE 0x80C0 + dst*512 + src\n"; }
    encoder bra { max_bytes = 4; max_relocs = 1; body = "EMIT16BE 0x6000\nEMIT_RELOCATION sym, R_68K_PC16\n"; }
    encoder bcc {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT16BE 0x6100 + cond*256\nEMIT_RELOCATION sym, R_68K_PC16\n";
    }
    encoder bsr { max_bytes = 4; max_relocs = 1; body = "EMIT16BE 0x6100\nEMIT_RELOCATION sym, R_68K_PC16\n"; }
    encoder jmp { max_bytes = 6; body = "EMIT16BE 0x4EC0 + src\n"; }
    encoder jsr { max_bytes = 6; max_relocs = 1; body = "EMIT16BE 0x4E80\nEMIT_RELOCATION sym, R_68K_PC32\n"; }
    encoder rts { max_bytes = 2; body = "EMIT16BE 0x4E75\n"; }
    encoder rte { max_bytes = 2; body = "EMIT16BE 0x4E73\n"; }
    encoder trap { max_bytes = 2; body = "EMIT16BE 0x4E40 + (imm % 16)\n"; }
    encoder chk { max_bytes = 6; body = "EMIT16BE 0x4180 + dst*512 + src\n"; }
    encoder tas { max_bytes = 6; body = "EMIT16BE 0x4AC0 + dst\n"; }
    encoder cas { max_bytes = 10; body = "EMIT16BE 0x0E00 + dst*512 + src + ea\n"; }
    encoder bfset { max_bytes = 8; body = "EMIT16BE 0xEAC0 + dst*512 + src\n"; }
    encoder fadd { max_bytes = 6; body = "EMIT16BE 0xF200\nEMIT16BE 0x0022 + dst*64 + src\n"; }
    encoder fmove { max_bytes = 6; body = "EMIT16BE 0xF200\nEMIT16BE 0x0000 + dst*64 + src\n"; }
    encoder movec { max_bytes = 4; body = "EMIT32BE 0x4E7A0800 + dst*4096 + src\n"; }
    encoder stop { max_bytes = 4; body = "EMIT16BE 0x4E72\nEMIT16BE imm\n"; }
    encoder reset { max_bytes = 2; body = "EMIT16BE 0x4E70\n"; }
    form { mnemonic = "nop"; encoder = "nop"; }
    form {
        mnemonic = "move";
        encoder = "move";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "add";
        encoder = "add";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; },
