    }
    form {
        mnemonic = "jsr";
        encoder = "jsr";
        flags = ["branch", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form { mnemonic = "rts"; encoder = "rts"; flags = ["return", "terminator"]; }
    form {
        mnemonic = "rte";
        encoder = "rte";
        flags = ["privileged", "return", "terminator"];
        required = ["priv"];
    }
    form {
        mnemonic = "trap";
        encoder = "trap";
        flags = ["may_trap"];
        operands = [{ kind = "imm"; width = 8; imm_min = 0; imm_max = 15; signed = false; }];
    }
    form {
        mnemonic = "chk";
        encoder = "chk";
        flags = ["may_trap"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "reg"; width = 32; class = "gpr"; }];
