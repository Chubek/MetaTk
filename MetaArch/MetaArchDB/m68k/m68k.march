            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 2;
            content = "data";
        },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 4; content = "data"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; }
    ];
    reloc R_68K_NONE { width = 32; expr = "S + A"; }
    reloc R_68K_32 { width = 32; expr = "S + A"; }
    reloc R_68K_16 { width = 16; expr = "S + A"; }
    reloc R_68K_8 { width = 8; expr = "S + A"; }
    reloc R_68K_PC8 { width = 8; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_68K_PC16 { width = 16; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_68K_PC32 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_68K_GOT8 { width = 8; expr = "GOT(S) + A"; }
    reloc R_68K_GOT16 { width = 16; expr = "GOT(S) + A"; }
    reloc R_68K_GOT32 { width = 32; expr = "GOT(S) + A"; }
    reloc R_68K_PLT16 { width = 16; signed = true; pcrel = true; expr = "PLT(S) + A - P"; }
    reloc R_68K_PLT32 { width = 32; signed = true; pcrel = true; expr = "PLT(S) + A - P"; }
    reloc R_68K_TLS_GD16 { width = 16; expr = "TLS(S) + A"; }
    reloc R_68K_TLS_GD32 { width = 32; expr = "TLS(S) + A"; }
    reloc R_68K_GLOB_DAT { width = 32; expr = "S"; }
    reloc R_68K_JMP_SLOT { width = 32; expr = "S"; }
    reloc R_68K_RELATIVE { width = 32; expr = "B + A"; }
    debug = [
        {
            kind = "target";
            msg = "m68k 68000..68060+fpu+mmu+bitfield+cas stratification";
            ref = "";
        },
        { kind = "form"; msg = "bitfield forms require bitfield"; ref = "bfset"; },
        { kind = "form"; msg = "privileged forms require priv"; ref = "rte"; }
    ];
    backend = { file = "backend/m68k.json"; };
}
