        encoder = "swap";
        operands = [{ kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; }];
    }
    form {
        mnemonic = "lea";
        encoder = "lea";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
