        ];
    }
    form {
        mnemonic = "subq";
        encoder = "subq";
        operands = [
            { kind = "imm"; width = 8; imm_min = 1; imm_max = 8; signed = false; },
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; }
        ];
    }
    form {
        mnemonic = "lsl";
        encoder = "lsl";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "readwrite"; },
