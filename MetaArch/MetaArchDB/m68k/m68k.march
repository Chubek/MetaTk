    form { mnemonic = "reset"; encoder = "reset"; flags = ["privileged"]; required = ["priv"]; }
    syntax default { comment = ";"; separator = ", "; }
    syntax mit { comment = "|"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 2; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 2; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 2; content = "data"; },
