    encoder beq {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT32LE 0x58000000 + rj*1024 + rd*32\nEMIT_RELOCATION sym, R_LARCH_B16\n";
    }
    encoder bne {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT32LE 0x5C000000 + rj*1024 + rd*32\nEMIT_RELOCATION sym, R_LARCH_B16\n";
    }
    encoder jirl {
        max_bytes = 4;
        body = "EMIT32LE 0x4C000000 + rd*32 + rj*1024 + ((imm + 65536) % 65536)*65536\n";
    }
    encoder ret { max_bytes = 4; body = "EMIT32LE 0x4C000020\n"; }
    encoder syscall { max_bytes = 4; body = "EMIT32LE 0x002B0000\n"; }
    encoder break { max_bytes = 4; body = "EMIT32LE 0x002A0000 + (imm % 32768)\n"; }
    encoder dbar { max_bytes = 4; body = "EMIT32LE 0x38744000 + (imm % 32768)\n"; }
    encoder ibar { max_bytes = 4; body = "EMIT32LE 0x38748000 + (imm % 32768)\n"; }
    encoder llw { max_bytes = 4; body = "EMIT32LE 0x20000000 + rd*32 + rj*1024\n"; }
    encoder scw { max_bytes = 4; body = "EMIT32LE 0x21000000 + rd*32 + rj*1024\n"; }
    encoder amswapw { max_bytes = 4; body = "EMIT32LE 0x38540000 + rd*32 + rj*1024 + rk*32768\n"; }
    encoder csrrd { max_bytes = 4; body = "EMIT32LE 0x04000000 + rd*32 + ((imm + 16384) % 16384)*1024\n"; }
    encoder csrwr { max_bytes = 4; body = "EMIT32LE 0x04001000 + rd*32 + ((imm + 16384) % 16384)*1024\n"; }
    encoder ertn { max_bytes = 4; body = "EMIT32LE 0x064DFC00\n"; }
    encoder fadds { max_bytes = 4; body = "EMIT32LE 0x06000000 + rd*32 + rj*1024 + rk*32768\n"; }
    encoder fmuls { max_bytes = 4; body = "EMIT32LE 0x06020000 + rd*32 + rj*1024 + rk*32768\n"; }
    encoder faddd { max_bytes = 4; body = "EMIT32LE 0x06100000 + rd*32 + rj*1024 + rk*32768\n"; }
    encoder flds {
        max_bytes = 4;
        body = "EMIT32LE 0x2C000000 + rd*32 + rj*1024 + ((imm + 4096) % 4096)*65536\n";
    }
    encoder fsts {
        max_bytes = 4;
        body = "EMIT32LE 0x2D000000 + rd*32 + rj*1024 + ((imm + 4096) % 4096)*65536\n";
    }
    encoder vadd { max_bytes = 4; body = "EMIT32LE 0x70000000 + rd*32 + rj*1024 + rk*32768\n"; }
    encoder vld { max_bytes = 4; body = "EMIT32LE 0x74000000 + rd*32 + rj*1024\n"; }
    encoder xvadd { max_bytes = 4; body = "EMIT32LE 0x75800000 + rd*32 + rj*1024 + rk*32768\n"; }
    form { mnemonic = "nop"; encoder = "nop"; }
    form {
        mnemonic = "add.w";
        encoder = "add";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sub.w";
        encoder = "sub";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "and";
        encoder = "and";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "or";
        encoder = "or";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "xor";
        encoder = "xor";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "nor";
        encoder = "nor";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "slt";
        encoder = "slt";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "addi.w";
        encoder = "addi";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; }
        ];
    }
    form {
        mnemonic = "lu12i.w";
        encoder = "lu12iw";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "imm"; width = 20; imm_min = -524288; imm_max = 524287; signed = true; }
        ];
    }
    form {
        mnemonic = "slli.w";
        encoder = "slli";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 8; imm_min = 0; imm_max = 31; signed = false; }
        ];
    }
    form {
        mnemonic = "srli.w";
        encoder = "srli";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 8; imm_min = 0; imm_max = 31; signed = false; }
        ];
    }
    form {
        mnemonic = "srai.w";
        encoder = "srai";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 8; imm_min = 0; imm_max = 31; signed = false; }
        ];
    }
    form {
        mnemonic = "mul.w";
        encoder = "mul";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "div.w";
        encoder = "div";
        flags = ["may_trap"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "ld.w";
        encoder = "ldw";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "st.w";
        encoder = "stw";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "mem"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "ld.d";
        encoder = "ldd";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "st.d";
        encoder = "std";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "mem"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "ld.b";
        encoder = "ldb";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "st.b";
        encoder = "stb";
        flags = ["writes_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "mem"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "preld";
        encoder = "preld";
        operands = [
            { kind = "imm"; width = 8; imm_min = 0; imm_max = 31; signed = false; },
            { kind = "mem"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "b";
        encoder = "b";
        flags = ["branch", "terminator", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "bl";
        encoder = "bl";
        flags = ["branch", "reloc"];
        operands = [{ kind = "sym"; width = 32; }];
    }
    form {
        mnemonic = "beq";
        encoder = "beq";
        flags = ["cond_branch", "reloc"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "sym"; width = 32; }
        ];
    }
    form {
        mnemonic = "bne";
        encoder = "bne";
        flags = ["cond_branch", "reloc"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "sym"; width = 32; }
        ];
    }
    form {
        mnemonic = "jirl";
        encoder = "jirl";
        flags = ["branch"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 16; imm_min = -32768; imm_max = 32767; signed = true; }
        ];
    }
    form { mnemonic = "ret"; encoder = "ret"; flags = ["return", "terminator"]; }
    form { mnemonic = "syscall"; encoder = "syscall"; flags = ["may_trap"]; }
    form {
        mnemonic = "break";
        encoder = "break";
        flags = ["may_trap"];
        operands = [{ kind = "imm"; width = 16; imm_min = 0; imm_max = 32767; signed = false; }];
    }
    form {
        mnemonic = "dbar";
        encoder = "dbar";
        operands = [{ kind = "imm"; width = 16; imm_min = 0; imm_max = 32767; signed = false; }];
    }
    form {
        mnemonic = "ibar";
        encoder = "ibar";
        operands = [{ kind = "imm"; width = 16; imm_min = 0; imm_max = 32767; signed = false; }];
    }
    form {
        mnemonic = "ll.w";
        encoder = "llw";
        flags = ["reads_mem"];
        required = ["atomics"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "sc.w";
        encoder = "scw";
        flags = ["writes_mem"];
        required = ["atomics"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "amswap.w";
        encoder = "amswapw";
        flags = ["reads_mem", "writes_mem"];
        required = ["atomics"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "csrrd";
        encoder = "csrrd";
        flags = ["privileged"];
        required = ["priv"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "imm"; width = 16; imm_min = 0; imm_max = 16383; signed = false; }
        ];
    }
    form {
        mnemonic = "csrwr";
        encoder = "csrwr";
        flags = ["privileged"];
        required = ["priv"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 16; imm_min = 0; imm_max = 16383; signed = false; }
        ];
    }
    form {
        mnemonic = "ertn";
        encoder = "ertn";
        flags = ["privileged", "return", "terminator"];
        required = ["priv"];
    }
    form {
        mnemonic = "fadd.s";
        encoder = "fadds";
        required = ["f32"];
        operands = [
            { kind = "reg"; width = 32; class = "fp"; access = "write"; },
            { kind = "reg"; width = 32; class = "fp"; },
            { kind = "reg"; width = 32; class = "fp"; }
        ];
    }
    form {
        mnemonic = "fmul.s";
        encoder = "fmuls";
        required = ["f32"];
        operands = [
            { kind = "reg"; width = 32; class = "fp"; access = "write"; },
            { kind = "reg"; width = 32; class = "fp"; },
            { kind = "reg"; width = 32; class = "fp"; }
        ];
    }
    form {
        mnemonic = "fadd.d";
        encoder = "faddd";
        required = ["f64"];
        operands = [
            { kind = "reg"; width = 64; class = "fp"; access = "write"; },
            { kind = "reg"; width = 64; class = "fp"; },
            { kind = "reg"; width = 64; class = "fp"; }
        ];
    }
    form {
        mnemonic = "fld.s";
        encoder = "flds";
        flags = ["reads_mem"];
        required = ["f32"];
        operands = [
            { kind = "reg"; width = 32; class = "fp"; access = "write"; },
            { kind = "mem"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "fst.s";
        encoder = "fsts";
        flags = ["writes_mem"];
        required = ["f32"];
        operands = [
            { kind = "reg"; width = 32; class = "fp"; },
            { kind = "mem"; width = 12; imm_min = -2048; imm_max = 2047; signed = true; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "vadd";
        encoder = "vadd";
        required = ["lsx"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "reg"; width = 128; class = "vec"; },
            { kind = "reg"; width = 128; class = "vec"; }
        ];
    }
    form {
        mnemonic = "vld";
        encoder = "vld";
        flags = ["reads_mem"];
        required = ["lsx"];
        operands = [
            { kind = "reg"; width = 128; class = "vec"; access = "write"; },
            { kind = "mem"; width = 128; }
        ];
    }
    form {
        mnemonic = "xvadd";
        encoder = "xvadd";
        required = ["lasx"];
        operands = [
            { kind = "reg"; width = 256; class = "vec"; access = "write"; },
            { kind = "reg"; width = 256; class = "vec"; },
            { kind = "reg"; width = 256; class = "vec"; }
        ];
    }
    syntax default { comment = "#"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 4; content = "code"; },
        { name = ".rodata"; flags = ["alloc", "readonly", "data"]; align = 4; content = "data"; },
        { name = ".data"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        {
            name = ".bss";
            flags = ["write", "alloc", "zerofill", "data"];
            align = 8;
            content = "data";
        },
        { name = ".tdata"; flags = ["write", "alloc", "tls", "data"]; align = 8; content = "data"; },
        { name = ".got"; flags = ["write", "alloc", "data"]; align = 8; content = "data"; },
        { name = ".eh_frame"; flags = ["alloc", "readonly", "data"]; align = 8; content = "data"; }
    ];
    linkages = [
        { name = "func_global"; binding = "global"; visibility = "default"; symtype = "func"; },
        { name = "func_weak"; binding = "weak"; visibility = "default"; symtype = "func"; },
        { name = "object_global"; binding = "global"; visibility = "default"; symtype = "object"; },
        { name = "tls_var"; binding = "tls"; visibility = "default"; symtype = "object"; },
        { name = "local_sym"; binding = "local"; visibility = "default"; symtype = "none"; }
    ];
    reloc R_LARCH_NONE { width = 32; expr = "S + A"; }
    reloc R_LARCH_32 { width = 32; expr = "S + A"; }
    reloc R_LARCH_64 { width = 32; expr = "S + A"; }
    reloc R_LARCH_B16 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_LARCH_B21 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_LARCH_B26 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_LARCH_ABS_HI20 { width = 32; expr = "S + A"; }
    reloc R_LARCH_ABS_LO12 { width = 32; expr = "S + A"; }
    reloc R_LARCH_PCREL_HI20 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_LARCH_PCREL_LO12 { width = 32; signed = true; pcrel = true; expr = "S + A - P"; }
    reloc R_LARCH_GOT_PC_HI20 { width = 32; signed = true; pcrel = true; expr = "GOT(S) + A - P"; }
    reloc R_LARCH_GOT_PC_LO12 { width = 32; signed = true; pcrel = true; expr = "GOT(S) + A - P"; }
    reloc R_LARCH_TLS_LE_HI20 { width = 32; expr = "TLS(S) + A"; }
    reloc R_LARCH_TLS_LE_LO12 { width = 32; expr = "TLS(S) + A"; }
    reloc R_LARCH_TLS_IE_PC_HI20 { width = 32; signed = true; pcrel = true; expr = "TLS(S) + A - P"; }
    reloc R_LARCH_TLS_GD_PC_HI20 { width = 32; signed = true; pcrel = true; expr = "TLS(S) + A - P"; }
    reloc R_LARCH_RELATIVE { width = 32; expr = "B + A"; }
    reloc R_LARCH_GLOB_DAT { width = 32; expr = "S + A"; }
    reloc R_LARCH_JUMP_SLOT { width = 32; expr = "S + A"; }
    reloc R_LARCH_IRELATIVE { width = 32; expr = "B + A"; }
    debug = [
        { kind = "target"; msg = "la32 base+fpu+lsx+atomics+priv stratification"; ref = ""; },
        { kind = "form"; msg = "vector forms require lsx/lasx"; ref = "vadd"; },
        { kind = "form"; msg = "privileged CSR forms need priv"; ref = "csrrd"; }
    ];
    backend = { file = "backend/loongarch32.json"; };
}
