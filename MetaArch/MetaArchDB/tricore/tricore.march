        ];
    }
    form {
        mnemonic = "mul";
        encoder = "mul";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "madd";
        encoder = "madd";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sh";
        encoder = "sh";
        operands = [
