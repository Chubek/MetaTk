    }
    form { mnemonic = "ret"; encoder = "ret"; flags = ["return", "terminator"]; }
    form {
        mnemonic = "bisr";
        encoder = "bisr";
        operands = [{ kind = "imm"; width = 8; imm_min = 0; imm_max = 255; signed = false; }];
    }
    form {
        mnemonic = "syscall";
        encoder = "syscall";
        flags = ["may_trap"];
        operands = [{ kind = "imm"; width = 16; imm_min = 0; imm_max = 65535; signed = false; }];
    }
