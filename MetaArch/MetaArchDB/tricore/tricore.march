# Generated from ArchDB/tricore.dsymspec.yaml by tools/compile_archdb.py.
# Regenerate from the YAML source; see MetaArchDB/README.md.
architecture {
    schema = 1;
    target {
        arch = "tricore";
        subarch = "tc1.6";
        addr_size = 32;
        op_size = 32;
        addr_def = 32;
        align = 2;
        byte_order = "little";
        obj_format = "ELF32";
        abi = "TriCore-EABI";
        calling_conv = "tricore-eabi";
        features = ["base", "fpu"];
    }
    feature base { desc = "TriCore base integer"; }
    feature fpu { desc = "floating-point unit"; }
    feature simd1 { desc = "SIMD packed arithmetic 1"; }
    feature simd2 { desc = "SIMD packed arithmetic 2"; }
    feature pcp { desc = "Peripheral Control Processor"; }
    feature saturation { desc = "saturating arithmetic"; }
    feature bitops { desc = "bit operations (extr/ins)"; }
    feature loops { desc = "zero-overhead loops"; }
    feature mmu { desc = "MMU (vm/vmt)"; }
    feature priv { desc = "privileged (PSW/CSFR access)"; }
    register d0 { class = "gpr"; width = 32; enc = 0; flags = ["readable", "writable"]; }
    register d1 { class = "gpr"; width = 32; enc = 1; flags = ["readable", "writable"]; }
    register d2 { class = "gpr"; width = 32; enc = 2; flags = ["readable", "writable"]; }
    register d3 { class = "gpr"; width = 32; enc = 3; flags = ["readable", "writable"]; }
    register d4 { class = "gpr"; width = 32; enc = 4; flags = ["readable", "writable"]; }
    register d5 { class = "gpr"; width = 32; enc = 5; flags = ["readable", "writable"]; }
    register d6 { class = "gpr"; width = 32; enc = 6; flags = ["readable", "writable"]; }
    register d7 { class = "gpr"; width = 32; enc = 7; flags = ["readable", "writable"]; }
    register d8 { class = "gpr"; width = 32; enc = 8; flags = ["readable", "writable"]; }
    register d9 { class = "gpr"; width = 32; enc = 9; flags = ["readable", "writable"]; }
    register d10 { class = "gpr"; width = 32; enc = 10; flags = ["readable", "writable"]; }
    register d11 { class = "gpr"; width = 32; enc = 11; flags = ["readable", "writable"]; }
    register d12 { class = "gpr"; width = 32; enc = 12; flags = ["readable", "writable"]; }
    register d13 { class = "gpr"; width = 32; enc = 13; flags = ["readable", "writable"]; }
    register d14 { class = "gpr"; width = 32; enc = 14; flags = ["readable", "writable"]; }
    register d15 { class = "gpr"; width = 32; enc = 15; flags = ["readable", "writable"]; }
    register a0 { class = "gpr"; width = 32; enc = 0; flags = ["readable", "writable"]; }
    register a1 { class = "gpr"; width = 32; enc = 1; flags = ["readable", "writable"]; }
    register a2 { class = "gpr"; width = 32; enc = 2; flags = ["readable", "writable"]; }
    register a3 { class = "gpr"; width = 32; enc = 3; flags = ["readable", "writable"]; }
    register a4 { class = "gpr"; width = 32; enc = 4; flags = ["readable", "writable"]; }
    register a5 { class = "gpr"; width = 32; enc = 5; flags = ["readable", "writable"]; }
    register a6 { class = "gpr"; width = 32; enc = 6; flags = ["readable", "writable"]; }
    register a7 { class = "gpr"; width = 32; enc = 7; flags = ["readable", "writable"]; }
    register a8 { class = "gpr"; width = 32; enc = 8; flags = ["readable", "writable"]; }
    register a9 { class = "gpr"; width = 32; enc = 9; flags = ["readable", "writable"]; }
    register a10 { class = "gpr"; width = 32; enc = 10; flags = ["readable", "writable"]; }
    register a11 { class = "gpr"; width = 32; enc = 11; flags = ["readable", "writable"]; }
    register a12 { class = "gpr"; width = 32; enc = 12; flags = ["readable", "writable"]; }
    register a13 { class = "gpr"; width = 32; enc = 13; flags = ["readable", "writable"]; }
    register a14 { class = "gpr"; width = 32; enc = 14; flags = ["readable", "writable"]; }
    register a15 { class = "gpr"; width = 32; enc = 15; flags = ["readable", "writable"]; }
    register sp { class = "gpr"; width = 32; enc = 10; flags = ["readable", "writable"]; }
    register pc { class = "special"; width = 32; enc = 0; }
    register psw { class = "status"; width = 32; enc = 0; }
    register pcxi { class = "ctrl"; width = 32; enc = 0; flags = ["modedep"]; }
    register fcx { class = "ctrl"; width = 32; enc = 0; flags = ["modedep"]; }
    register lcx { class = "ctrl"; width = 32; enc = 0; flags = ["modedep"]; }
    register isp { class = "ctrl"; width = 32; enc = 0; flags = ["modedep"]; }
    mnemonic nop {  }
    mnemonic mov {  }
    mnemonic add {  }
    mnemonic sub {  }
    mnemonic and {  }
    mnemonic or {  }
    mnemonic xor {  }
    mnemonic addi {  }
    mnemonic mul {  }
    mnemonic madd {  }
    mnemonic sh {  }
    mnemonic extr {  }
    mnemonic ld.w {  }
    mnemonic st.w {  }
    mnemonic ld.b {  }
    mnemonic st.b {  }
    mnemonic lea {  }
    mnemonic j {  }
    mnemonic jl {  }
    mnemonic ji {  }
    mnemonic jli {  }
    mnemonic ret {  }
    mnemonic bisr {  }
    mnemonic syscall {  }
    mnemonic isync {  }
    mnemonic dsync {  }
    mnemonic rslcx {  }
    mnemonic fadd {  }
    mnemonic add.h {  }
    mnemonic adds {  }
    mnemonic loop {  }
    encoder nop { max_bytes = 2; body = "EMIT16LE 0x0000\n"; }
    encoder mov { max_bytes = 4; body = "EMIT32LE 0x1B000000 + rd*4096 + rs*65536\n"; }
    encoder add { max_bytes = 4; body = "EMIT32LE 0x0B000000 + rd*4096 + ra*65536 + rb*256\n"; }
    encoder sub { max_bytes = 4; body = "EMIT32LE 0x0B800000 + rd*4096 + ra*65536 + rb*256\n"; }
    encoder and { max_bytes = 4; body = "EMIT32LE 0x0F000000 + rd*4096 + ra*65536 + rb*256\n"; }
    encoder or { max_bytes = 4; body = "EMIT32LE 0x0F800000 + rd*4096 + ra*65536 + rb*256\n"; }
    encoder xor { max_bytes = 4; body = "EMIT32LE 0x0F400000 + rd*4096 + ra*65536 + rb*256\n"; }
    encoder addi { max_bytes = 4; body = "EMIT32LE 0x1D000000 + rd*4096 + ((imm + 32768) % 65536)\n"; }
    encoder mul { max_bytes = 4; body = "EMIT32LE 0x13000000 + rd*4096 + ra*65536 + rb*256\n"; }
    encoder madd { max_bytes = 4; body = "EMIT32LE 0x17000000 + rd*4096 + ra*65536 + rb*256\n"; }
    encoder sh { max_bytes = 4; body = "EMIT32LE 0x21000000 + rd*4096 + ra*65536 + rb*256\n"; }
    encoder extr {
        max_bytes = 4;
        body = "EMIT32LE 0x2B000000 + rd*4096 + ra*65536 + ((imm + 65536) % 65536)\n";
    }
    encoder ldw { max_bytes = 4; body = "EMIT32LE 0x91000000 + rd*4096 + ra*65536\n"; }
    encoder stw { max_bytes = 4; body = "EMIT32LE 0xB1000000 + ra*65536 + rb*4096\n"; }
    encoder ldb { max_bytes = 4; body = "EMIT32LE 0x90000000 + rd*4096 + ra*65536\n"; }
    encoder stb { max_bytes = 4; body = "EMIT32LE 0xB0000000 + ra*65536 + rb*4096\n"; }
    encoder lea { max_bytes = 4; body = "EMIT32LE 0x49000000 + rd*4096 + ra*65536\n"; }
    encoder j {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT32LE 0x1D000000\nEMIT_RELOCATION sym, R_TRICORE_PC22\n";
    }
    encoder jl {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT32LE 0x5D000000\nEMIT_RELOCATION sym, R_TRICORE_PC22\n";
    }
    encoder ji { max_bytes = 4; body = "EMIT32LE 0xDC000000 + ra*65536\n"; }
    encoder jli { max_bytes = 4; body = "EMIT32LE 0xEC000000 + ra*65536\n"; }
    encoder ret { max_bytes = 4; body = "EMIT32LE 0x80000000\n"; }
    encoder bisr { max_bytes = 2; body = "EMIT16LE 0x0400 + (imm % 256)\n"; }
    encoder syscall { max_bytes = 4; body = "EMIT32LE 0x01000000 + (imm % 65536)\n"; }
    encoder isync { max_bytes = 2; body = "EMIT16LE 0x000C\n"; }
    encoder dsync { max_bytes = 2; body = "EMIT16LE 0x000D\n"; }
    encoder rslcx { max_bytes = 4; body = "EMIT32LE 0x80000100\n"; }
    encoder fadd { max_bytes = 4; body = "EMIT32LE 0x43000000 + rd*4096 + ra*65536 + rb*256\n"; }
    encoder addh { max_bytes = 4; body = "EMIT32LE 0x4B000000 + rd*4096 + ra*65536 + rb*256\n"; }
    encoder adds { max_bytes = 4; body = "EMIT32LE 0x0B000100 + rd*4096 + ra*65536 + rb*256\n"; }
    encoder loop {
        max_bytes = 4;
        max_relocs = 1;
        body = "EMIT32LE 0x7D000000 + ra*65536\nEMIT_RELOCATION sym, R_TRICORE_PC16\n";
    }
    form { mnemonic = "nop"; encoder = "nop"; }
    form {
        mnemonic = "mov";
        encoder = "mov";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "add";
        encoder = "add";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "sub";
        encoder = "sub";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "and";
        encoder = "and";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "or";
        encoder = "or";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "reg"; width = 32; class = "gpr"; }
        ];
    }
    form {
        mnemonic = "xor";
        encoder = "xor";
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
