        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "sym"; width = 32; }];
    }
    syntax default { comment = ";"; separator = ", "; }
    sections = [
        { name = ".text"; flags = ["exec", "alloc", "code"]; align = 2; content = "code"; },
