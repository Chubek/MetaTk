            { kind = "reg"; width = 32; class = "gpr"; },
            { kind = "imm"; width = 16; imm_min = 0; imm_max = 65535; signed = false; }
        ];
    }
    form {
        mnemonic = "ld.w";
        encoder = "ldw";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 32; }
        ];
    }
    form {
        mnemonic = "st.w";
        encoder = "stw";
        flags = ["writes_mem"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "mem"; width = 32; }];
    }
    form {
        mnemonic = "ld.b";
        encoder = "ldb";
        flags = ["reads_mem"];
        operands = [
            { kind = "reg"; width = 32; class = "gpr"; access = "write"; },
            { kind = "mem"; width = 8; }
        ];
    }
    form {
        mnemonic = "st.b";
        encoder = "stb";
        flags = ["writes_mem"];
        operands = [{ kind = "reg"; width = 32; class = "gpr"; }, { kind = "mem"; width = 8; }];
    }
    form {
        mnemonic = "lea";
        encoder = "lea";
        operands = [
