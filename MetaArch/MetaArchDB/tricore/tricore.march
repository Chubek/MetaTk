    reloc R_TRICORE_HI16 { width = 16; expr = "S + A"; }
    reloc R_TRICORE_LO16 { width = 16; expr = "S + A"; }
    reloc R_TRICORE_GOT_HI16 { width = 16; expr = "GOT(S) + A"; }
    reloc R_TRICORE_GOT_LO16 { width = 16; expr = "GOT(S) + A"; }
    reloc R_TRICORE_TLS_GD { width = 32; expr = "TLS(S) + A"; }
    reloc R_TRICORE_GLOB_DAT { width = 32; expr = "S"; }
    reloc R_TRICORE_JMP_SLOT { width = 32; expr = "S"; }
    reloc R_TRICORE_RELATIVE { width = 32; expr = "B + A"; }
