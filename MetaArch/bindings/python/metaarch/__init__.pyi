from enum import IntEnum, IntFlag
from os import PathLike
from typing import Sequence

class Format(IntEnum):
    AUTO = 0
    YAML = 1
    JSON = 2
    XML = 3
    SEXPR = 4
class LoadFlags(IntFlag):
    NONE = 0
    BACKEND = 1
    NO_COMPILE = 2
    STRICT = 4
    LINT = 8
class WriteFlags(IntFlag):
    NONE = 0
    COMPACT = 1
    EMBED_BACKEND = 2
    REF_BACKEND = 4
    NO_HEADER = 8
    SORT_KEYS = 16
class Severity(IntEnum):
    NOTE = 0
    WARNING = 1
    ERROR = 2
class ByteOrder(IntEnum):
    LITTLE = 0
    BIG = 1
class Diagnostic:
    @property
    def severity(self) -> int: ...
    @property
    def line(self) -> int: ...
    @property
    def column(self) -> int: ...
    @property
    def file(self) -> str: ...
    @property
    def path(self) -> str: ...
    @property
    def message(self) -> str: ...
class Error(RuntimeError):
    diagnostics: list[Diagnostic]
class Target:
    @property
    def arch(self) -> str: ...
    @property
    def subarch(self) -> str: ...
    @property
    def object_format(self) -> str: ...
    @property
    def abi(self) -> str: ...
    @property
    def address_width(self) -> int: ...
    @property
    def byte_order(self) -> int: ...
class Register:
    @property
    def name(self) -> str: ...
    @property
    def reg_class(self) -> str: ...
    @property
    def width(self) -> int: ...
    @property
    def encoding(self) -> int: ...
class Form:
    @property
    def mnemonic(self) -> str: ...
    @property
    def encoder(self) -> str: ...
    @property
    def operand_count(self) -> int: ...
    @property
    def visible_operand_count(self) -> int: ...
class Relocation:
    @property
    def name(self) -> str: ...
    @property
    def offset(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def bit_offset(self) -> int: ...
    @property
    def bit_width(self) -> int: ...
    @property
    def byte_order(self) -> int: ...
    @property
    def symbol_parameter(self) -> int: ...
    @property
    def symbol_value(self) -> int: ...
class Encoded:
    @property
    def data(self) -> bytes: ...
    @property
    def relocations(self) -> list[Relocation]: ...
class Spec:
    @staticmethod
    def load(path: str, format: int = ..., flags: int = ...) -> Spec: ...
    @staticmethod
    def parse(data: str | bytes, format: int, path: str = ..., flags: int = ...) -> Spec: ...
    def close(self) -> None: ...
    def __enter__(self) -> Spec: ...
    def __exit__(self, exc_type: object, exc: object, traceback: object) -> None: ...
    @property
    def diagnostics(self) -> list[Diagnostic]: ...
    @property
    def target_count(self) -> int: ...
    @property
    def register_count(self) -> int: ...
    @property
    def encoder_count(self) -> int: ...
    @property
    def form_count(self) -> int: ...
    def target(self, index: int) -> Target: ...
    def register(self, index: int | str) -> Register: ...
    def form(self, index: int) -> Form: ...
    def encoder_name(self, index: int) -> str: ...
    def find_encoder(self, name: str) -> int: ...
    def find_register(self, name: str) -> int: ...
    def load_backend(self) -> None: ...
    def write(self, format: int, flags: int = ...) -> str: ...
    def encode(self, encoder: str, operands: dict[str, int], target: int = ...) -> Encoded: ...
    def encode_form(self, form: int, values: Sequence[int], target: int = ...) -> Encoded: ...
def abi_version() -> int: ...
def load(path: str | PathLike[str], format: int = ..., flags: int = ...) -> Spec: ...
def parse(data: str | bytes, format: int, path: str | PathLike[str] = ..., flags: int = ...) -> Spec: ...
__version__: str
