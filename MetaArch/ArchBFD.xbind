local xbind = require("lxbind")

-- ArchBFD: the object-format catalogue (ArchBFD/*.bfd.yaml).
--
-- Headers are relative to the MetaArch directory.  The bound surface is the
-- stable query and lifecycle part of the C API: the catalogue, the documents
-- it loads, the lookup helpers and the object reader.  Everything that needs
-- an out-parameter or a caller-owned buffer (archbfd_constant,
-- archbfd_magic_bytes, archbfd_spec_write, archbfd_write_catalogue) is
-- deliberately left out: those need buffer marshalling that XBind does not
-- implement, and a fake wrapper would be worse than no wrapper.
--
-- The record and symbol views are returned as opaque pointers: their layout
-- belongs to the C model, and reading the fields is the job of a language
-- binding that knows the structures.
return xbind.library {
  name = "archbfd",
  version = "1.0.0",
  features = { "c-signatures", "explicit-ownership" },
  headers = { "ArchBFD.h", "DsymspecIR.h" },
  stdlib = { "typedef", "sexp", "json" },
  targets = {
    xbind.target("D", { module = "archbfd" }),
    xbind.target("Go", { package = "archbfd" }),
    xbind.target("Java", { package = "stone.archbfd", class = "ArchBFD" }),
    xbind.target("Lua", { module = "archbfd" }),
    xbind.target("NodeJS", { addon = "archbfd" }),
    xbind.target("OCaml", { library = "archbfd" }),
    xbind.target("Python", { module = "archbfd" }),
    xbind.target("Ruby", { extension = "archbfd" }),
    xbind.target("Rust", { crate = "archbfd_sys" }),
  },
  typedefs = {
    xbind.typedef("const char *", "string", { ownership = "borrowed" }),
    xbind.typedef("int32_t", "int", { range = "int32" }),
    xbind.typedef("int64_t", "int", { range = "int64" }),
    xbind.typedef("uint32_t", "int", { range = "uint32" }),
    xbind.typedef("uint64_t", "int", { range = "uint64" }),
    xbind.typedef("DsymFormat", "int", { range = "format" }),
    xbind.typedef("ArchBFDFormat", "int", { range = "format" }),
    xbind.typedef("ArchBFDByteOrder", "int", { range = "byte-order" }),
    xbind.typedef("ArchBFDOverflow", "int", { range = "overflow" }),
    xbind.typedef("ArchBFD *", "opaque", { ownership = "owned" }),
    xbind.typedef("const ArchBFD *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("ArchBFDSpec *", "opaque", { ownership = "owned" }),
    xbind.typedef("const ArchBFDSpec *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("ArchBFDObject *", "opaque", { ownership = "owned" }),
    xbind.typedef("const ArchBFDObject *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("const ArchBFDEntry *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("const ArchBFDRecord *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("const ArchBFDObjectSection *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("const ArchBFDObjectSymbol *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("const ArchBFDObjectReloc *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("DsymDiags *", "opaque", { ownership = "borrowed" }),
    xbind.typedef("const void *", "opaque", { ownership = "borrowed" }),
  },
  functions = {
    -- catalogue -------------------------------------------------------
    xbind.func("archbfd_open", {
      returns = "ArchBFD *", ownership = "owned",
      params = {
        xbind.param("path", "const char *"),
        xbind.param("diags", "DsymDiags *", { nullable = true }),
      },
    }),
    xbind.func("archbfd_scan", {
      returns = "ArchBFD *", ownership = "owned",
      params = {
        xbind.param("dir", "const char *"),
        xbind.param("diags", "DsymDiags *", { nullable = true }),
      },
    }),
    xbind.func("archbfd_close", {
      returns = "void",
      params = { xbind.param("db", "ArchBFD *") },
    }),
    xbind.func("archbfd_count", {
      returns = "size_t",
      params = { xbind.param("db", "const ArchBFD *") },
    }),
    xbind.func("archbfd_entry", {
      returns = "const ArchBFDEntry *", ownership = "borrowed",
      params = {
        xbind.param("db", "const ArchBFD *"),
        xbind.param("index", "size_t"),
      },
    }),
    xbind.func("archbfd_find", {
      returns = "const ArchBFDEntry *", ownership = "borrowed",
      params = {
        xbind.param("db", "const ArchBFD *"),
        xbind.param("name", "const char *"),
      },
    }),
    xbind.func("archbfd_load", {
      returns = "const ArchBFDSpec *", ownership = "borrowed",
      params = {
        xbind.param("db", "ArchBFD *"),
        xbind.param("entry", "const ArchBFDEntry *"),
        xbind.param("flags", "uint32_t"),
        xbind.param("diags", "DsymDiags *", { nullable = true }),
      },
    }),
    xbind.func("archbfd_load_name", {
      returns = "const ArchBFDSpec *", ownership = "borrowed",
      params = {
        xbind.param("db", "ArchBFD *"),
        xbind.param("name", "const char *"),
        xbind.param("flags", "uint32_t"),
        xbind.param("diags", "DsymDiags *", { nullable = true }),
      },
    }),
    -- documents -------------------------------------------------------
    xbind.func("archbfd_spec_load_file", {
      returns = "ArchBFDSpec *", ownership = "owned",
      params = {
        xbind.param("path", "const char *"),
        xbind.param("format", "DsymFormat"),
        xbind.param("flags", "uint32_t"),
        xbind.param("diags", "DsymDiags *", { nullable = true }),
      },
    }),
    xbind.func("archbfd_spec_load_buffer", {
      returns = "ArchBFDSpec *", ownership = "owned",
      params = {
        xbind.param("data", "const char *"),
        xbind.param("length", "size_t"),
        xbind.param("format", "DsymFormat"),
        xbind.param("virtual_path", "const char *"),
        xbind.param("flags", "uint32_t"),
        xbind.param("diags", "DsymDiags *", { nullable = true }),
      },
    }),
    xbind.func("archbfd_spec_free", {
      returns = "void",
      params = { xbind.param("spec", "ArchBFDSpec *") },
    }),
    -- lookups ---------------------------------------------------------
    xbind.func("archbfd_find_reloc", {
      returns = "int32_t",
      params = {
        xbind.param("spec", "const ArchBFDSpec *"),
        xbind.param("name", "const char *"),
      },
    }),
    xbind.func("archbfd_find_reloc_number", {
      returns = "int32_t",
      params = {
        xbind.param("spec", "const ArchBFDSpec *"),
        xbind.param("number", "int64_t"),
      },
    }),
    xbind.func("archbfd_find_record", {
      returns = "const ArchBFDRecord *", ownership = "borrowed",
      params = {
        xbind.param("spec", "const ArchBFDSpec *"),
        xbind.param("name", "const char *"),
      },
    }),
    xbind.func("archbfd_resolve_record", {
      returns = "const ArchBFDRecord *", ownership = "borrowed",
      params = {
        xbind.param("spec", "const ArchBFDSpec *"),
        xbind.param("name", "const char *"),
      },
    }),
    -- names -----------------------------------------------------------
    xbind.func("archbfd_format_name", {
      returns = "const char *", ownership = "borrowed",
      params = { xbind.param("format", "ArchBFDFormat") },
    }),
    xbind.func("archbfd_byte_order_name", {
      returns = "const char *", ownership = "borrowed",
      params = { xbind.param("order", "ArchBFDByteOrder") },
    }),
    xbind.func("archbfd_overflow_name", {
      returns = "const char *", ownership = "borrowed",
      params = { xbind.param("overflow", "ArchBFDOverflow") },
    }),
    -- objects ---------------------------------------------------------
    xbind.func("archbfd_object_open", {
      returns = "ArchBFDObject *", ownership = "owned",
      params = {
        xbind.param("path", "const char *"),
        xbind.param("spec", "const ArchBFDSpec *"),
        xbind.param("diags", "DsymDiags *", { nullable = true }),
      },
    }),
    xbind.func("archbfd_object_open_memory", {
      returns = "ArchBFDObject *", ownership = "owned",
      params = {
        xbind.param("data", "const void *"),
        xbind.param("length", "size_t"),
        xbind.param("spec", "const ArchBFDSpec *"),
        xbind.param("diags", "DsymDiags *", { nullable = true }),
      },
    }),
    xbind.func("archbfd_object_close", {
      returns = "void",
      params = { xbind.param("object", "ArchBFDObject *") },
    }),
    xbind.func("archbfd_object_section_count", {
      returns = "size_t",
      params = { xbind.param("object", "const ArchBFDObject *") },
    }),
    xbind.func("archbfd_object_symbol_count", {
      returns = "size_t",
      params = { xbind.param("object", "const ArchBFDObject *") },
    }),
    xbind.func("archbfd_object_reloc_count", {
      returns = "size_t",
      params = { xbind.param("object", "const ArchBFDObject *") },
    }),
    xbind.func("archbfd_object_section", {
      returns = "const ArchBFDObjectSection *", ownership = "borrowed",
      params = {
        xbind.param("object", "const ArchBFDObject *"),
        xbind.param("index", "size_t"),
      },
    }),
    xbind.func("archbfd_object_symbol", {
      returns = "const ArchBFDObjectSymbol *", ownership = "borrowed",
      params = {
        xbind.param("object", "const ArchBFDObject *"),
        xbind.param("index", "size_t"),
      },
    }),
    xbind.func("archbfd_object_reloc", {
      returns = "const ArchBFDObjectReloc *", ownership = "borrowed",
      params = {
        xbind.param("object", "const ArchBFDObject *"),
        xbind.param("index", "size_t"),
      },
    }),
    xbind.func("archbfd_object_kind", {
      returns = "const char *", ownership = "borrowed",
      params = { xbind.param("object", "const ArchBFDObject *") },
    }),
    xbind.func("archbfd_object_machine", {
      returns = "int64_t",
      params = { xbind.param("object", "const ArchBFDObject *") },
    }),
    xbind.func("archbfd_object_type", {
      returns = "int64_t",
      params = { xbind.param("object", "const ArchBFDObject *") },
    }),
  },
}
