{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsymspec.schema.json",
  "title": "DomSymAsCC architecture specification (.dsymspec.yaml)",
  "description": "One architecture per file. Records reference one another by name. Encoder bodies are imperative pseudo-code (see README.md); the rest is data.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "description": "Document schema version. Must be 1."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "arch": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "subarch": {
            "type": "string"
          },
          "addr_size": {
            "type": "integer",
            "minimum": 1
          },
          "op_size": {
            "type": "integer",
            "minimum": 1
          },
          "addr_def": {
            "type": "integer",
            "minimum": 1
          },
          "align": {
            "type": "integer",
            "minimum": 1
          },
          "byte_order": {
            "enum": [
              "little",
              "le",
              "big",
              "be"
            ]
          },
          "obj_format": {
            "type": "string"
          },
          "abi": {
            "type": "string"
          },
          "calling_conv": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[!-~]+$",
              "maxLength": 128,
              "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false,
        "required": [
          "arch",
          "addr_size",
          "byte_order"
        ],
        "description": "Target triple data. align must be a power of two."
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "desc": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "registers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "class": {
            "enum": [
              "gpr",
              "seg",
              "ctrl",
              "debug",
              "vec",
              "mask",
              "fp",
              "status",
              "special"
            ]
          },
          "width": {
            "enum": [
              8,
              16,
              32,
              64,
              80,
              128,
              256,
              512
            ]
          },
          "enc": {
            "type": "integer",
            "minimum": 0
          },
          "parent": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "sub_lo": {
            "type": "integer",
            "minimum": 0
          },
          "sub_hi": {
            "type": "integer",
            "minimum": 0
          },
          "flags": {
            "type": "array",
            "items": {
              "enum": [
                "readable",
                "writable",
                "imp_used",
                "imp_mod",
                "modedep"
              ]
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "class",
          "width",
          "enc"
        ]
      }
    },
    "mnemonics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[!-~]+$",
              "maxLength": 128,
              "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
            },
            "uniqueItems": true
          },
          "ci": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "encoders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "max_relocs": {
            "type": "integer",
            "minimum": 0
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "Imperative pseudo-code, one statement per line. See README.md."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "body"
        ]
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mnemonic": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "encoder": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "ops": {
            "type": "integer",
            "minimum": 0
          },
          "flags": {
            "type": "array",
            "items": {
              "enum": [
                "privileged",
                "branch",
                "cond_branch",
                "return",
                "terminator",
                "may_trap",
                "reads_mem",
                "writes_mem",
                "delayed",
                "implicit_ops",
                "reloc",
                "aliases"
              ]
            },
            "uniqueItems": true
          },
          "required": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[!-~]+$",
              "maxLength": 128,
              "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
            },
            "uniqueItems": true
          },
          "forbidden": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[!-~]+$",
              "maxLength": 128,
              "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
            },
            "uniqueItems": true
          },
          "syntaxes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[!-~]+$",
              "maxLength": 128,
              "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
            },
            "uniqueItems": true
          },
          "operands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "reg",
                    "imm",
                    "disp",
                    "mem",
                    "abs",
                    "rel",
                    "sym",
                    "cond",
                    "reglist",
                    "implicit"
                  ]
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "class": {
                  "enum": [
                    "gpr",
                    "seg",
                    "ctrl",
                    "debug",
                    "vec",
                    "mask",
                    "fp",
                    "status",
                    "special"
                  ]
                },
                "imm_min": {
                  "type": "integer"
                },
                "imm_max": {
                  "type": "integer"
                },
                "signed": {
                  "type": "boolean"
                },
                "role": {
                  "type": "integer",
                  "minimum": 0
                },
                "access": {
                  "enum": [
                    "read",
                    "write",
                    "readwrite"
                  ]
                },
                "hidden": {
                  "type": "boolean"
                },
                "constraint": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "description": "One operand of a form."
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "mnemonic",
          "encoder"
        ]
      }
    },
    "syntaxes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "order": {
            "enum": [
              0,
              1
            ]
          },
          "reg_prefix": {
            "type": "string"
          },
          "imm_prefix": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "separator": {
            "type": "string"
          },
          "tmpl": {
            "type": "string"
          },
          "ci": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "description": "order 1 reverses operand order (AT&T style)."
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "flags": {
            "type": "array",
            "items": {
              "enum": [
                "exec",
                "write",
                "alloc",
                "readonly",
                "zerofill",
                "merge",
                "discard",
                "tls",
                "debug",
                "code",
                "data",
                "meta"
              ]
            },
            "uniqueItems": true
          },
          "align": {
            "type": "integer",
            "minimum": 1
          },
          "addrspace": {
            "type": "integer",
            "minimum": 0
          },
          "content": {
            "enum": [
              "unknown",
              "code",
              "data",
              "meta"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "linkages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "binding": {
            "enum": [
              "global",
              "local",
              "weak",
              "tls"
            ]
          },
          "visibility": {
            "enum": [
              "default",
              "hidden",
              "protected",
              "internal"
            ]
          },
          "symtype": {
            "enum": [
              "func",
              "object",
              "none",
              "notype",
              "section",
              "file"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "relocs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[!-~]+$",
            "maxLength": 128,
            "description": "Printable ASCII without spaces. Assembler spellings such as $r0, %f0 and 16-bit are kept verbatim."
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "signed": {
            "type": "boolean"
          },
          "pcrel": {
            "type": "boolean"
          },
          "overflow": {
            "enum": [
              "error",
              "truncate"
            ]
          },
          "addend": {
            "enum": [
              "explicit",
              "infield",
              "implied"
            ]
          },
          "expr": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "width"
        ]
      }
    },
    "debug": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "target",
              "register",
              "feature",
              "mnemonic",
              "form",
              "operand",
              "encoder",
              "syntax",
              "section",
              "linkage",
              "reloc"
            ]
          },
          "msg": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "kind",
          "msg"
        ]
      }
    },
    "asmtk": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "encodings", "conditions"],
      "properties": {
        "schema": {"const": 1},
        "encodings": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["mnemonic", "form", "widths"],
            "oneOf": [{"required": ["opcode"]}, {"required": ["encoder"]}],
            "properties": {
              "mnemonic": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "form": {"enum": ["Fixed", "Relative", "Indirect", "OpcodeRegister", "Unary", "RegisterRegister", "Load", "Store", "MoveImmediate", "ShiftCL", "ShiftImmediate", "ArithmeticImmediate"]},
              "widths": {"type": "array", "uniqueItems": true, "items": {"enum": [8, 32, 64]}},
              "opcode": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
              "encoder": {"type": "string"},
              "group": {"type": "integer", "minimum": 0, "maximum": 7},
              "reg_operand": {"enum": [0, 1]},
              "relocation": {"enum": [0, 2, 4]},
              "rex_w": {"type": "boolean"},
              "implicit_register": {"type": "string"}
            }
          }
        },
        "conditions": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "names"],
            "properties": {
              "code": {"type": "integer", "minimum": 0, "maximum": 15},
              "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^j[a-z]+$"}}
            }
          }
        }
      }
    },
    "metachain": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "scheduling_model", "register_class", "lowering", "allocation", "values"],
      "properties": {
        "schema": {"const": 1},
        "scheduling_model": {"type": "string"},
        "register_class": {"type": "string"},
        "lowering": {
          "type": "object", "additionalProperties": false,
          "required": ["copy", "return", "stack_pointer", "accumulator", "scratch"],
          "properties": {
            "copy": {"type": "string"}, "return": {"type": "string"},
            "stack_pointer": {"type": "string"}, "accumulator": {"type": "string"}, "scratch": {"type": "string"}
          }
        },
        "allocation": {
          "type": "object", "additionalProperties": false,
          "required": ["reserved", "callee_saved", "arguments", "results", "stack_alignment"],
          "properties": {
            "reserved": {"$ref": "#/$defs/registerNames"},
            "callee_saved": {"$ref": "#/$defs/registerNames"},
            "arguments": {"$ref": "#/$defs/registerNames"},
            "results": {"$ref": "#/$defs/registerNames"},
            "stack_alignment": {"type": "integer", "minimum": 1}
          }
        },
        "values": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["symbol", "semantic", "mnemonic", "instruction", "pattern"],
            "properties": {
              "symbol": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "semantic": {"enum": ["Add", "Sub", "Mul", "And", "Or", "Xor"]},
              "mnemonic": {"type": "string"},
              "instruction": {"type": "string"},
              "pattern": {"type": "string"}
            }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^backend/[A-Za-z0-9_.\\-]+\\.json$",
          "description": "Generated backend extension (JSON), relative to this file."
        }
      },
      "description": "Optional compiler backend extension, merged into JSON output as `backend`."
    }
  },
  "$defs": {
    "registerNames": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "required": [
    "schema",
    "targets"
  ],
  "additionalProperties": false
}
