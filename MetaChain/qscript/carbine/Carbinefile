# Dogfooding: Carbine describes its own C tooling and host in its own
# Carbinefile. Build with `carbine build` from this directory. The `carbine`
# host needs a QScript runtime (see README.md); without one, build the
# tooling targets by name: `carbine build carbine_core gpp`.
project carbine;

target lib carbine_core {
    sources tooling/*.c !tooling/gpp.c !tooling/carbine_main.c !tooling/spec.c;
    include include tooling;
    flags -std=c11 -Wall -Wextra;
}

target exe gpp {
    sources tooling/gpp.c;
    include include tooling;
    flags -std=gnu11 -Wall -Wextra -lm;
}

target exe carbine {
    sources tooling/carbine_main.c tooling/spec.c;
    deps carbine_core;
    include include tooling;
    flags -std=c11 -Wall -Wextra -DCARBINE_WITH_QSCRIPT -I../qscript/include -lqscript -lm;
}
