architecture {
    schema = 1;
    target { arch = toy; addr_size = 32; byte_order = little; obj_format = ELF32; }
    target { arch = toy; addr_size = 32; byte_order = big; obj_format = ELF32; }
    register r0 { class = gpr; width = 32; enc = 0; }
    register r1 { class = gpr; width = 32; enc = 1; }
    register v0 { class = fp; width = 32; enc = 0; }
    mnemonic mov { aliases = [copy]; }
    mnemonic ret {}
    mnemonic branch {}
    reloc R_TOY { width = 20; offset = 5; pcrel = true; signed = true; }
    encoder mov {
        body = "REQUIRE dst >= 0 && dst < 2\nREQUIRE imm >= -128 && imm <= 127\nEMIT8 0x10 | dst\nEMIT8 imm\n";
    }
    encoder ret { body = "EMIT8 0xc3"; }
    encoder branch {
        max_relocs = 1;
        body = "EMIT8 0xaa\nEMIT32BE 0xa0000005\nEMIT_RELOCATION symbol, R_TOY";
    }
    form { mnemonic = mov; encoder = mov; operands = [
        { kind = implicit; },
        { kind = reg; class = gpr; width = 32; },
        { kind = imm; width = 8; signed = true; imm_min = -128; imm_max = 127; }
    ]; }
    form { mnemonic = ret; encoder = ret; operands = []; }
    form { mnemonic = branch; encoder = branch; operands = [{ kind = sym; width = 20; }]; }
    assembly = { mov = [dst, imm]; branch = [symbol]; };
}
