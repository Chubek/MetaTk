use integer;
assert(saturating_add(MAX,1)==MAX && saturating_add(MIN,-1)==MIN);
assert(saturating_sub(MIN,1)==MIN && saturating_sub(MAX,-1)==MAX);
assert(saturating_add(-7,9)==2 && saturating_sub(7,9)==-2);
assert(saturating_abs(MIN)==MAX && saturating_abs(-42)==42);
assert(midpoint(MIN,MAX)==-1 && midpoint(MAX,MIN)==0);
assert(midpoint(-7,-4)==-6 && midpoint(-4,-7)==-5);
assert(midpoint(MAX,MAX)==MAX && midpoint(MIN,MIN)==MIN);
assert(is_power_of_two(1024) && !is_power_of_two(0) && !is_power_of_two(MIN));
assert(align_up(17,16)==32 && align_up(0,1)==0);
print 1;
