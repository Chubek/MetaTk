file(MAKE_DIRECTORY "${WORK}/shared library")
function(run)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${ARGN}: ${rc}\n${out}\n${err}")
  endif()
endfunction()
set(library "${WORK}/shared library/libforeign.so")
file(WRITE "${WORK}/library.c" "long custom_twice(long x) { return x*2; }\n")
file(WRITE "${WORK}/driver.c" "extern long foreign_test(long);\nint main(void) { return foreign_test(-21)!=42; }\n")
run("${CC}" -fPIC -shared "${WORK}/library.c" -o "${library}")
run("${EMITTER}" "${WORK}" "${library}" "${DB}")
file(READ "${WORK}/foreign.link.json" manifest)
string(JSON libc GET "${manifest}" arguments 0)
string(JSON custom GET "${manifest}" arguments 1)
if(NOT libc STREQUAL "-lc" OR NOT custom STREQUAL library)
  message(FATAL_ERROR "incorrect driver arguments: ${manifest}")
endif()
# Consume metadata from Juniper, not manually supplied linker dependencies.
run("${CC}" "${WORK}/driver.c" "${WORK}/foreign.s" "${libc}" "${custom}" -o "${WORK}/foreign-test")
run("${WORK}/foreign-test")
find_program(CLANG clang)
find_program(LLD ld.lld)
if(CLANG AND LLD)
  # MetaArchIR's ELF metadata must also suffice without any explicit libraries.
  run("${CLANG}" -fuse-ld=lld "${WORK}/driver.c" "${WORK}/foreign.s" -o "${WORK}/foreign-autolink")
  run("${WORK}/foreign-autolink")
endif()
