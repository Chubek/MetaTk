file(MAKE_DIRECTORY "${WORK}/source")
file(WRITE "${WORK}/source/part.xpp" "#define @amount 7\n")
file(WRITE "${WORK}/source/Juniperfile" "#include \"part.xpp\"\n@fn(f, ())\n@return(@amount)\n@end\n")
file(WRITE "${WORK}/source/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(Consumer NONE)\nadd_executable(Juniper::juniper IMPORTED GLOBAL)\nset_target_properties(Juniper::juniper PROPERTIES IMPORTED_LOCATION \"${TOOL}\")\ninclude(\"${SOURCE}/cmake/JuniperCompile.cmake\")\njuniper_compile(ir INPUT Juniperfile OUTPUT result.junir MODE emit)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK}/source" -B "${WORK}/build" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Consumer configure failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/build" --target ir RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Consumer build failed")
endif()
file(READ "${WORK}/build/result.junir" first)
if(NOT first MATCHES "return 7;")
  message(FATAL_ERROR "Wrong initial artifact")
endif()
# Change a transitive dependency, not the primary source or CMakeLists.
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
file(WRITE "${WORK}/source/part.xpp" "#define @amount 9\n")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/build" --target ir RESULT_VARIABLE result)
file(READ "${WORK}/build/result.junir" second)
if(NOT result EQUAL 0 OR NOT second MATCHES "return 9;")
  message(FATAL_ERROR "Depfile failed to rebuild included source")
endif()
