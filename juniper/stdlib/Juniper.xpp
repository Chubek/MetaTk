#ifndef __juniper_standard_library
#define @__juniper_standard_library 1
#define @module module #1;
#define @fn fn #1 #2 {
#define @end }
#define @let let #1 = #2;
#define @return return #1;
#define @eval eval #1;
#define @assume assume #1;
#define @label #1:
#define @goto goto #1;
#define @br br #1, #2, #3;
#define @version juniper 1;
#define @backend backend #1 extends portable {
#define @issue issue #1;
#define @resource resource #1 #2;
#define @rule rule #1 : #2 => #3 cost #4 latency #5 resource #6;
#endif
